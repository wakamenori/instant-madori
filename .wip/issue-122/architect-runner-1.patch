new file mode 100644
index 000000000..9f54589cc
--- /dev/null
+++ b/crates/housing/tests/convex_oracle.rs
@@ -0,0 +1,223 @@
+#![allow(clippy::unwrap_used)]
+//! Probe: single convex rooms with per-wall offsets. With only two walls per vertex every corner is a
+//! rule 2 mitre, so the floor equals the room polygon clipped by every face's inner half-plane.
+use madori_housing::*;
+
+struct Rng(u64);
+impl Rng {
+    fn next(&mut self) -> u64 {
+        self.0 ^= self.0 << 13;
+        self.0 ^= self.0 >> 7;
+        self.0 ^= self.0 << 17;
+        self.0
+    }
+    fn unit(&mut self) -> f64 {
+        (self.next() % 1_000_000) as f64 / 1_000_000.0
+    }
+}
+
+fn shoelace(p: &[(f64, f64)]) -> f64 {
+    let mut a = 0.0;
+    for i in 0..p.len() {
+        let (x0, y0) = p[i];
+        let (x1, y1) = p[(i + 1) % p.len()];
+        a += x0 * y1 - x1 * y0;
+    }
+    a / 2.0
+}
+
+fn clip(poly: &[(f64, f64)], o: (f64, f64), u: (f64, f64)) -> Vec<(f64, f64)> {
+    let side = |p: (f64, f64)| u.0 * (p.1 - o.1) - u.1 * (p.0 - o.0);
+    let mut out = vec![];
+    for i in 0..poly.len() {
+        let (a, b) = (poly[i], poly[(i + 1) % poly.len()]);
+        let (sa, sb) = (side(a), side(b));
+        if sa >= 0.0 {
+            out.push(a);
+        }
+        if (sa >= 0.0) != (sb >= 0.0) {
+            let t = sa / (sa - sb);
+            out.push((a.0 + t * (b.0 - a.0), a.1 + t * (b.1 - a.1)));
+        }
+    }
+    out
+}
+
+fn convex_case(rng: &mut Rng) -> Option<(Vec<(f64, f64)>, Vec<f64>)> {
+    let n = 3 + (rng.next() % 10) as usize;
+    let mut angles: Vec<f64> = (0..n).map(|_| rng.unit() * std::f64::consts::TAU).collect();
+    angles.sort_by(f64::total_cmp);
+    let r = 1500.0 + rng.unit() * 3500.0;
+    let pts: Vec<(f64, f64)> = angles
+        .iter()
+        .map(|a| ((r * a.cos()).round(), (r * a.sin()).round()))
+        .collect();
+    for i in 0..n {
+        let (a, b, c) = (pts[(i + n - 1) % n], pts[i], pts[(i + 1) % n]);
+        let (u, v) = ((b.0 - a.0, b.1 - a.1), (c.0 - b.0, c.1 - b.1));
+        let cross = u.0 * v.1 - u.1 * v.0;
+        let dot = u.0 * v.0 + u.1 * v.1;
+        if cross <= 0.0 || cross.atan2(dot) < 3.5f64.to_radians() {
+            return None;
+        }
+    }
+    let offsets = (0..n).map(|_| 20.0 + rng.unit() * 0.9 * r).collect();
+    Some((pts, offsets))
+}
+
+pub fn house(pts: &[(f64, f64)], offsets: &[f64]) -> House {
+    let floor = StoreyId::new("s");
+    let n = pts.len();
+    let data = HouseData {
+        storeys: vec![Storey {
+            id: floor.clone(),
+            base_elevation: 0.,
+            height: 2400.,
+        }],
+        vertices: pts
+            .iter()
+            .enumerate()
+            .map(|(i, &(x, y))| Vertex {
+                id: VertexId::new(format!("v{i}")),
+                storey: floor.clone(),
+                at: Point { x, y },
+            })
+            .collect(),
+        boundaries: (0..n)
+            .map(|i| Boundary {
+                id: BoundaryId::new(format!("w{i}")),
+                start: VertexId::new(format!("v{i}")),
+                end: VertexId::new(format!("v{}", (i + 1) % n)),
+                wall: Wall {
+                    height: 2400.,
+                    offsets: SideOffsets {
+                        left: offsets[i],
+                        right: 50.,
+                    },
+                },
+            })
+            .collect(),
+        rooms: vec![Room {
+            id: RoomId::new("r"),
+            name: "r".into(),
+            usage: RoomUse::Other,
+            edges: (0..n)
+                .map(|i| Edge {
+                    boundary: BoundaryId::new(format!("w{i}")),
+                    direction: Direction::Forward,
+                })
+                .collect(),
+        }],
+        wall_colors: vec![],
+        objects: vec![],
+        modifiers: vec![],
+        openings: vec![],
+    };
+    House::new(data).unwrap()
+}
+
+#[test]
+#[ignore = "probe"]
+fn convex_oracle() {
+    let mut rng = Rng(0x9e37_79b9_7f4a_7c15);
+    let (mut cases, mut ok, mut empty_ok) = (0, 0, 0);
+    let mut bad = std::collections::BTreeMap::<&str, usize>::new();
+    let mut shown = 0;
+    for _ in 0..20000 {
+        let Some((pts, offsets)) = convex_case(&mut rng) else { continue };
+        cases += 1;
+        let n = pts.len();
+        let mut floor = pts.clone();
+        for i in 0..n {
+            let (a, b) = (pts[i], pts[(i + 1) % n]);
+            let len = (b.0 - a.0).hypot(b.1 - a.1);
+            let u = ((b.0 - a.0) / len, (b.1 - a.1) / len);
+            let o = (a.0 - u.1 * offsets[i], a.1 + u.0 * offsets[i]);
+            floor = clip(&floor, o, u);
+            if floor.len() < 3 {
+                floor.clear();
+                break;
+            }
+        }
+        let expected = if floor.is_empty() { 0.0 } else { shoelace(&floor) };
+        let h = house(&pts, &offsets);
+        let room = h.rooms().next().unwrap();
+        let verdict = match room.interior() {
+            Err(_) if expected < 1.0 => {
+                empty_ok += 1;
+                None
+            }
+            Err(_) => Some("NoFloor but oracle has floor"),
+            Ok(i) if SimplePolygon::new(i.outline().to_vec()).is_err() => Some("self-intersecting outline"),
+            Ok(i) if i.area().matches_square_metres(expected / 1e6) =>
+            {
+                ok += 1;
+                None
+            }
+            Ok(_) => Some("area differs from oracle"),
+        };
+        if let Some(kind) = verdict {
+            *bad.entry(kind).or_default() += 1;
+            if shown < 3 {
+                shown += 1;
+                println!(
+                    "{kind}: pts {pts:?} offsets {offsets:?} expected {expected} got {:?}",
+                    room.interior().map(|i| (i.area(), i.outline().to_vec()))
+                );
+            }
+        }
+    }
+    println!("cases {cases} ok {ok} empty_ok {empty_ok} bad {bad:?}");
+}
+
+fn star_case(rng: &mut Rng) -> (Vec<(f64, f64)>, Vec<f64>) {
+    let n = 4 + (rng.next() % 9) as usize;
+    let mut angles: Vec<f64> = (0..n).map(|_| rng.unit() * std::f64::consts::TAU).collect();
+    angles.sort_by(f64::total_cmp);
+    let pts: Vec<(f64, f64)> = angles
+        .iter()
+        .map(|a| {
+            let r = 1000.0 + rng.unit() * 4000.0;
+            ((r * a.cos()).round(), (r * a.sin()).round())
+        })
+        .collect();
+    let offsets = (0..n).map(|_| 20.0 + rng.unit() * 600.0).collect();
+    (pts, offsets)
+}
+
+#[test]
+#[ignore = "probe"]
+fn star_orders() {
+    let mut rng = Rng(0x5eed_1234_abcd_0001);
+    let order = std::env::var("ORDER").unwrap_or_default();
+    let mut lines = vec![];
+    let (mut ok, mut no_floor, mut crossing) = (0, 0, 0);
+    for _ in 0..20000 {
+        let (pts, offsets) = star_case(&mut rng);
+        let simple = SimplePolygon::new(pts.iter().map(|&(x, y)| Point { x, y }).collect()).is_ok();
+        if !simple {
+            lines.push("skip".to_string());
+            continue;
+        }
+        let h = house(&pts, &offsets);
+        let r = h.rooms().next().unwrap().interior();
+        let valid = h.check().err().is_none_or(|e| e.as_slice().iter().all(|f| matches!(f.reason, Reason::NoEntrance {} | Reason::NotRectangle { .. })));
+        let tag = if valid { "V" } else { "x" };
+        lines.push(tag.to_string() + &match &r {
+            Ok(i) => {
+                ok += 1;
+                format!("{:.3}", i.area().unrounded_square_metres() * 1e6)
+            }
+            Err(e) => {
+                if matches!(e.as_slice()[0].reason, Reason::FloorSelfIntersecting { .. }) {
+                    crossing += 1;
+                } else {
+                    no_floor += 1;
+                }
+                format!("{:?}", e.as_slice()[0].reason).chars().take(12).collect::<String>()
+            }
+        });
+    }
+    std::fs::write(format!("/private/tmp/claude-501/-Users-matsukokuumahikari--t3-worktrees-instant-madori-t3-347daf4c-6136477725593502/3d868869-0290-4d53-84b4-34e9908038a4/scratchpad/star-{order}.txt"), lines.join("\n")).unwrap();
+    println!("order {order}: ok {ok} no_floor {no_floor} self-intersecting {crossing}");
+}
