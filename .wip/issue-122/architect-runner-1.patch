+#![allow(clippy::unwrap_used)]
+mod common;
+use common::layouts::{Xorshift, random_layout};
+use madori_housing::*;
+
+fn rotated(house: &House, radians: f64) -> House {
+    let (sin, cos) = radians.sin_cos();
+    let mut data = house.data().clone();
+    for v in &mut data.vertices {
+        let Point { x, y } = v.at;
+        v.at = Point {
+            x: x * cos - y * sin,
+            y: x * sin + y * cos,
+        };
+    }
+    House::new(data).unwrap()
+}
+
+#[test]
+#[ignore = "probe"]
+fn rot_dump() {
+    let thicknesses = [
+        (200., 200.),
+        (200., 120.),
+        (150., 150.),
+        (120., 120.),
+        (100., 200.),
+        (123.4, 123.4),
+        (99.9, 150.3),
+    ];
+    let angle = std::env::var("ANG").map_or(30.0_f64, |a| a.parse::<f64>().unwrap()).to_radians();
+    let (s, c) = (-angle).sin_cos();
+    let back = |p: &Point| (p.x * c - p.y * s, p.x * s + p.y * c);
+    let mut rng = Xorshift(0x2545_f491_4f6c_dd1d);
+    let (mut pf, mut fl) = (0, 0);
+    for _ in 0..4000 {
+        let input = random_layout(&mut rng, &thicknesses);
+        let Ok(orig) = House::from_layout(&OperationId::new("job-1:layout"), &input) else {
+            continue;
+        };
+        let house = rotated(&orig, angle);
+        for wall in house.boundaries() {
+            if let Err(e) = wall.planform() {
+                pf += 1;
+                if pf <= 4 {
+                    let id = wall.data().id.as_str();
+                    let o = orig.boundaries().find(|w| w.data().id.as_str() == id).unwrap();
+                    println!(
+                        "PLANFORM {id} {:?}\n  unrotated {:?}\n  joints {} {}",
+                        e.as_slice()[0].reason,
+                        o.planform().unwrap().points(),
+                        o.start().boundaries().count(),
+                        o.end().boundaries().count()
+                    );
+                }
+            }
+        }
+        for room in house.rooms() {
+            if let Err(e) = room.interior() {
+                fl += 1;
+                if fl <= 3 {
+                    let id = room.data().id.as_str();
+                    let o = orig.rooms().find(|r| r.data().id.as_str() == id).unwrap();
+                    println!("NOFLOOR {id} {:?}\n  unrotated {:?}\n  input {input:?}", e.as_slice()[0].reason, o.interior().map(|i| i.outline().to_vec()));
+                }
+            }
+            if let Ok(i) = room.interior()
+                && SimplePolygon::new(i.outline().to_vec()).is_err()
+            {
+                fl += 1;
+                if fl <= 4 {
+                    let id = room.data().id.as_str();
+                    let o = orig.rooms().find(|r| r.data().id.as_str() == id).unwrap();
+                    let un: Vec<_> = i.outline().iter().map(back).collect();
+                    println!(
+                        "FLOOR {id}\n  rotated-back {un:?}\n  unrotated {:?}",
+                        o.interior().unwrap().outline()
+                    );
+                }
+            }
+        }
+    }
+    println!("pf {pf} fl {fl}");
+}
diff --git a/crates/housing/tests/rotation_fidelity.rs b/crates/housing/tests/rotation_fidelity.rs
new file mode 100644
index 000000000..a1b7c1ac1
--- /dev/null
+++ b/crates/housing/tests/rotation_fidelity.rs
@@ -0,0 +1,102 @@
+#![allow(clippy::unwrap_used)]
+mod common;
+use common::layouts::{Xorshift, random_layout};
+use madori_housing::*;
+
+fn rotate(p: Point, (sin, cos): (f64, f64)) -> Point {
+    Point {
+        x: p.x * cos - p.y * sin,
+        y: p.x * sin + p.y * cos,
+    }
+}
+
+fn distance(p: Point, a: Point, b: Point) -> f64 {
+    let (dx, dy) = (b.x - a.x, b.y - a.y);
+    let len2 = dx * dx + dy * dy;
+    let t = if len2 == 0.0 { 0.0 } else { (((p.x - a.x) * dx + (p.y - a.y) * dy) / len2).clamp(0.0, 1.0) };
+    (p.x - a.x - t * dx).hypot(p.y - a.y - t * dy)
+}
+
+/// Plan 3.4: two results match when every point of one lies within the tolerance of the other.
+fn close(a: &[Point], b: &[Point]) -> bool {
+    let near = |p: &Point, q: &[Point]| {
+        (0..q.len()).any(|i| distance(*p, q[i], q[(i + 1) % q.len()]) <= LENGTH_TOLERANCE_MM)
+    };
+    a.iter().all(|p| near(p, b)) && b.iter().all(|p| near(p, a))
+}
+
+#[test]
+#[ignore = "probe"]
+fn rotation_fidelity() {
+    let thicknesses = [
+        (200., 200.),
+        (200., 120.),
+        (150., 150.),
+        (120., 120.),
+        (100., 200.),
+        (123.4, 123.4),
+        (99.9, 150.3),
+    ];
+    for degrees in [30.0_f64, 3f64.atan2(4.).to_degrees(), 1.0, 45.0, 89.0, 137.0] {
+        let turn = degrees.to_radians().sin_cos();
+        let mut rng = Xorshift(0x2545_f491_4f6c_dd1d);
+        let (mut rooms, mut walls, mut bad_area, mut bad_outline, mut bad_wall, mut failed) =
+            (0, 0, 0, 0, 0, 0);
+        for _ in 0..4000 {
+            let input = random_layout(&mut rng, &thicknesses);
+            let Ok(house) = House::from_layout(&OperationId::new("job-1:layout"), &input) else {
+                continue;
+            };
+            let mut data = house.data().clone();
+            for v in &mut data.vertices {
+                v.at = rotate(v.at, turn);
+            }
+            let turned = House::new(data).unwrap();
+            for (a, b) in house.rooms().zip(turned.rooms()) {
+                rooms += 1;
+                let (Ok(a), Ok(b)) = (a.interior(), b.interior()) else {
+                    failed += 1;
+                    continue;
+                };
+                if !b.area().matches_square_metres(a.area().unrounded_square_metres()) {
+                    bad_area += 1;
+                }
+                let a: Vec<_> = a.outline().iter().map(|p| rotate(*p, turn)).collect();
+                if !close(&a, b.outline()) {
+                    bad_outline += 1;
+                    if bad_outline <= 2 {
+                        println!("  OUT {a:?}\n   vs {:?}", b.outline());
+                    }
+                }
+            }
+            for (a, b) in house.boundaries().zip(turned.boundaries()) {
+                walls += 1;
+                let (Ok(a), Ok(b)) = (a.planform(), b.planform()) else {
+                    failed += 1;
+                    continue;
+                };
+                let a: Vec<_> = a.points().iter().map(|p| rotate(*p, turn)).collect();
+                if !close(&a, b.points()) {
+                    bad_wall += 1;
+                    if bad_wall <= 2 {
+                        println!("  WALL {a:?}\n   vs {:?}", b.points());
+                    }
+                }
+            }
+            let findings: Vec<_> = turned
+                .check()
+                .unwrap_err()
+                .as_slice()
+                .iter()
+                .filter(|r| !matches!(r.reason, Reason::NoEntrance {} | Reason::NotRectangle { .. }))
+                .cloned()
+                .collect();
+            if !findings.is_empty() {
+                println!("  {degrees}: {findings:?}");
+            }
+        }
+        println!(
+            "{degrees:.4}deg: rooms {rooms} walls {walls} failed {failed} area mismatch {bad_area} outline mismatch {bad_outline} planform mismatch {bad_wall}"
+        );
+    }
+}
