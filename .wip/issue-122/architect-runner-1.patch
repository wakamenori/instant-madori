@@ -0,0 +1,75 @@
+#![allow(clippy::unwrap_used)]
+//! Probe: what House::check reports for the layouts the sweep tests pin as NarrowGap / PinchedCorner.
+mod common;
+use common::layouts::layout;
+use madori_housing::*;
+use std::{collections::BTreeSet, sync::atomic::Ordering};
+
+fn rooms_of(house: &House, r: &Rejection) -> BTreeSet<String> {
+    let mut ids = BTreeSet::new();
+    let walls = |ids: &mut BTreeSet<String>, wall: &str| {
+        for room in house.rooms() {
+            if room.data().edges.iter().any(|e| e.boundary.as_str() == wall) {
+                ids.insert(room.data().id.as_str().rsplit(':').next().unwrap().to_owned());
+            }
+        }
+    };
+    match r.element {
+        ElementKind::Room => {
+            ids.insert(r.id.rsplit(':').next().unwrap().to_owned());
+        }
+        ElementKind::Wall => walls(&mut ids, &r.id),
+        ElementKind::Vertex => {
+            for b in house.boundaries() {
+                if b.data().start.as_str() == r.id || b.data().end.as_str() == r.id {
+                    walls(&mut ids, b.data().id.as_str());
+                }
+            }
+        }
+        _ => {}
+    }
+    if let Reason::OverlapsWall { other, .. } = &r.reason {
+        walls(&mut ids, other);
+    }
+    ids
+}
+
+fn show(name: &str, input: &RoomLayout) {
+    let sweep = House::from_layout(&OperationId::new("job-1:layout"), input).err();
+    SKIP_SWEEP.store(true, Ordering::Relaxed);
+    let house = House::from_layout(&OperationId::new("job-1:layout"), input).unwrap();
+    SKIP_SWEEP.store(false, Ordering::Relaxed);
+    let findings: Vec<_> = house
+        .check()
+        .err()
+        .map(|e| e.as_slice().to_vec())
+        .unwrap_or_default()
+        .into_iter()
+        .filter(|r| !matches!(r.reason, Reason::NoEntrance {}))
+        .map(|r| {
+            let reason = format!("{:?}", r.reason);
+            format!("{:?} {}", rooms_of(&house, &r), reason.chars().take(110).collect::<String>())
+        })
+        .collect();
+    println!("{name}\n  sweep: {}\n  check: {findings:?}", sweep.map_or("accepted".into(), |e| e.to_string()));
+}
+
+#[test]
+#[ignore = "probe"]
+fn sweep_cases_probe() {
+    for second in [(4005, 0, 8000, 4000), (4000, 3950, 8000, 8000), (4150, 4150, 8000, 8000)] {
+        show(&format!("facing walls {second:?}"), &layout(&[(0, 0, 4000, 4000), second]));
+    }
+    show("pinched corner", &layout(&[(0, 0, 4000, 4000), (4000, 4000, 8000, 8000)]));
+    for top in [6170, 6209] {
+        let mut input = layout(&[(0, 3550, 1100, top), (1300, 3550, 7200, 6150), (1100, 6150, 7200, 7000)]);
+        input.walls.exterior_thickness = 120.0;
+        input.walls.interior_thickness = 240.0;
+        show(&format!("staggered {top}"), &input);
+    }
+    show("setback", &layout(&[(-1000, 0, 0, 1000), (0, 10, 1000, 1020)]));
+    show(
+        "far wall covering the foot",
+        &layout(&[(0, 0, 3000, 1000), (0, 1000, 1500, 2000), (1560, 1000, 3000, 2000), (0, 2000, 3000, 3000)]),
+    );
+}
