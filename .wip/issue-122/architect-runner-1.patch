index 000000000..ac5fe9790
--- /dev/null
+++ b/crates/housing/tests/acceptance_probe.rs
@@ -0,0 +1,94 @@
+#![allow(clippy::unwrap_used)]
+//! Probe: which random rectangle layouts does the 90 degree sweep accept, and which does
+//! "build the house, then House::check" accept?
+mod common;
+use common::layouts::{Xorshift, random_layout};
+use madori_housing::*;
+use std::{collections::BTreeMap, sync::atomic::Ordering};
+
+fn kind(r: &Reason) -> String {
+    format!("{r:?}").split([' ', '{', '(']).next().unwrap_or("").to_owned()
+}
+
+fn build_then_check(input: &RoomLayout) -> Result<House, Vec<String>> {
+    SKIP_SWEEP.store(true, Ordering::Relaxed);
+    let built = House::from_layout(&OperationId::new("job-1:layout"), input);
+    SKIP_SWEEP.store(false, Ordering::Relaxed);
+    let house = built.map_err(|e| vec![format!("layout {e}").chars().take(60).collect()])?;
+    let findings: Vec<_> = house
+        .check()
+        .err()
+        .map(|e| e.as_slice().to_vec())
+        .unwrap_or_default()
+        .into_iter()
+        .filter(|r| !matches!(r.reason, Reason::NoEntrance {} | Reason::Unreachable { .. }))
+        .map(|r| kind(&r.reason))
+        .collect();
+    if findings.is_empty() { Ok(house) } else { Err(findings) }
+}
+
+#[test]
+#[ignore = "probe"]
+fn acceptance_probe() {
+    let thicknesses = [
+        (200., 200.),
+        (200., 120.),
+        (150., 150.),
+        (120., 120.),
+        (100., 200.),
+        (123.4, 123.4),
+        (99.9, 150.3),
+    ];
+    for seed in [0x2545_f491_4f6c_dd1d_u64, 0x1234_5678_9abc_def1, 0x0bad_cafe_dead_beef] {
+        let mut rng = Xorshift(seed);
+        let (mut both, mut sweep_only, mut check_only, mut neither) = (0, 0, 0, 0);
+        let mut check_only_reasons = BTreeMap::<String, usize>::new();
+        let mut sweep_only_reasons = BTreeMap::<String, usize>::new();
+        let mut neither_reasons = BTreeMap::<String, usize>::new();
+        let mut check_only_tiling_bad = 0;
+        let mut shown = 0;
+        for _ in 0..4000 {
+            let input = random_layout(&mut rng, &thicknesses);
+            let sweep = House::from_layout(&OperationId::new("job-1:layout"), &input);
+            let checked = build_then_check(&input);
+            match (&sweep, &checked) {
+                (Ok(_), Ok(_)) => both += 1,
+                (Ok(_), Err(r)) => {
+                    sweep_only += 1;
+                    for k in r {
+                        *sweep_only_reasons.entry(k.clone()).or_default() += 1;
+                    }
+                }
+                (Err(e), Ok(house)) => {
+                    check_only += 1;
+                    let name = match e {
+                        LayoutError::Rejected(r) => kind(&r.as_slice()[0].reason),
+                        LayoutError::Internal(_) => "internal".into(),
+                    };
+                    *check_only_reasons.entry(name).or_default() += 1;
+                    let t = common::tiling(
+                        input.rooms.iter().map(|room| (room.min, room.max)),
+                        input.walls.exterior_thickness / 2.,
+                        house,
+                    );
+                    if !(t.uncovered <= 1e-3 && t.overlap <= 1e-3) {
+                        check_only_tiling_bad += 1;
+                    }
+                    if shown < 2 {
+                        shown += 1;
+                        println!("  check-only example: {e} :: {input:?}");
+                    }
+                }
+                (Err(_), Err(r)) => {
+                    neither += 1;
+                    for k in r {
+                        *neither_reasons.entry(k.clone()).or_default() += 1;
+                    }
+                }
+            }
+        }
+        println!(
+            "seed {seed:x}: both {both} sweep-only {sweep_only} check-only {check_only} (tiling bad {check_only_tiling_bad}) neither {neither}\n  sweep-only reasons {sweep_only_reasons:?}\n  check-only sweep reasons {check_only_reasons:?}\n  neither check reasons {neither_reasons:?}"
+        );
+    }
+}
