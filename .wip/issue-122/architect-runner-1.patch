+    let rooms = [(0.1, 0.1, 4300.1, 650.1), (0.1, 650.1, 4300.1, 1250.1), (0.1, 1250.1, 4300.1, 1900.1), (0.1, 1900.1, 4300.1, 6000.1), (4300.1, -199.9, 5200.1, 6050.1), (5200.1, 0.1, 6150.1, 2800.1), (5200.1, 2800.1, 6150.1, 6000.1)];
