diff --git a/crates/housing/tests/polygon_layout_probe.rs b/crates/housing/tests/polygon_layout_probe.rs
new file mode 100644
index 000000000..b41785cd6
--- /dev/null
+++ b/crates/housing/tests/polygon_layout_probe.rs
@@ -0,0 +1,349 @@
+#![allow(clippy::unwrap_used)]
+//! Probe: a polygon-room layout builder (exact splitting on integer input) followed by House::check.
+mod common;
+use common::layouts::{Xorshift, random_layout};
+use madori_housing::*;
+use std::collections::BTreeMap;
+
+fn accepted(rooms: &[Vec<P>], ext: f64, int: f64) -> Result<Vec<f64>, String> {
+    let house = House::new(build(rooms, ext, int)?).map_err(|e| format!("new {e}"))?;
+    let findings: Vec<_> = house
+        .check()
+        .err()
+        .map(|e| e.as_slice().to_vec())
+        .unwrap_or_default()
+        .into_iter()
+        .filter(|r| {
+            !matches!(
+                r.reason,
+                Reason::NoEntrance {} | Reason::NotRectangle { .. } | Reason::Unreachable { .. }
+            )
+        })
+        .map(|r| format!("{:?}", r.reason).split([' ', '{']).next().unwrap_or("").to_owned())
+        .collect();
+    if !findings.is_empty() {
+        return Err(findings.join(","));
+    }
+    Ok(house
+        .rooms()
+        .map(|r| r.interior().unwrap().area().unrounded_square_metres())
+        .collect())
+}
+
+/// (4x - 3y, 3x + 4y) turns by atan2(3, 4) and scales by 5 exactly in integers, so every adjacency stays exact.
+#[test]
+#[ignore = "probe"]
+fn exact_rotation_of_layouts() {
+    let thicknesses = [(200., 200.), (200., 120.), (150., 150.), (120., 120.), (100., 200.)];
+    let mut rng = Xorshift(0x2545_f491_4f6c_dd1d);
+    let (mut integer, mut both, mut neither, mut differ, mut area_differ) = (0, 0, 0, 0, 0);
+    let mut kinds = BTreeMap::<String, usize>::new();
+    for _ in 0..8000 {
+        let input = random_layout(&mut rng, &thicknesses);
+        let corners: Option<Vec<[P; 2]>> = input
+            .rooms
+            .iter()
+            .map(|r| {
+                let int = |v: f64| (v.fract() == 0.0).then_some(v as i64);
+                Some([(int(r.min.x)?, int(r.min.y)?), (int(r.max.x)?, int(r.max.y)?)])
+            })
+            .collect();
+        let Some(corners) = corners else { continue };
+        integer += 1;
+        let ring = |[(a, b), (c, d)]: [P; 2], f: &dyn Fn(P) -> P| {
+            vec![f((a, b)), f((c, b)), f((c, d)), f((a, d))]
+        };
+        let scaled: Vec<_> = corners.iter().map(|&c| ring(c, &|(x, y)| (5 * x, 5 * y))).collect();
+        let turned: Vec<_> = corners
+            .iter()
+            .map(|&c| ring(c, &|(x, y)| (4 * x - 3 * y, 3 * x + 4 * y)))
+            .collect();
+        let (ext, int) = (input.walls.exterior_thickness, input.walls.interior_thickness);
+        match (accepted(&scaled, ext, int), accepted(&turned, ext, int)) {
+            (Ok(a), Ok(b)) => {
+                both += 1;
+                if a.iter().zip(&b).any(|(x, y)| (x - y).abs() > 1e-6) {
+                    area_differ += 1;
+                }
+            }
+            (Err(e), Err(_)) => {
+                neither += 1;
+                *kinds.entry(e).or_default() += 1;
+            }
+            (a, b) => {
+                differ += 1;
+                if differ <= 3 {
+                    println!("  differ: scaled {:?} turned {:?}", a.err(), b.err());
+                }
+            }
+        }
+    }
+    println!(
+        "integer layouts {integer}: both accepted {both} (area differ {area_differ}) both rejected {neither} differ {differ}"
+    );
+    println!("  rejection kinds (scaled) {kinds:?}");
+}
+
+type P = (i64, i64);
+
+fn on_open_segment(a: P, b: P, p: P) -> bool {
+    let cross = (b.0 - a.0) * (p.1 - a.1) - (b.1 - a.1) * (p.0 - a.0);
+    let dot = (p.0 - a.0) * (b.0 - a.0) + (p.1 - a.1) * (b.1 - a.1);
+    let len2 = (b.0 - a.0).pow(2) + (b.1 - a.1).pow(2);
+    cross == 0 && dot > 0 && dot < len2
+}
+
+fn signed_area(ring: &[P]) -> i64 {
+    (0..ring.len())
+        .map(|i| {
+            let (a, b) = (ring[i], ring[(i + 1) % ring.len()]);
+            a.0 * b.1 - b.0 * a.1
+        })
+        .sum()
+}
+
+/// Splits every room edge at every corner lying exactly on it, keys pieces by their two end points, and gives the
+/// left of each new boundary to the earlier room. Rooms on the same side of one piece overlap.
+pub fn build(rooms: &[Vec<P>], ext: f64, int: f64) -> Result<HouseData, String> {
+    let rings: Vec<Vec<P>> = rooms
+        .iter()
+        .map(|r| {
+            let mut r = r.clone();
+            if signed_area(&r) < 0 {
+                r[1..].reverse();
+            }
+            r
+        })
+        .collect();
+    let corners: Vec<P> = {
+        let mut c: Vec<P> = rings.iter().flatten().copied().collect();
+        c.sort_unstable();
+        c.dedup();
+        c
+    };
+    let mut pieces: Vec<Vec<(P, P)>> = vec![];
+    let mut sides = BTreeMap::<(P, P), [Option<usize>; 2]>::new();
+    for (i, ring) in rings.iter().enumerate() {
+        let mut room = vec![];
+        for k in 0..ring.len() {
+            let (a, b) = (ring[k], ring[(k + 1) % ring.len()]);
+            let mut cuts: Vec<P> = corners.iter().copied().filter(|&p| on_open_segment(a, b, p)).collect();
+            cuts.sort_by_key(|p| (p.0 - a.0) * (b.0 - a.0) + (p.1 - a.1) * (b.1 - a.1));
+            let mut points = vec![a];
+            points.extend(cuts);
+            points.push(b);
+            for w in points.windows(2) {
+                let (from, to) = (w[0], w[1]);
+                let (key, side) = if from < to { ((from, to), 0) } else { ((to, from), 1) };
+                let slot = &mut sides.entry(key).or_default()[side];
+                if let Some(other) = slot {
+                    return Err(format!("Overlap rooms {} and {}", *other + 1, i + 1));
+                }
+                *slot = Some(i);
+                room.push((from, to));
+            }
+        }
+        pieces.push(room);
+    }
+    let storey = StoreyId::new("s1");
+    let mut data = HouseData {
+        storeys: vec![Storey {
+            id: storey.clone(),
+            base_elevation: 0.,
+            height: 2400.,
+        }],
+        rooms: vec![],
+        boundaries: vec![],
+        vertices: vec![],
+        wall_colors: vec![],
+        objects: vec![],
+        modifiers: vec![],
+        openings: vec![],
+    };
+    let mut vertices = BTreeMap::<P, VertexId>::new();
+    let mut seen = BTreeMap::<(P, P), BoundaryId>::new();
+    for (i, room) in pieces.iter().enumerate() {
+        let mut edges = vec![];
+        for &(from, to) in room {
+            let key = if from < to { (from, to) } else { (to, from) };
+            if let Some(id) = seen.get(&key) {
+                edges.push(Edge {
+                    boundary: id.clone(),
+                    direction: Direction::Reverse,
+                });
+                continue;
+            }
+            let mut intern = |p: P| {
+                let n = vertices.len() + 1;
+                vertices
+                    .entry(p)
+                    .or_insert_with(|| {
+                        let id = VertexId::new(format!("v{n}"));
+                        data.vertices.push(Vertex {
+                            id: id.clone(),
+                            storey: storey.clone(),
+                            at: Point {
+                                x: p.0 as f64,
+                                y: p.1 as f64,
+                            },
+                        });
+                        id
+                    })
+                    .clone()
+            };
+            let (start, end) = (intern(from), intern(to));
+            let both = sides[&key].iter().all(Option::is_some);
+            let half = if both { int } else { ext } / 2.;
+            let id = BoundaryId::new(format!("w{}", data.boundaries.len() + 1));
+            data.boundaries.push(Boundary {
+                id: id.clone(),
+                start,
+                end,
+                wall: Wall {
+                    height: 2400.,
+                    offsets: SideOffsets {
+                        left: half,
+                        right: half,
+                    },
+                },
+            });
+            seen.insert(key, id.clone());
+            edges.push(Edge {
+                boundary: id,
+                direction: Direction::Forward,
+            });
+        }
+        data.rooms.push(Room {
+            id: RoomId::new(format!("r{}", i + 1)),
+            name: format!("r{}", i + 1),
+            usage: RoomUse::Other,
+            edges,
+        });
+    }
+    Ok(data)
+}
+
+fn report(name: &str, rooms: &[Vec<P>], ext: f64, int: f64, expected: &[Option<f64>]) {
+    let data = match build(rooms, ext, int) {
+        Ok(d) => d,
+        Err(e) => {
+            println!("{name}: layout rejected: {e}");
+            return;
+        }
+    };
+    let house = match House::new(data) {
+        Ok(h) => h,
+        Err(e) => {
+            println!("{name}: House::new failed {e}");
+            return;
+        }
+    };
+    let findings: Vec<_> = house
+        .check()
+        .err()
+        .map(|e| e.as_slice().to_vec())
+        .unwrap_or_default()
+        .into_iter()
+        .filter(|r| !matches!(r.reason, Reason::NoEntrance {} | Reason::NotRectangle { .. }))
+        .map(|r| format!("{} {:?}", r.id, r.reason))
+        .collect();
+    println!("{name}: findings {findings:?}");
+    for (room, want) in house.rooms().zip(expected) {
+        match (room.interior(), want) {
+            (Ok(i), Some(m2)) => println!(
+                "  {} area {:.6} m2 expected {m2:.6} match {} outline {:?}",
+                room.data().id.as_str(),
+                i.area().unrounded_square_metres(),
+                i.area().matches_square_metres(*m2),
+                i.outline().iter().map(|p| (p.x, p.y)).collect::<Vec<_>>()
+            ),
+            (r, _) => println!("  {} {:?}", room.data().id.as_str(), r.map(|i| i.area()).err()),
+        }
+    }
+}
+
+#[test]
+#[ignore = "probe"]
+fn polygon_layout_probe() {
+    let s2 = std::f64::consts::SQRT_2;
+    let trapezoid = 2800.0 * ((5900.0 - 100.0 * s2 - 100.0) + (3100.0 - 100.0 * s2 - 100.0)) / 2.0 / 1e6;
+    report(
+        "45-degree trapezoid",
+        &[vec![(0, 0), (6000, 0), (3000, 3000), (0, 3000)]],
+        200.,
+        120.,
+        &[Some(trapezoid)],
+    );
+    report(
+        "L alone",
+        &[vec![(0, 0), (6000, 0), (6000, 3000), (3000, 3000), (3000, 5000), (0, 5000)]],
+        200.,
+        120.,
+        &[Some(21.84)],
+    );
+    report(
+        "L with notch room",
+        &[
+            vec![(0, 0), (6000, 0), (6000, 3000), (3000, 3000), (3000, 5000), (0, 5000)],
+            vec![(3000, 3000), (6000, 3000), (6000, 5000), (3000, 5000)],
+        ],
+        200.,
+        120.,
+        &[Some(22.0384), Some(2.94 * 1.94)],
+    );
+    report(
+        "U alone (collinear top edges)",
+        &[vec![(0, 0), (7000, 0), (7000, 5000), (5000, 5000), (5000, 2000), (2000, 2000), (2000, 5000), (0, 5000)]],
+        200.,
+        120.,
+        &[Some(23.04)],
+    );
+    let (a, p) = (6e6_f64, 6000.0 + 2000.0 + 6000f64.hypot(2000.0));
+    let r = 2.0 * a / p;
+    report(
+        "18.43-degree triangle",
+        &[vec![(0, 0), (6000, 0), (0, 2000)]],
+        200.,
+        120.,
+        &[Some(a * ((r - 100.0) / r).powi(2) / 1e6)],
+    );
+    report(
+        "rooms on both sides of a 45-degree wall",
+        &[
+            vec![(0, 0), (4000, 0), (4000, 1000), (1000, 4000), (0, 4000)],
+            vec![(4000, 1000), (4000, 4000), (1000, 4000)],
+        ],
+        200.,
+        120.,
+        &[None, None],
+    );
+    report(
+        "T on a 45-degree wall",
+        &[
+            vec![(0, 0), (6000, 0), (6000, 2000), (2000, 6000), (0, 6000)],
+            vec![(6000, 2000), (6000, 6000), (4000, 6000), (4000, 4000)],
+            vec![(4000, 4000), (4000, 6000), (2000, 6000)],
+        ],
+        200.,
+        120.,
+        &[None, None, None],
+    );
+    report(
+        "Y node (three rooms, no straight pair)",
+        &[
+            vec![(0, 0), (3000, -1500), (3000, 3000), (0, 3000)],
+            vec![(0, 0), (0, 3000), (-3000, 3000), (-3000, -1500)],
+            vec![(0, 0), (-3000, -1500), (-3000, -4000), (3000, -4000), (3000, -1500)],
+        ],
+        200.,
+        120.,
+        &[None, None, None],
+    );
+    report(
