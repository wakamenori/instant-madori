new file mode 100644
index 000000000..9ee299307
--- /dev/null
+++ b/crates/housing/tests/probe_poly.rs
@@ -0,0 +1,326 @@
+#![allow(clippy::unwrap_used)]
+mod common;
+use common::layouts::Xorshift;
+use madori_housing::*;
+use std::collections::{BTreeMap, BTreeSet};
+
+type P = (i64, i64);
+
+fn find(parent: &mut Vec<usize>, x: usize) -> usize {
+    let mut r = x;
+    while parent[r] != r {
+        r = parent[r];
+    }
+    parent[x] = r;
+    r
+}
+
+fn trace(xs: &[i64], ys: &[i64], cells: &[Option<usize>]) -> Option<Vec<Vec<P>>> {
+    let (nx, ny) = (xs.len() - 1, ys.len() - 1);
+    let label = |i: i64, j: i64| -> Option<usize> {
+        if i < 0 || j < 0 || i >= nx as i64 || j >= ny as i64 {
+            return None;
+        }
+        cells[j as usize * nx + i as usize]
+    };
+    let labels: BTreeSet<usize> = cells.iter().flatten().copied().collect();
+    let mut rooms = vec![];
+    for &l in &labels {
+        let mut next = BTreeMap::<P, P>::new();
+        for j in 0..=ny as i64 {
+            for i in 0..=nx as i64 {
+                let here = label(i, j) == Some(l);
+                let below = label(i, j - 1) == Some(l);
+                let left = label(i - 1, j) == Some(l);
+                let p = |a: i64, b: i64| (xs[a as usize], ys[b as usize]);
+                if i < nx as i64 && here != below {
+                    let (a, b) = if here { (p(i, j), p(i + 1, j)) } else { (p(i + 1, j), p(i, j)) };
+                    if next.insert(a, b).is_some() {
+                        return None;
+                    }
+                }
+                if j < ny as i64 && here != left {
+                    let (a, b) = if here { (p(i, j + 1), p(i, j)) } else { (p(i, j), p(i, j + 1)) };
+                    if next.insert(a, b).is_some() {
+                        return None;
+                    }
+                }
+            }
+        }
+        let start = *next.keys().next()?;
+        let mut ring = vec![start];
+        let mut cur = next[&start];
+        while cur != start {
+            ring.push(cur);
+            cur = *next.get(&cur)?;
+            if ring.len() > next.len() {
+                return None;
+            }
+        }
+        if ring.len() != next.len() {
+            return None;
+        }
+        let m = ring.len();
+        let ring: Vec<P> = (0..m)
+            .filter(|&k| {
+                let (a, b, c) = (ring[(k + m - 1) % m], ring[k], ring[(k + 1) % m]);
+                (b.0 - a.0) * (c.1 - b.1) - (b.1 - a.1) * (c.0 - b.0) != 0
+            })
+            .map(|k| ring[k])
+            .collect();
+        rooms.push(ring);
+    }
+    Some(rooms)
+}
+
+/// Rooms of `random_layout` (its thickness steps kept), with random neighbours merged into L, T, U shapes.
+fn polygon_rooms(rng: &mut Xorshift) -> Option<(Vec<Vec<P>>, f64, f64)> {
+    let thicknesses = [(200., 200.), (200., 120.), (150., 150.), (120., 120.), (100., 200.), (123.4, 123.4), (99.9, 150.3)];
+    let input = common::layouts::random_layout(rng, &thicknesses);
+    let q = |v: f64| (v * 1000.0).round() as i64;
+    let rects: Vec<(i64, i64, i64, i64)> = input
+        .rooms
+        .iter()
+        .map(|r| (q(r.min.x), q(r.min.y), q(r.max.x), q(r.max.y)))
+        .collect();
+    for (i, a) in rects.iter().enumerate() {
+        if a.0 >= a.2 || a.1 >= a.3 {
+            return None;
+        }
+        for b in &rects[i + 1..] {
+            if a.0.max(b.0) < a.2.min(b.2) && a.1.max(b.1) < a.3.min(b.3) {
+                return None;
+            }
+        }
+    }
+    let mut xs: Vec<i64> = rects.iter().flat_map(|r| [r.0, r.2]).collect();
+    let mut ys: Vec<i64> = rects.iter().flat_map(|r| [r.1, r.3]).collect();
+    xs.sort_unstable();
+    xs.dedup();
+    ys.sort_unstable();
+    ys.dedup();
+    let (nx, ny) = (xs.len() - 1, ys.len() - 1);
+    let mut cells: Vec<Option<usize>> = (0..nx * ny)
+        .map(|c| {
+            let (i, j) = (c % nx, c / nx);
+            rects.iter().position(|r| r.0 <= xs[i] && xs[i + 1] <= r.2 && r.1 <= ys[j] && ys[j + 1] <= r.3)
+        })
+        .collect();
+    let mut parent: Vec<usize> = (0..rects.len()).collect();
+    for _ in 0..1 + rng.below(3) {
+        let c = rng.below(nx * ny);
+        let d = if rng.below(2) == 0 { c + 1 } else { c + nx };
+        if d >= nx * ny || (d == c + 1 && (c + 1) % nx == 0) {
+            continue;
+        }
+        if let (Some(a), Some(b)) = (cells[c], cells[d]) {
+            let (a, b) = (find(&mut parent, a), find(&mut parent, b));
+            parent[a] = b;
+        }
+    }
+    for cell in &mut cells {
+        if let Some(l) = cell {
+            *l = find(&mut parent, *l);
+        }
+    }
+    Some((trace(&xs, &ys, &cells)?, input.walls.exterior_thickness, input.walls.interior_thickness))
+}
+
+fn cross(a: P, b: P, p: P) -> i128 {
+    i128::from(b.0 - a.0) * i128::from(p.1 - a.1) - i128::from(b.1 - a.1) * i128::from(p.0 - a.0)
+}
+
+/// Prototype of the proposed splitter: cut every edge at every room vertex that lies exactly on it.
+fn emit(rooms: &[Vec<P>], ext: f64, int: f64) -> Result<HouseData, String> {
+    let points: BTreeSet<P> = rooms.iter().flatten().copied().collect();
+    let pieces_of = |a: P, b: P| {
+        let mut cuts: Vec<P> = points
+            .iter()
+            .copied()
+            .filter(|&p| {
+                p != a
+                    && p != b
+                    && cross(a, b, p) == 0
+                    && (a.0.min(b.0)..=a.0.max(b.0)).contains(&p.0)
+                    && (a.1.min(b.1)..=a.1.max(b.1)).contains(&p.1)
+            })
+            .collect();
+        cuts.sort_by_key(|p| (p.0 - a.0).abs() + (p.1 - a.1).abs());
+        let mut chain = vec![a];
+        chain.extend(cuts);
+        chain.push(b);
+        chain.windows(2).map(|w| (w[0], w[1])).collect::<Vec<_>>()
+    };
+    let mut claims = BTreeMap::<(P, P), Vec<(usize, bool)>>::new();
+    let mut order = vec![];
+    for (i, ring) in rooms.iter().enumerate() {
+        for k in 0..ring.len() {
+            for (p, q) in pieces_of(ring[k], ring[(k + 1) % ring.len()]) {
+                let key = (p.min(q), p.max(q));
+                let forward = p < q;
+                let e = claims.entry(key).or_default();
+                if e.iter().any(|&(_, f)| f == forward) {
+                    return Err(format!("overlap: rooms share {key:?} on the same side"));
+                }
+                if e.is_empty() {
+                    order.push((key, p, q));
+                }
+                e.push((i, forward));
+            }
+        }
+    }
+    let s = StoreyId::new("p:s1");
+    let mut data = HouseData {
+        storeys: vec![Storey { id: s.clone(), base_elevation: 0.0, height: 2400.0 }],
+        rooms: vec![],
+        boundaries: vec![],
+        vertices: vec![],
+        wall_colors: vec![],
+        objects: vec![],
+        modifiers: vec![],
+        openings: vec![],
+    };
+    let mut vid = BTreeMap::<P, VertexId>::new();
+    let mut bid = BTreeMap::<(P, P), (BoundaryId, P)>::new();
+    for (key, p, q) in order {
+        for v in [p, q] {
+            if !vid.contains_key(&v) {
+                let id = VertexId::new(format!("p:v{}", vid.len() + 1));
+                data.vertices.push(Vertex {
+                    id: id.clone(),
+                    storey: s.clone(),
+                    at: Point { x: v.0 as f64 / 1000.0, y: v.1 as f64 / 1000.0 },
+                });
+                vid.insert(v, id);
+            }
+        }
+        let half = if claims[&key].len() == 2 { int } else { ext } / 2.0;
+        let id = BoundaryId::new(format!("p:w{}", bid.len() + 1));
+        data.boundaries.push(Boundary {
+            id: id.clone(),
+            start: vid[&p].clone(),
+            end: vid[&q].clone(),
+            wall: Wall { offsets: SideOffsets { left: half, right: half }, height: 2400.0 },
+        });
+        bid.insert(key, (id, p));
+    }
+    for (i, ring) in rooms.iter().enumerate() {
+        let mut edges = vec![];
+        for k in 0..ring.len() {
+            for (p, q) in pieces_of(ring[k], ring[(k + 1) % ring.len()]) {
+                let (id, start) = &bid[&(p.min(q), p.max(q))];
+                edges.push(Edge {
+                    boundary: id.clone(),
+                    direction: if *start == p { Direction::Forward } else { Direction::Reverse },
+                });
+            }
+        }
+        data.rooms.push(Room {
+            id: RoomId::new(format!("p:r{}", i + 1)),
+            name: format!("r{}", i + 1),
+            usage: RoomUse::Bedroom,
+            edges,
+        });
+    }
+    Ok(data)
+}
+
+fn kind(r: &Reason) -> String {
+    let n = format!("{r:?}");
+    n.split([' ', '{']).next().unwrap().to_owned()
+}
+
+#[test]
+#[ignore = "probe"]
+fn polygon_houses() {
+    let transforms: [(&str, [f64; 4]); 6] = {
+        let r = |deg: f64| {
+            let (s, c) = deg.to_radians().sin_cos();
+            [c, -s, s, c]
+        };
+        let mul = |a: [f64; 4], b: [f64; 4]| {
+            [a[0] * b[0] + a[1] * b[2], a[0] * b[1] + a[1] * b[3], a[2] * b[0] + a[3] * b[2], a[2] * b[1] + a[3] * b[3]]
+        };
+        [
+            ("identity", [1., 0., 0., 1.]),
+            ("rot30", r(30.)),
+            ("shear0.5", [1., 0.5, 0., 1.]),
+            ("shear1+rot17", mul(r(17.), [1., 1., 0., 1.])),
+            ("shear-1.7", [1., -1.7, 0., 1.]),
+            ("squash+shear+rot1", mul(r(1.), [1., 0.8, 0., 0.6])),
+        ]
+    };
+    let harsh = std::env::var("HARSH").is_ok();
+    let transforms: Vec<(&str, [f64; 4])> = if harsh {
+        vec![
+            ("identity", [1., 0., 0., 1.]),
+            ("shear-3", [1., -3., 0., 1.]),
+            ("shear2.5+rot40", {
+                let (s, c) = 40f64.to_radians().sin_cos();
+                [c, c * 2.5 - s, s, s * 2.5 + c]
+            }),
+        ]
+    } else {
+        transforms.to_vec()
+    };
+    let mut rng = Xorshift(0x9e37_79b9_7f4a_7c15);
+    let mut houses = vec![];
+    let mut overlaps_in_split = 0;
+    while houses.len() < 1500 {
+        let Some((rooms, ext, int)) = polygon_rooms(&mut rng) else { continue };
+        match emit(&rooms, ext, int) {
+            Ok(d) => match House::new(d) {
+                Ok(h) => houses.push((rooms, h)),
+                Err(e) => println!("HOUSE::NEW FAILED {e}"),
+            },
+            Err(_) => overlaps_in_split += 1,
+        }
+    }
+    let concave = houses.iter().flat_map(|(r, _)| r).filter(|r| r.len() > 4).count();
+    let rooms_total: usize = houses.iter().map(|(r, _)| r.len()).sum();
+    println!("houses {} rooms {rooms_total} concave rooms {concave} split-overlaps {overlaps_in_split}", houses.len());
+    let mut identity_clean = vec![true; houses.len()];
+    for (name, m) in transforms {
+        let mut regress = 0;
+        let (mut clean, mut floor_wall, mut kinds) = (0, 0, BTreeMap::<String, usize>::new());
+        let mut clean_concave = 0;
+        let mut shown = 0;
+        for (index, (rooms, h)) in houses.iter().enumerate() {
+            let mut d = h.data().clone();
+            for v in &mut d.vertices {
+                let Point { x, y } = v.at;
+                v.at = Point { x: m[0] * x + m[1] * y, y: m[2] * x + m[3] * y };
+            }
+            let h = House::new(d).unwrap();
+            let findings: Vec<_> = h
+                .check()
+                .err()
+                .map(|e| e.as_slice().to_vec())
+                .unwrap_or_default()
+                .into_iter()
+                .filter(|r| !matches!(r.reason, Reason::NoEntrance {} | Reason::NotRectangle { .. } | Reason::Unreachable { .. }))
+                .collect();
+            for f in &findings {
+                *kinds.entry(kind(&f.reason)).or_default() += 1;
+            }
+            if name == "identity" {
+                identity_clean[index] = findings.is_empty();
+            } else if identity_clean[index] && !findings.is_empty() {
+                regress += 1;
+            }
+            if findings.is_empty() {
+                clean += 1;
+                clean_concave += rooms.iter().filter(|r| r.len() > 4).count();
+                let o = h.probe_floor_wall_overlaps();
+                if !o.is_empty() {
+                    floor_wall += 1;
+                    if shown < 3 {
+                        shown += 1;
+                        println!("FLOOR-WALL {name} {o:?}\n  rooms {rooms:?}");
+                    }
+                }
+            }
+        }
+        println!("{name}: identity-clean but not clean {regress}; clean {clean} (concave rooms in clean {clean_concave}) floor-wall-overlap houses {floor_wall} findings {kinds:?}");
+    }
+}
