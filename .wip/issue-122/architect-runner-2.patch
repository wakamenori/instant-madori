index 000000000..ac72e770f
--- /dev/null
+++ b/crates/housing/tests/probe_accept.rs
@@ -0,0 +1,103 @@
+#![allow(clippy::unwrap_used)]
+mod common;
+use common::layouts::{Xorshift, layout, random_layout};
+use madori_housing::*;
+use std::collections::BTreeMap;
+
+fn gating(r: &Reason) -> bool {
+    !matches!(
+        r,
+        Reason::NoEntrance {} | Reason::Unreachable { .. } | Reason::NotRectangle { .. }
+    )
+}
+
+fn kind(r: &Reason) -> String {
+    let n = format!("{r:?}");
+    n.split([' ', '{']).next().unwrap().to_owned()
+}
+
+#[test]
+#[ignore = "probe"]
+fn acceptance_difference() {
+    let thicknesses = [
+        (200., 200.),
+        (200., 120.),
+        (150., 150.),
+        (120., 120.),
+        (100., 200.),
+        (123.4, 123.4),
+        (99.9, 150.3),
+    ];
+    let mut rng = Xorshift(0x2545_f491_4f6c_dd1d);
+    let id = OperationId::new("job-1:layout");
+    let (mut both_ok, mut both_rej, mut old_only, mut new_only) = (0, 0, 0, 0);
+    let mut old_only_kinds = BTreeMap::<String, usize>::new();
+    let mut new_kinds = BTreeMap::<String, usize>::new();
+    let mut shown = 0;
+    for _ in 0..20000 {
+        let input = random_layout(&mut rng, &thicknesses);
+        let old = House::from_layout(&id, &input);
+        let Some(house) = House::probe_from_layout_unchecked(&id, &input) else {
+            assert!(old.is_err());
+            continue;
+        };
+        let findings: Vec<_> = house
+            .check()
+            .err()
+            .map(|e| e.as_slice().to_vec())
+            .unwrap_or_default()
+            .into_iter()
+            .filter(|r| gating(&r.reason))
+            .collect();
+        let planforms_ok = house.boundaries().all(|w| w.planform().is_ok());
+        let new_ok = findings.is_empty() && planforms_ok;
+        for f in &findings {
+            *new_kinds.entry(kind(&f.reason)).or_default() += 1;
+        }
+        match (&old, new_ok) {
+            (Ok(_), true) => both_ok += 1,
+            (Err(_), false) => both_rej += 1,
+            (Ok(_), false) => {
+                new_only += 1;
+                println!("NEW-ONLY {findings:?}\n  {input:?}");
+            }
+            (Err(e), true) => {
+                old_only += 1;
+                if let LayoutError::Rejected(r) = e {
+                    for x in r.as_slice() {
+                        *old_only_kinds.entry(kind(&x.reason)).or_default() += 1;
+                    }
+                    if shown < 6 {
+                        shown += 1;
+                        println!("OLD-ONLY {r}\n  {input:?}");
+                    }
+                }
+            }
+        }
+    }
+    println!(
+        "both_ok {both_ok} both_rej {both_rej} old_only_reject {old_only} new_only_reject {new_only}"
+    );
+    println!("old-only reasons {old_only_kinds:?}");
+    println!("new findings kinds (all built houses) {new_kinds:?}");
+}
+
+#[test]
+#[ignore = "probe"]
+fn pinched_corner_under_check() {
+    let input = layout(&[(0, 0, 4000, 3000), (4000, 3000, 8000, 6000)]);
+    let id = OperationId::new("job-1:layout");
+    println!(
+        "old: {:?}",
+        House::from_layout(&id, &input).err().map(|e| e.to_string())
+    );
+    let house = House::probe_from_layout_unchecked(&id, &input).unwrap();
+    println!("check: {:?}", house.check());
+    for w in house.boundaries() {
+        println!("{} {:?}", w.data().id.as_str(), w.planform().is_ok());
+    }
+    println!(
+        "ref {:?}",
+        house.storeys().next().unwrap().reference_area()
+    );
+}
