+#![allow(clippy::unwrap_used)]
+mod common;
+use common::layouts::{Xorshift, random_layout};
+use madori_housing::*;
+
+fn rotated(house: &House, radians: f64) -> House {
+    let (sin, cos) = radians.sin_cos();
+    let mut data = house.data().clone();
+    for v in &mut data.vertices {
+        let Point { x, y } = v.at;
+        v.at = Point {
+            x: x * cos - y * sin,
+            y: x * sin + y * cos,
+        };
+    }
+    House::new(data).unwrap()
+}
+
+#[test]
+#[ignore = "probe"]
+fn rotation_probe() {
+    let thicknesses = [
+        (200., 200.),
+        (200., 120.),
+        (150., 150.),
+        (120., 120.),
+        (100., 200.),
+        (123.4, 123.4),
+        (99.9, 150.3),
+    ];
+    for (label, angle) in [
+        ("30deg", 30f64.to_radians()),
+        ("atan2(3,4)", 3f64.atan2(4.)),
+        ("1deg", 1f64.to_radians()),
+        ("45deg", 45f64.to_radians()),
+    ] {
+        let mut rng = Xorshift(0x2545_f491_4f6c_dd1d);
+        let (mut accepted, mut planform, mut interior, mut findings) = (0, 0, 0, 0);
+        let mut kinds = std::collections::BTreeMap::<String, usize>::new();
+        let mut dumped = std::collections::BTreeSet::<String>::new();
+        for _ in 0..4000 {
+            let input = random_layout(&mut rng, &thicknesses);
+            let Ok(house) = House::from_layout(&OperationId::new("job-1:layout"), &input) else {
+                continue;
+            };
+            accepted += 1;
+            let house = rotated(&house, angle);
+            let mut bad = false;
+            for wall in house.boundaries() {
+                if let Err(e) = wall.planform() {
+                    bad = true;
+                    for r in e.as_slice() {
+                        *kinds.entry(format!("planform {:?}", r.reason).chars().take(40).collect()).or_default() += 1;
+                    }
+                }
+            }
+            if bad {
+                planform += 1;
+            }
+            if house.rooms().any(|r| r.interior().is_err()) {
+                interior += 1;
+            }
+            if std::env::var("PROBE_DUMP").is_ok() && label == "30deg" {
+                let errs = house.check().unwrap_err();
+                for r in errs.as_slice() {
+                    if matches!(r.reason, Reason::FloorSelfIntersecting { .. } | Reason::SelfIntersecting { .. }) {
+                        let key = format!("{:?}", std::mem::discriminant(&r.reason));
+                        if dumped.insert(key) {
+                            println!("DUMP {:?} {} {:?}\nINPUT {:?}", r.element, r.id, r.reason, input);
+                            if r.element == ElementKind::Room {
+                                let room = house.rooms().find(|x| x.data().id.as_str() == r.id).unwrap();
+                                println!("OUTLINE {:?}", room.interior().map(|i| i.outline().to_vec()));
+                            }
+                        }
+                    }
+                }
+            }
+            let errors = house.check().unwrap_err();
+            let extra: Vec<_> = errors
+                .as_slice()
+                .iter()
+                .filter(|r| r.reason != Reason::NoEntrance {})
+                .collect();
+            if !extra.is_empty() {
+                findings += 1;
+                for r in extra {
+                    let name = format!("{:?}", r.reason);
+                    let name = name.split([' ', '{', '(']).next().unwrap_or("").to_owned();
+                    *kinds.entry(format!("check {name}")).or_default() += 1;
+                }
+            }
+        }
+        println!(
+            "{label}: accepted {accepted}, layouts with planform errors {planform}, interior errors {interior}, extra check findings {findings}, kinds {kinds:?}"
+        );
+    }
+}
