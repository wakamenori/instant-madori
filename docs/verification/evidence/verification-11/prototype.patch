diff --git a/crates/viewer/proto/page.js b/crates/viewer/proto/page.js
new file mode 100644
index 000000000..ea0ded838
--- /dev/null
+++ b/crates/viewer/proto/page.js
@@ -0,0 +1,240 @@
+const pkg = new URLSearchParams(location.search).get("pkg") || "all";
+const modes = [
+  "plain",
+  ...(["a", "all"].includes(pkg) ? ["planar", "vertex-uv"] : []),
+  ...(["b", "all"].includes(pkg) ? ["b-planar", "b-triplanar-column"] : []),
+];
+const state = {
+  pkg,
+  mode: modes.includes("b-planar") ? "b-planar" : modes[1] || "plain",
+  mips: "gpu",
+  sampling: "grad",
+  anisotropy: 16,
+  anchor: "world",
+  length: 3640,
+  glass: false,
+  grid: 1,
+  camera: "south",
+  ready: false,
+  bench: null,
+};
+Object.defineProperty(window, "__proto", { value: state, configurable: true });
+const controls = document.querySelector("#controls"),
+  canvas = document.querySelector("#view");
+const status = document.querySelector("#status");
+const cameras = ["south", "north window", "grazing", "through window", "north-west", "column east"];
+const refreshButtons = [];
+let viewer;
+function report() {
+  status.textContent = JSON.stringify(state, null, 2);
+  for (const refresh of refreshButtons) refresh();
+}
+function fail(error) {
+  state.error = error?.detail || String(error);
+  report();
+}
+async function draw() {
+  state.bytes = viewer.pattern_scene(
+    state.mode,
+    state.mips,
+    state.anisotropy,
+    state.anchor === "start",
+    state.length,
+    state.glass,
+    state.grid,
+    cameras.indexOf(state.camera),
+    state.sampling === "always-3",
+  );
+  if (state.mode.startsWith("b-")) state.uploadSubmitMs = viewer.pattern_upload_ms();
+  while (!viewer.draw()) await new Promise(requestAnimationFrame);
+  report();
+}
+function button(label, action) {
+  const b = document.createElement("button");
+  controls.append(b);
+  refreshButtons.push(() => {
+    b.textContent = label();
+  });
+  b.textContent = label();
+  b.onclick = async () => {
+    controls.disabled = true;
+    try {
+      await action();
+    } catch (err) {
+      fail(err);
+    } finally {
+      b.textContent = label();
+      controls.disabled = false;
+    }
+  };
+}
+async function measurementPages() {
+  const frames = [];
+  const pages = {};
+  try {
+    for (const variant of ["proto", "b"]) {
+      const frame = document.createElement("iframe");
+      frames.push(frame);
+      frame.style.cssText = "position:absolute;left:-1400px;width:1200px;height:750px";
+      frame.src = "?pkg=" + variant;
+      const loaded = new Promise((resolve) => (frame.onload = resolve));
+      document.body.append(frame);
+      await loaded;
+      const page = frame.contentWindow.__proto;
+      while (!page.ready) {
+        if (page.error) throw Error(page.error);
+        await new Promise((resolve) => setTimeout(resolve, 50));
+      }
+      pages[variant] = page;
+    }
+    return { pages, close: () => frames.forEach((frame) => frame.remove()) };
+  } catch (error) {
+    frames.forEach((frame) => frame.remove());
+    throw error;
+  }
+}
+async function bench() {
+  const cases = ["all", "b"].includes(pkg)
+    ? ["plain", "b-planar", "b-planar-always-3", "b-triplanar-column"]
+    : modes;
+  const original = state.mode,
+    originalSampling = state.sampling,
+    samples = Object.fromEntries(cases.map((m) => [m, []]));
+  state.bench = { settings: { ...state, bench: undefined }, samples, msPerFrame: {} };
+  const isolated = pkg === "all" ? await measurementPages() : null;
+  async function measure(label, frames) {
+    const mode = label.replace("-always-3", "");
+    const sampling = label.endsWith("-always-3") ? "always-3" : "grad";
+    if (isolated) {
+      const variant = mode === "plain" ? "proto" : "b";
+      const page = isolated.pages[variant];
+      for (const key of ["camera", "length", "anchor", "mips", "anisotropy"])
+        page[key] = state[key];
+      page.sampling = sampling;
+      const time = await page.measure(mode, state.grid, state.glass, frames);
+      if (page.error) throw Error(page.error);
+      return time;
+    }
+    state.sampling = sampling;
+    state.mode = mode;
+    await draw();
+    return viewer.bench(frames);
+  }
+  try {
+    for (const mode of cases) {
+      await measure(mode, 50);
+    }
+    for (let round = 0; round < 5; round++) {
+      for (const mode of round % 2 ? [...cases].reverse() : cases) {
+        samples[mode].push(await measure(mode, 200));
+        const sorted = [...samples[mode]].sort((a, b) => a - b);
+        state.bench.msPerFrame[mode] = {
+          median: sorted[Math.floor(sorted.length / 2)],
+          min: sorted[0],
+          max: sorted.at(-1),
+        };
+        report();
+      }
+    }
+  } finally {
+    isolated?.close();
+    state.sampling = originalSampling;
+    state.mode = original;
+    await draw();
+  }
+}
+async function main() {
+  if (!["proto", "a", "b", "all"].includes(pkg))
+    throw Error("Select a prototype package with ?pkg=.");
+  const wasm = await import("/target/pattern-proto/" + pkg + "/madori_viewer.js");
+  await wasm.default();
+  viewer = await wasm.Viewer.create(canvas);
+  viewer.pattern_watch_errors((message) => {
+    console.error(message);
+    fail(message);
+  });
+  viewer.device_lost().catch(fail);
+  viewer.resize(1200, 750, 1);
+  const tile = document.createElement("canvas");
+  tile.width = tile.height = 512;
+  const ctx = tile.getContext("2d", { willReadFrequently: true });
+  const response = await fetch(
+    "/third_party/solidcraft/assets/render/starter/materials/exports/SURF-027/base_color.png",
+  );
+  if (!response.ok) throw Error("Oak texture HTTP " + response.status);
+  const wood = await createImageBitmap(await response.blob());
+  ctx.drawImage(wood, 0, 0);
+  wood.close();
+  const upload = (slot) =>
+    viewer.pattern_image(
+      slot,
+      512,
+      512,
+      new Uint8Array(ctx.getImageData(0, 0, 512, 512).data.buffer),
+    );
+  upload(0);
+  ctx.fillStyle = "#99968d";
+  ctx.fillRect(0, 0, 512, 512);
+  // Four 300 mm tiles share one 600 mm image repeat.
+  ["#d8d4c9", "#cfcbc0", "#d4cfc4", "#dcd8cc"].forEach((color, i) => {
+    ctx.fillStyle = color;
+    ctx.fillRect(256 * (i % 2) + 3, 256 * Math.floor(i / 2) + 3, 250, 250);
+  });
+  upload(1);
+  if (viewer.pattern_mip_ms)
+    state.mipMedianMs = Object.fromEntries([512, 1024].map((n) => [n, viewer.pattern_mip_ms(n)]));
+  for (const [key, choices] of Object.entries({
+    mode: modes,
+    mips: ["gpu", "cpu", "off"],
+    sampling: ["grad", "always-3"],
+    anisotropy: [1, 16],
+    anchor: ["world", "start"],
+    length: [3640, 3790, 5460],
+    glass: [false, true],
+    grid: [1, 8],
+    camera: cameras,
+  })) {
+    button(
+      () => {
+        if (key === "mips" && state.mips === "gpu" && ["planar", "vertex-uv"].includes(state.mode))
+          return "mips · cpu (A)";
+        return (key === "sampling" ? "B sampling" : key) + " · " + state[key];
+      },
+      async () => {
+        state[key] = choices[(choices.indexOf(state[key]) + 1) % choices.length];
+        await draw();
+      },
+    );
+  }
+  if (viewer.pattern_gpu_probe) {
+    state.probe = async () => {
+      state.gpuMip = {};
+      for (const n of [512, 1024]) {
+        const [encodeMs, wallMs, level4MaxDiff] = await viewer.pattern_gpu_probe(n);
+        state.gpuMip[n] = { encodeMs, wallMs, level4MaxDiff };
+      }
+      report();
+      return state.gpuMip;
+    };
+    button(() => "Measure GPU mips", state.probe);
+  }
+  state.runBench = bench;
+  button(() => "Benchmark · 5 × 200 frames", bench);
+  await draw();
+  state.ready = true;
+  report();
+  controls.disabled = false;
+}
+main().catch(fail);
+
+// A comparison run loads each renderer's own Wasm so A and plain do not
+// pay B's unconditional texture samples when measuring their frame times.
+state.renderScene = async (options) => {
+  Object.assign(state, options);
+  await draw();
+};
+state.measure = async (mode, grid, glass, frames) => {
+  Object.assign(state, { mode, grid, glass });
+  await draw();
+  return viewer.bench(frames);
+};
