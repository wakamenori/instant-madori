diff --git a/crates/viewer/src/gpu/pattern.wgsl b/crates/viewer/src/gpu/pattern.wgsl
new file mode 100644
index 000000000..cc68eeb3c
--- /dev/null
+++ b/crates/viewer/src/gpu/pattern.wgsl
@@ -0,0 +1,28 @@
+struct Camera { vp:mat4x4f, eye:vec4f, back:vec4f }
+struct Frame { origin:vec4f, u:vec4f, v:vec4f }
+@group(0) @binding(0) var<uniform> camera:Camera;
+@group(1) @binding(0) var image:texture_2d<f32>;
+@group(1) @binding(1) var filtering:sampler;
+@group(2) @binding(0) var<uniform> frame:Frame;
+struct Out { @builtin(position) clip:vec4f, @location(0) p:vec3f, @location(1) n:vec3f, @location(2) uv:vec2f }
+@vertex fn planar(@location(0) p:vec3f,@location(1) n:vec3f)->Out{
+    return Out(camera.vp*vec4f(p,1),p,n,vec2f(0));
+}
+@vertex fn vertex_uv(@location(0) p:vec3f,@location(1) n:vec3f,@location(2) uv:vec2f)->Out{
+    return Out(camera.vp*vec4f(p,1),p,n,uv);
+}
+fn lit(n0:vec3f,uv:vec2f)->vec4f{
+    let rgb=textureSample(image, filtering, uv).rgb;
+    let base=select(rgb*12.92,1.055*pow(rgb,vec3f(1./2.4))-0.055,rgb>vec3f(0.0031308));
+    let v=normalize(camera.back.xyz);
+    let n=select(normalize(n0),-normalize(n0),dot(n0,v)<0.);
+    let key=normalize(v*0.8+vec3f(-0.3,0.2,0.6));
+    let k=0.42+0.38*max(dot(n,key),0.)+0.25*max(dot(n,v),0.);
+    let spec=0.25*pow(max(dot(n,normalize(key+v)),0.),40.);
+    return vec4f(min(base*k+spec,vec3f(1)),1);
+}
+@fragment fn project(i:Out)->@location(0) vec4f {
+    let d=i.p-frame.origin.xyz;
+    return lit(i.n,vec2f(dot(d,frame.u.xyz),dot(d,frame.v.xyz)));
+}
+@fragment fn interpolated(i:Out)->@location(0) vec4f{return lit(i.n,i.uv);}
diff --git a/crates/viewer/src/gpu/pattern_a.rs b/crates/viewer/src/gpu/pattern_a.rs
new file mode 100644
index 000000000..988b40858
--- /dev/null
+++ b/crates/viewer/src/gpu/pattern_a.rs
@@ -0,0 +1,299 @@
+use super::{
+    proto::PatternRenderer,
+    room::{PatternImage, Room},
+};
+use solidcraft_viewport_gpu::view::{Frame, depth_compare, gpu_view_proj};
+use std::collections::HashMap;
+use wgpu::{
+    self as g,
+    util::{BufferInitDescriptor, DeviceExt},
+};
+
+fn bytes(values: impl IntoIterator<Item = f32>) -> Vec<u8> {
+    values.into_iter().flat_map(f32::to_le_bytes).collect()
+}
+fn buffer(d: &g::Device, usage: g::BufferUsages, contents: &[u8]) -> g::Buffer {
+    d.create_buffer_init(&BufferInitDescriptor {
+        label: None,
+        usage,
+        contents,
+    })
+}
+fn group(
+    d: &g::Device,
+    p: &g::RenderPipeline,
+    index: u32,
+    r: &[g::BindingResource],
+) -> g::BindGroup {
+    let entries = r
+        .iter()
+        .cloned()
+        .enumerate()
+        .map(|(i, resource)| g::BindGroupEntry {
+            binding: i as u32,
+            resource,
+        })
+        .collect::<Vec<_>>();
+    d.create_bind_group(&g::BindGroupDescriptor {
+        label: None,
+        layout: &p.get_bind_group_layout(index),
+        entries: &entries,
+    })
+}
+fn texture(d: &g::Device, q: &g::Queue, img: &PatternImage, mips: bool) -> g::TextureView {
+    let (mut w, mut h) = (img.width, img.height);
+    let levels = if mips { 1 + w.max(h).ilog2() } else { 1 };
+    let extent = |width, height| g::Extent3d {
+        width,
+        height,
+        depth_or_array_layers: 1,
+    };
+    let t = d.create_texture(&g::TextureDescriptor {
+        label: None,
+        size: extent(w, h),
+        mip_level_count: levels,
+        sample_count: 1,
+        dimension: g::TextureDimension::D2,
+        format: g::TextureFormat::Rgba8UnormSrgb,
+        usage: g::TextureUsages::COPY_DST | g::TextureUsages::TEXTURE_BINDING,
+        view_formats: &[],
+    });
+    let mut data = img.rgba.clone();
+    let linear: [f32; 256] = std::array::from_fn(|i| {
+        let s = i as f32 / 255.;
+        if s <= 0.04045 {
+            s / 12.92
+        } else {
+            ((s + 0.055) / 1.055).powf(2.4)
+        }
+    });
+    for level in 0..levels {
+        q.write_texture(
+            g::TexelCopyTextureInfo {
+                texture: &t,
+                mip_level: level,
+                origin: g::Origin3d::ZERO,
+                aspect: g::TextureAspect::All,
+            },
+            &data,
+            g::TexelCopyBufferLayout {
+                offset: 0,
+                bytes_per_row: Some(w * 4),
+                rows_per_image: Some(h),
+            },
+            extent(w, h),
+        );
+        if level + 1 == levels {
+            break;
+        }
+        let (nw, nh) = ((w / 2).max(1), (h / 2).max(1));
+        let mut next = Vec::with_capacity((nw * nh * 4) as usize);
+        for y in 0..nh {
+            for x in 0..nw {
+                let mut sum = [0.; 3];
+                let mut count = 0.;
+                for j in y * h / nh..(y + 1) * h / nh {
+                    for i in x * w / nw..(x + 1) * w / nw {
+                        for c in 0..3 {
+                            sum[c] += linear[data[((j * w + i) * 4) as usize + c] as usize];
+                        }
+                        count += 1.;
+                    }
+                }
+                next.extend(sum.map(|v| {
+                    let v = v / count;
+                    let s = if v <= 0.0031308 {
+                        12.92 * v
+                    } else {
+                        1.055 * v.powf(1. / 2.4) - 0.055
+                    };
+                    (s * 255.).round() as u8
+                }));
+                next.push(255);
+            }
+        }
+        data = next;
+        w = nw;
+        h = nh;
+    }
+    t.create_view(&Default::default())
+}
+struct Draw {
+    slot: u32,
+    frame: Option<g::BindGroup>,
+    vertices: std::ops::Range<u32>,
+}
+pub struct Candidate {
+    pipeline: g::RenderPipeline,
+    vertices: g::Buffer,
+    camera: g::Buffer,
+    view: g::BindGroup,
+    images: HashMap<u32, g::BindGroup>,
+    draws: Vec<Draw>,
+}
+impl Candidate {
+    #[allow(clippy::too_many_arguments)]
+    pub fn new(
+        d: &g::Device,
+        q: &g::Queue,
+        format: g::TextureFormat,
+        depth: g::TextureFormat,
+        room: &Room,
+        images: &[PatternImage],
+        vertex: bool,
+        mips: bool,
+        aniso: u16,
+    ) -> Result<Self, String> {
+        let module = d.create_shader_module(g::ShaderModuleDescriptor {
+            label: Some("A"),
+            source: g::ShaderSource::Wgsl(include_str!("pattern.wgsl").into()),
+        });
+        let attrs = g::vertex_attr_array![0=>Float32x3,1=>Float32x3,2=>Float32x2];
+        let stride = if vertex { 32 } else { 24 };
+        let p = d.create_render_pipeline(&g::RenderPipelineDescriptor {
+            label: Some("A"),
+            layout: None,
+            vertex: g::VertexState {
+                module: &module,
+                entry_point: Some(if vertex { "vertex_uv" } else { "planar" }),
+                buffers: &[Some(g::VertexBufferLayout {
+                    array_stride: stride,
+                    step_mode: g::VertexStepMode::Vertex,
+                    attributes: &attrs[..if vertex { 3 } else { 2 }],
+                })],
+                compilation_options: Default::default(),
+            },
+            primitive: Default::default(),
+            depth_stencil: Some(g::DepthStencilState {
+                format: depth,
+                depth_compare: Some(depth_compare(true, g::CompareFunction::LessEqual)),
+                depth_write_enabled: Some(false),
+                stencil: Default::default(),
+                bias: Default::default(),
+            }),
+            multisample: Default::default(),
+            fragment: Some(g::FragmentState {
+                module: &module,
+                entry_point: Some(if vertex { "interpolated" } else { "project" }),
+                targets: &[Some(format.into())],
+                compilation_options: Default::default(),
+            }),
+            multiview_mask: None,
+            cache: None,
+        });
+        let camera = buffer(
+            d,
+            g::BufferUsages::UNIFORM | g::BufferUsages::COPY_DST,
+            &[0; 96],
+        );
+        let view = group(d, &p, 0, &[camera.as_entire_binding()]);
+        let sampler = d.create_sampler(&g::SamplerDescriptor {
+            address_mode_u: g::AddressMode::Repeat,
+            address_mode_v: g::AddressMode::Repeat,
+            mag_filter: g::FilterMode::Linear,
+            min_filter: g::FilterMode::Linear,
+            mipmap_filter: g::MipmapFilterMode::Linear,
+            anisotropy_clamp: aniso,
+            ..Default::default()
+        });
+        let images: HashMap<_, _> = images
+            .iter()
+            .map(|img| {
+                let t = texture(d, q, img, mips);
+                (
+                    img.slot,
+                    group(
+                        d,
+                        &p,
+                        1,
+                        &[
+                            g::BindingResource::TextureView(&t),
+                            g::BindingResource::Sampler(&sampler),
+                        ],
+                    ),
+                )
+            })
+            .collect();
+        let mut data = Vec::new();
+        let mut draws = Vec::new();
+        for f in &room.faces {
+            if !images.contains_key(&f.slot) {
+                return Err(format!("missing image {}", f.slot));
+            }
+            let frame = f.frame;
+            let inverse = |a: [f32; 3]| {
+                let length = a.iter().map(|v| v * v).sum::<f32>();
+                a.map(|v| v / length)
+            };
+            let u = inverse(frame.u);
+            let v = inverse(frame.v);
+            let bind = (!vertex).then(|| {
+                let b = buffer(
+                    d,
+                    g::BufferUsages::UNIFORM,
+                    &bytes(
+                        [frame.origin, u, v]
+                            .into_iter()
+                            .flat_map(|a| a.into_iter().chain([0.])),
+                    ),
+                );
+                group(d, &p, 2, &[b.as_entire_binding()])
+            });
+            let mesh = &room.scene.meshes[f.body].mesh;
+            let begin = data.len() as u32 / stride as u32;
+            for (tri, _) in mesh
+                .triangles
+                .iter()
+                .zip(&mesh.tri_face)
+                .filter(|(_, id)| **id == f.face)
+            {
+                for &i in tri {
+                    let pos = mesh.positions[i as usize].to_f32();
+                    let n = mesh.normals[i as usize].to_f32();
+                    data.extend(bytes(pos.into_iter().chain(n)));
+                    if vertex {
+                        data.extend(bytes([u, v].map(|axis| {
+                            (0..3).map(|k| (pos[k] - frame.origin[k]) * axis[k]).sum()
+                        })));
+                    }
+                }
+            }
+            draws.push(Draw {
+                slot: f.slot,
+                frame: bind,
+                vertices: begin..data.len() as u32 / stride as u32,
+            });
+        }
+        Ok(Self {
+            pipeline: p,
+            vertices: buffer(d, g::BufferUsages::VERTEX, &data),
+            camera,
+            view,
+            images,
+            draws,
+        })
+    }
+}
+impl PatternRenderer for Candidate {
+    fn paint(&self, q: &g::Queue, f: &Frame, pass: &mut g::RenderPass) {
+        let uniform = bytes(
+            gpu_view_proj(f.view_proj, true)
+                .into_iter()
+                .flatten()
+                .chain(f.eye)
+                .chain(f.back)
+                .chain([0.]),
+        );
+        q.write_buffer(&self.camera, 0, &uniform);
+        pass.set_pipeline(&self.pipeline);
+        pass.set_vertex_buffer(0, self.vertices.slice(..));
+        pass.set_bind_group(0, &self.view, &[]);
+        for draw in &self.draws {
+            pass.set_bind_group(1, &self.images[&draw.slot], &[]);
+            if let Some(bind) = &draw.frame {
+                pass.set_bind_group(2, bind, &[]);
+            }
+            pass.draw(draw.vertices.clone(), 0..1);
+        }
+    }
+}
diff --git a/crates/viewer/src/gpu/proto.rs b/crates/viewer/src/gpu/proto.rs
