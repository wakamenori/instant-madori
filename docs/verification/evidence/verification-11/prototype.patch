@@ -0,0 +1,414 @@
+use super::{
+    Viewer, depth_texture, frame,
+    room::{self, PatternImage},
+};
+use crate::scene::ShownScene;
+use solidcraft_viewport_gpu::{capture::scene_geometry, view::Frame};
+use std::sync::{Arc, Mutex};
+use wasm_bindgen::prelude::*;
+use wasm_bindgen_futures::JsFuture;
+
+pub(super) trait PatternRenderer {
+    fn paint(&self, q: &wgpu::Queue, f: &Frame, pass: &mut wgpu::RenderPass);
+}
+#[derive(Default)]
+pub(super) struct Prototype {
+    images: Vec<PatternImage>,
+    #[cfg(feature = "pattern-b")]
+    upload_ms: f64,
+    #[cfg(feature = "pattern-b")]
+    mip_generator: Option<solidcraft_viewport_gpu::maps::MipGenerator>,
+    pub active: Option<Box<dyn PatternRenderer>>,
+}
+#[wasm_bindgen(
+    inline_js = "export function proto_now(){return performance.now()} export function watch_gpu(d, report){d.addEventListener('uncapturederror', e=>report(e.error.message))}"
+)]
+extern "C" {
+    fn proto_now() -> f64;
+    fn watch_gpu(device: &JsValue, report: &js_sys::Function);
+}
+#[wasm_bindgen]
+impl Viewer {
+    pub fn pattern_watch_errors(&self, report: &js_sys::Function) -> Result<(), String> {
+        watch_gpu(
+            self.device.as_webgpu().ok_or("WebGPU required")?.as_ref(),
+            report,
+        );
+        Ok(())
+    }
+    pub fn pattern_image(
+        &mut self,
+        slot: u32,
+        width: u32,
+        height: u32,
+        rgba: &[u8],
+    ) -> Result<(), String> {
+        if width == 0
+            || height == 0
+            || width > 4096
+            || height > 4096
+            || rgba.len() != (width * height * 4) as usize
+        {
+            return Err("invalid pattern dimensions or byte length".into());
+        }
+        self.proto.images.retain(|i| i.slot != slot);
+        self.proto.images.push(PatternImage {
+            slot,
+            width,
+            height,
+            rgba: rgba.to_vec(),
+        });
+        Ok(())
+    }
+    #[allow(clippy::too_many_arguments)]
+    pub fn pattern_scene(
+        &mut self,
+        mode: &str,
+        mips: &str,
+        anisotropy: u16,
+        start: bool,
+        length_mm: f64,
+        glass: bool,
+        grid: u32,
+        camera: u32,
+        always_three: bool,
+    ) -> Result<String, String> {
+        if !matches!(grid, 1 | 8) || !matches!(anisotropy, 1 | 16) {
+            return Err("invalid grid or anisotropy".into());
+        }
+        if !matches!(length_mm, 3640. | 3790. | 5460.) {
+            return Err("invalid room length".into());
+        }
+        let room = room::build(length_mm, grid, start, glass);
+        let _ = (mips, always_three);
+        self.proto.active = match mode {
+            "plain" => None,
+            #[cfg(feature = "pattern-b")]
+            "b-planar" | "b-triplanar-column" => None,
+            #[cfg(feature = "pattern-a")]
+            "planar" | "vertex-uv" => Some(Box::new(super::pattern_a::Candidate::new(
+                &self.device,
+                &self.queue,
+                self.config.format,
+                self.depth_format,
+                &room,
+                &self.proto.images,
+                mode == "vertex-uv",
+                mips != "off",
+                anisotropy,
+            )?)),
+            _ => return Err(format!("mode unavailable: {mode}")),
+        };
+        let faces = room.faces.len();
+        let vertices: usize = room
+            .faces
+            .iter()
+            .map(|f| {
+                room.scene.meshes[f.body]
+                    .mesh
+                    .tri_face
+                    .iter()
+                    .filter(|&&id| id == f.face)
+                    .count()
+                    * 3
+            })
+            .sum();
+        self.key += 1;
+        self.camera = room::camera(camera, length_mm);
+        #[cfg(feature = "pattern-b")]
+        let geometry = if mode.starts_with("b-") {
+            let (maps, ms) = mapped_room(
+                &self.device,
+                &self.queue,
+                &room,
+                &self.proto.images,
+                mips,
+                anisotropy,
+                mode == "b-triplanar-column",
+                always_three,
+                (mips == "gpu").then(|| {
+                    &*self.proto.mip_generator.get_or_insert_with(|| {
+                        solidcraft_viewport_gpu::maps::MipGenerator::new(&self.device)
+                    })
+                }),
+            )?;
+            self.proto.upload_ms = ms;
+            solidcraft_viewport_gpu::capture::scene_geometry_mapped(&room.scene, &maps)
+        } else {
+            scene_geometry(&room.scene)
+        };
+        #[cfg(not(feature = "pattern-b"))]
+        let geometry = scene_geometry(&room.scene);
+        self.scene = Some(ShownScene {
+            key: self.key,
+            bounds: room.bounds,
+            slot: Arc::new(Mutex::new(Some(geometry))),
+        });
+        self.dirty = true;
+        Ok(format!(
+            "{faces} patterned faces, {vertices} triangle vertices. Frames: {} bytes ({} uniform bytes padded). Vertex UV: {} bytes.",
+            faces * 36,
+            faces * 48,
+            vertices * 8
+        ))
+    }
+    pub async fn bench(&mut self, frames: u32) -> Result<f64, JsValue> {
+        if frames == 0 || frames > 1000 {
+            return Err("expected 1..1000 frames".into());
+        }
+        let mut config = self.config.clone();
+        config.width = 1920;
+        config.height = 1200;
+        let color = depth_texture(&self.device, &config, config.format);
+        let depth = depth_texture(&self.device, &config, self.depth_format);
+        let queue = self.queue.as_webgpu().ok_or("WebGPU required")?.clone();
+        JsFuture::from(queue.on_submitted_work_done()).await?;
+        let start = proto_now();
+        for i in 0..frames {
+            let mut cam = self.camera;
+            cam.yaw += if i % 2 == 0 { 0.0001 } else { -0.0001 };
+            let f = frame(
+                &cam,
+                1.6,
+                [1920, 1200],
+                self.scene.as_ref().ok_or("no scene")?,
+            );
+            self.render(&f, &color, &depth);
+        }
+        JsFuture::from(queue.on_submitted_work_done()).await?;
+        Ok((proto_now() - start) / f64::from(frames))
+    }
+}
+
+#[cfg(feature = "pattern-b")]
+fn mapped_room(
+    device: &wgpu::Device,
+    queue: &wgpu::Queue,
+    room: &room::Room,
+    images: &[PatternImage],
+    mips: &str,
+    aniso: u16,
+    tri: bool,
+    always_three: bool,
+    generator: Option<&solidcraft_viewport_gpu::maps::MipGenerator>,
+) -> Result<(solidcraft_viewport_gpu::maps::FaceMaps, f64), String> {
+    use solidcraft_viewport_gpu::maps::{FaceMaps, MapGpu, Mip, mip_chain};
+    let width = images.iter().map(|i| i.width).max().ok_or("no images")?;
+    let height = images.iter().map(|i| i.height).max().ok_or("no images")?;
+    let mut layers = Vec::new();
+    for image in images {
+        let bytes = if (width, height) == (image.width, image.height) {
+            image.rgba.clone()
+        } else {
+            let mut bytes = Vec::with_capacity((width * height * 4) as usize);
+            for y in 0..height {
+                for x in 0..width {
+                    let i = ((y * image.height / height * image.width + x * image.width / width)
+                        * 4) as usize;
+                    bytes.extend_from_slice(&image.rgba[i..i + 4]);
+                }
+            }
+            bytes
+        };
+        layers.push(mip_chain(
+            Mip {
+                width,
+                height,
+                bytes,
+            },
+            mips == "cpu",
+        ));
+    }
+    let mut frames = Vec::new();
+    let mut faces = Vec::new();
+    for f in &room.faces {
+        let layer = images
+            .iter()
+            .position(|i| i.slot == f.slot)
+            .ok_or("missing image")?;
+        let axis = |a: [f32; 3]| {
+            let len2 = a.iter().map(|x| x * x).sum::<f32>();
+            a.map(|x| x / len2)
+        };
+        let [ox, oy, oz] = f.frame.origin;
+        let [ux, uy, uz] = axis(f.frame.u);
+        let [vx, vy, vz] = axis(f.frame.v);
+        let kind = if tri && f.curved { 2. } else { 1. };
+        frames.push([
+            [ox, oy, oz, layer as f32],
+            [ux, uy, uz, kind],
+            [vx, vy, vz, 0.],
+        ]);
+        faces.push((f.body, f.face));
+    }
+    let start = proto_now();
+    let gpu = Arc::new(MapGpu::upload(
+        device,
+        queue,
+        &frames,
+        &layers,
+        aniso,
+        generator,
+        always_three,
+    ));
+    Ok((FaceMaps { faces, gpu }, proto_now() - start))
+}
+#[cfg(feature = "pattern-b")]
+#[wasm_bindgen]
+impl Viewer {
+    pub fn pattern_upload_ms(&self) -> f64 {
+        self.proto.upload_ms
+    }
+    pub fn pattern_mip_ms(&self, size: u32) -> Result<f64, String> {
+        use solidcraft_viewport_gpu::maps::{Mip, mip_chain};
+        if !matches!(size, 512 | 1024) {
+            return Err("expected 512 or 1024".into());
+        }
+        let mut samples = [0.; 5];
+        for t in &mut samples {
+            let bytes = (0..size * size * 4)
+                .map(|i| i.wrapping_mul(71) as u8)
+                .collect();
+            let start = proto_now();
+            let levels = mip_chain(
+                Mip {
+                    width: size,
+                    height: size,
+                    bytes,
+                },
+                true,
+            );
+            std::hint::black_box(&levels);
+            *t = proto_now() - start;
+        }
+        samples.sort_by(f64::total_cmp);
+        Ok(samples[2])
+    }
+}
+
+#[cfg(feature = "pattern-b")]
+#[wasm_bindgen(
+    inline_js = "export async function mip_bytes(b){await b.mapAsync(GPUMapMode.READ); const a=new Uint8Array(b.getMappedRange()).slice(); b.unmap(); return a}"
+)]
+extern "C" {
+    #[wasm_bindgen(catch)]
+    async fn mip_bytes(buffer: &JsValue) -> Result<JsValue, JsValue>;
+}
+
+#[cfg(feature = "pattern-b")]
+#[wasm_bindgen]
+impl Viewer {
+    pub async fn pattern_gpu_probe(&self, size: u32) -> Result<Vec<f64>, JsValue> {
+        use solidcraft_viewport_gpu::maps::{Mip, MipGenerator, mip_chain};
+        use wgpu as g;
+        if !matches!(size, 512 | 1024) {
+            return Err("expected 512 or 1024".into());
+        }
+        let tile = self
+            .proto
+            .images
+            .iter()
+            .find(|i| i.slot == 1)
+            .ok_or("missing tile")?;
+        let mut bytes = Vec::with_capacity((size * size * 4) as usize);
+        for y in 0..size {
+            for x in 0..size {
+                let k =
+                    (4 * ((y * tile.height / size) * tile.width + x * tile.width / size)) as usize;
+                bytes.extend_from_slice(&tile.rgba[k..k + 4]);
+            }
+        }
+        let levels = mip_chain(
+            Mip {
+                width: size,
+                height: size,
+                bytes,
+            },
+            true,
+        );
+        let d = &self.device;
+        let q = &self.queue;
+        let extent = |side| g::Extent3d {
+            width: side,
+            height: side,
+            depth_or_array_layers: 1,
+        };
+        let texture = d.create_texture(&g::TextureDescriptor {
+            label: Some("mip probe"),
+            size: extent(size),
+            mip_level_count: levels.len() as u32,
+            sample_count: 1,
+            dimension: g::TextureDimension::D2,
+            format: g::TextureFormat::Rgba8UnormSrgb,
+            usage: g::TextureUsages::COPY_DST
+                | g::TextureUsages::COPY_SRC
+                | g::TextureUsages::TEXTURE_BINDING
+                | g::TextureUsages::RENDER_ATTACHMENT,
+            view_formats: &[],
+        });
+        let image = |level| g::TexelCopyTextureInfo {
+            texture: &texture,
+            mip_level: level,
+            origin: g::Origin3d::ZERO,
+            aspect: g::TextureAspect::All,
+        };
+        let layout = |pitch| g::TexelCopyBufferLayout {
+            offset: 0,
+            bytes_per_row: Some(pitch),
+            rows_per_image: None,
+        };
+        q.write_texture(image(0), &levels[0].bytes, layout(size * 4), extent(size));
+        let generator = MipGenerator::new(d);
+        let queue = q.as_webgpu().ok_or("WebGPU required")?;
+        q.submit([]);
+        JsFuture::from(queue.on_submitted_work_done()).await?;
+        let mut encodes = Vec::new();
+        let mut walls = Vec::new();
+        for round in 0..6 {
+            let start = proto_now();
+            let commands = generator.encode(d, &texture);
+            let encode = proto_now() - start;
+            q.submit([commands]);
+            JsFuture::from(queue.on_submitted_work_done()).await?;
+            if round > 0 {
+                encodes.push(encode);
+                walls.push(proto_now() - start);
+            }
+        }
+        let side = size / 16;
+        let pitch = (side * 4).next_multiple_of(256);
+        let buffer = d.create_buffer(&g::BufferDescriptor {
+            label: Some("mip probe readback"),
+            size: u64::from(pitch * side),
+            usage: g::BufferUsages::COPY_DST | g::BufferUsages::MAP_READ,
+            mapped_at_creation: false,
+        });
+        let mut copies = Vec::new();
+        for cpu in [false, true] {
+            if cpu {
+                q.write_texture(image(4), &levels[4].bytes, layout(side * 4), extent(side));
+            }
+            let mut encoder = d.create_command_encoder(&Default::default());
+            encoder.copy_texture_to_buffer(
+                image(4),
+                g::TexelCopyBufferInfo {
+                    buffer: &buffer,
+                    layout: layout(pitch),
+                },
+                extent(side),
+            );
+            q.submit([encoder.finish()]);
+            let result =
+                mip_bytes(buffer.as_webgpu().ok_or("WebGPU buffer required")?.as_ref()).await?;
+            copies.push(js_sys::Uint8Array::new(&result).to_vec());
+        }
+        let diff = (0..side)
+            .flat_map(|y| (0..side * 4).map(move |x| (y * pitch + x) as usize))
+            .map(|i| copies[0][i].abs_diff(copies[1][i]))
+            .max()
+            .unwrap_or(0);
+        encodes.sort_by(f64::total_cmp);
+        walls.sort_by(f64::total_cmp);
+        Ok(vec![encodes[2], walls[2], f64::from(diff)])
+    }
+}
