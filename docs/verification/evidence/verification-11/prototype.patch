diff --git a/crates/viewer/proto/build.sh b/crates/viewer/proto/build.sh
new file mode 100755
index 000000000..4ae03ffde
--- /dev/null
+++ b/crates/viewer/proto/build.sh
@@ -0,0 +1,21 @@
+#!/usr/bin/env bash
+set -euo pipefail
+cd "$(dirname "$0")/../../.."
+variant=${1:?expected base, proto, a, b or all}
+features=()
+case "$variant" in
+  base) ;;
+  proto) features=(--features pattern-proto);;
+  a) features=(--features pattern-a);;
+  b) features=(--features pattern-b);;
+  all) features=(--features pattern-a,pattern-b);;
+  *) exit 2;;
+esac
+root=target/pattern-proto
+out="$root/$variant"
+mkdir -p "$out"
+mise exec -- cargo build --locked -p madori-viewer --target wasm32-unknown-unknown --profile release --target-dir "$root/cargo" ${features[@]+"${features[@]}"}
+input="$root/cargo/wasm32-unknown-unknown/release/madori_viewer.wasm"
+.tools/bin/wasm-bindgen --target web --out-dir "$out" "$input"
+file="$out/madori_viewer_bg.wasm"
+echo "$variant pre-bindgen $(wc -c < "$input") bytes, bindings wasm $(wc -c < "$file") bytes, gzip -9 $(gzip -9cn < "$file" | wc -c) bytes, brotli -q 11 $(brotli -q 11 -c "$file" | wc -c) bytes"
