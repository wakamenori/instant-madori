@@ -0,0 +1,266 @@
+//! Prototype colour maps. Face order is also the stable palette order.
+use crate::view::PALETTE_WIDTH;
+use std::sync::Arc;
+use wgpu as g;
+
+pub struct FaceMaps {
+    pub faces: Vec<(usize, u32)>,
+    pub gpu: Arc<MapGpu>,
+}
+#[derive(Debug)]
+pub struct MapGpu {
+    frames: g::TextureView,
+    images: g::TextureView,
+    sampler: g::Sampler,
+}
+
+pub type FrameRecord = [[f32; 4]; 3];
+pub struct Mip {
+    pub width: u32,
+    pub height: u32,
+    pub bytes: Vec<u8>,
+}
+
+pub fn mip_chain(base: Mip, enabled: bool) -> Vec<Mip> {
+    let linear: [f32; 256] = std::array::from_fn(|i| {
+        let s = i as f32 / 255.;
+        if s <= 0.04045 { s / 12.92 } else { ((s + 0.055) / 1.055).powf(2.4) }
+    });
+    let mut chain = vec![base];
+    while let Some(prev) = chain.last() {
+        if !enabled || prev.width.max(prev.height) == 1 {
+            break;
+        }
+        let width = (prev.width / 2).max(1);
+        let height = (prev.height / 2).max(1);
+        let mut bytes = Vec::with_capacity((width * height * 4) as usize);
+        for y in 0..height {
+            for x in 0..width {
+                let mut sum = [0.; 4];
+                let mut count = 0.;
+                for j in y * prev.height / height..(y + 1) * prev.height / height {
+                    for i in x * prev.width / width..(x + 1) * prev.width / width {
+                        let k = ((j * prev.width + i) * 4) as usize;
+                        for (c, s) in sum[..3].iter_mut().enumerate() {
+                            *s += linear[prev.bytes[k + c] as usize];
+                        }
+                        sum[3] += f32::from(prev.bytes[k + 3]);
+                        count += 1.;
+                    }
+                }
+                for s in &sum[..3] {
+                    let l = s / count;
+                    let v = if l <= 0.0031308 { 12.92 * l } else { 1.055 * l.powf(1. / 2.4) - 0.055 };
+                    bytes.push((255. * v).round() as u8);
+                }
+                bytes.push((sum[3] / count).round() as u8);
+            }
+        }
+        chain.push(Mip { width, height, bytes });
+    }
+    chain
+}
+pub(crate) fn layout() -> [g::BindGroupLayoutEntry; 3] {
+    let texture = |filterable, view_dimension| g::BindingType::Texture {
+        sample_type: g::TextureSampleType::Float { filterable },
+        view_dimension,
+        multisampled: false,
+    };
+    let types = [
+        texture(false, g::TextureViewDimension::D2),
+        texture(true, g::TextureViewDimension::D2Array),
+        g::BindingType::Sampler(g::SamplerBindingType::Filtering),
+    ];
+    std::array::from_fn(|i| g::BindGroupLayoutEntry { binding: 7 + i as u32, visibility: g::ShaderStages::FRAGMENT, ty: types[i], count: None })
+}
+impl MapGpu {
+    fn allocate(d: &g::Device, table_height: u32, images: g::Extent3d, levels: u32, aniso: u16) -> (Self, g::Texture, g::Texture) {
+        let texture = |format, size, mip_level_count| {
+            d.create_texture(&g::TextureDescriptor {
+                label: Some("pattern maps"),
+                size,
+                mip_level_count,
+                sample_count: 1,
+                dimension: g::TextureDimension::D2,
+                format,
+                usage: g::TextureUsages::COPY_DST
+                    | g::TextureUsages::TEXTURE_BINDING
+                    | if format == g::TextureFormat::Rgba8UnormSrgb {
+                        g::TextureUsages::RENDER_ATTACHMENT | g::TextureUsages::COPY_SRC
+                    } else {
+                        g::TextureUsages::empty()
+                    },
+                view_formats: &[],
+            })
+        };
+        let table = texture(g::TextureFormat::Rgba32Float, g::Extent3d { width: PALETTE_WIDTH, height: table_height, depth_or_array_layers: 1 }, 1);
+        let array = texture(g::TextureFormat::Rgba8UnormSrgb, images, levels);
+        let sampler = d.create_sampler(&g::SamplerDescriptor {
+            address_mode_u: g::AddressMode::Repeat,
+            address_mode_v: g::AddressMode::Repeat,
+            mag_filter: g::FilterMode::Linear,
+            min_filter: g::FilterMode::Linear,
+            mipmap_filter: g::MipmapFilterMode::Linear,
+            anisotropy_clamp: aniso,
+            ..Default::default()
+        });
+        (
+            Self {
+                frames: table.create_view(&Default::default()),
+                images: array.create_view(&g::TextureViewDescriptor { dimension: Some(g::TextureViewDimension::D2Array), ..Default::default() }),
+                sampler,
+            },
+            table,
+            array,
+        )
+    }
+    pub(crate) fn empty(d: &g::Device) -> Self {
+        Self::allocate(d, 3, g::Extent3d { width: 1, height: 1, depth_or_array_layers: 1 }, 1, 1).0
+    }
+    pub fn upload(
+        d: &g::Device,
+        q: &g::Queue,
+        records: &[FrameRecord],
+        layers: &[Vec<Mip>],
+        aniso: u16,
+        generator: Option<&MipGenerator>,
+        always_three: bool,
+    ) -> Self {
+        let base = &layers[0][0];
+        let rows = (records.len() as u32).div_ceil(PALETTE_WIDTH).max(1);
+        let (gpu, table, array) = Self::allocate(
+            d,
+            rows * 3 + u32::from(always_three),
+            g::Extent3d { width: base.width, height: base.height, depth_or_array_layers: layers.len() as u32 },
+            if generator.is_some() { base.width.max(base.height).ilog2() + 1 } else { layers[0].len() as u32 },
+            aniso,
+        );
+        let mut data = vec![0; (rows * 3 * PALETTE_WIDTH * 16) as usize];
+        for (i, record) in records.iter().enumerate() {
+            let w = PALETTE_WIDTH as usize;
+            for (r, values) in record.iter().enumerate() {
+                let start = ((i / w * 3 + r) * w + i % w) * 16;
+                for (dst, value) in data[start..start + 16].chunks_exact_mut(4).zip(values) {
+                    dst.copy_from_slice(&value.to_le_bytes());
+                }
+            }
+        }
+        let write = |texture: &g::Texture, level, layer, width, height, bpp, bytes: &[u8]| {
+            q.write_texture(
+                g::TexelCopyTextureInfo { texture, mip_level: level, origin: g::Origin3d { x: 0, y: 0, z: layer }, aspect: g::TextureAspect::All },
+                bytes,
+                g::TexelCopyBufferLayout { offset: 0, bytes_per_row: Some(width * bpp), rows_per_image: Some(height) },
+                g::Extent3d { width, height, depth_or_array_layers: 1 },
+            )
+        };
+        write(&table, 0, 0, PALETTE_WIDTH, rows * 3, 16, &data);
+        for (layer, chain) in layers.iter().enumerate() {
+            for (level, m) in chain.iter().enumerate() {
+                write(&array, level as u32, layer as u32, m.width, m.height, 4, &m.bytes);
+            }
+        }
+        if let Some(generator) = generator {
+            q.submit([generator.encode(d, &array)]);
+        }
+        gpu
+    }
+    pub(crate) fn entries(&self) -> [g::BindGroupEntry<'_>; 3] {
+        let resources = [
+            g::BindingResource::TextureView(&self.frames),
+            g::BindingResource::TextureView(&self.images),
+            g::BindingResource::Sampler(&self.sampler),
+        ];
+        std::array::from_fn(|i| g::BindGroupEntry { binding: 7 + i as u32, resource: resources[i].clone() })
+    }
+}
+
+pub struct MipGenerator {
+    pipeline: g::RenderPipeline,
+    sampler: g::Sampler,
+}
+
+impl MipGenerator {
+    pub fn new(d: &g::Device) -> Self {
+        let shader = d.create_shader_module(g::ShaderModuleDescriptor {
+            label: Some("sRGB mip reduction"),
+            source: g::ShaderSource::Wgsl(
+                r#"
+struct Vertex { @builtin(position) pos: vec4f, @location(0) uv: vec2f }
+@vertex fn vertex(@builtin(vertex_index) i: u32) -> Vertex {
+    let uv = vec2f(f32((i << 1u) & 2u), f32(i & 2u));
+    return Vertex(vec4f(uv * vec2f(2., -2.) + vec2f(-1., 1.), 0., 1.), uv);
+}
+@group(0) @binding(0) var source: texture_2d<f32>;
+@group(0) @binding(1) var linear_sampler: sampler;
+@fragment fn fragment(v: Vertex) -> @location(0) vec4f {
+    return textureSampleLevel(source, linear_sampler, v.uv, 0.);
+}
+"#
+                .into(),
+            ),
+        });
+        let pipeline = d.create_render_pipeline(&g::RenderPipelineDescriptor {
+            label: Some("sRGB mip reduction"),
+            layout: None,
+            vertex: g::VertexState { module: &shader, entry_point: Some("vertex"), buffers: &[], compilation_options: Default::default() },
+            fragment: Some(g::FragmentState {
+                module: &shader,
+                entry_point: Some("fragment"),
+                targets: &[Some(g::TextureFormat::Rgba8UnormSrgb.into())],
+                compilation_options: Default::default(),
+            }),
+            primitive: Default::default(),
+            depth_stencil: None,
+            multisample: Default::default(),
+            multiview_mask: None,
+            cache: None,
+        });
+        let sampler =
+            d.create_sampler(&g::SamplerDescriptor { min_filter: g::FilterMode::Linear, mag_filter: g::FilterMode::Linear, ..Default::default() });
+        Self { pipeline, sampler }
+    }
+
+    pub fn encode(&self, d: &g::Device, texture: &g::Texture) -> g::CommandBuffer {
+        let layout = self.pipeline.get_bind_group_layout(0);
+        let mut encoder = d.create_command_encoder(&Default::default());
+        for layer in 0..texture.depth_or_array_layers() {
+            let view = |level| {
+                texture.create_view(&g::TextureViewDescriptor {
+                    dimension: Some(g::TextureViewDimension::D2),
+                    base_array_layer: layer,
+                    array_layer_count: Some(1),
+                    base_mip_level: level,
+                    mip_level_count: Some(1),
+                    ..Default::default()
+                })
+            };
+            let mut source = view(0);
+            for level in 1..texture.mip_level_count() {
+                let target = view(level);
+                let group = d.create_bind_group(&g::BindGroupDescriptor {
+                    label: None,
+                    layout: &layout,
+                    entries: &[
+                        g::BindGroupEntry { binding: 0, resource: g::BindingResource::TextureView(&source) },
+                        g::BindGroupEntry { binding: 1, resource: g::BindingResource::Sampler(&self.sampler) },
+                    ],
+                });
+                let mut pass = encoder.begin_render_pass(&g::RenderPassDescriptor {
+                    color_attachments: &[Some(g::RenderPassColorAttachment {
+                        view: &target,
+                        resolve_target: None,
+                        depth_slice: None,
+                        ops: g::Operations { load: g::LoadOp::Clear(g::Color::TRANSPARENT), store: g::StoreOp::Store },
+                    })],
+                    ..Default::default()
+                });
+                pass.set_pipeline(&self.pipeline);
+                pass.set_bind_group(0, &group, &[]);
+                pass.draw(0..3, 0..1);
+                drop(pass);
+                source = target;
+            }
+        }
+        encoder.finish()
+    }
+}
