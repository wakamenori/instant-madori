new file mode 100644
index 000000000..53aeb01dc
--- /dev/null
+++ b/crates/viewer/src/gpu/room.rs
@@ -0,0 +1,270 @@
+use solidcraft_geom::{Aabb3, Mesh, MeshGeom};
+use solidcraft_viewport::{Camera, Rgb, Scene, SceneMesh};
+use std::sync::Arc;
+
+pub struct PatternImage {
+    pub slot: u32,
+    pub width: u32,
+    pub height: u32,
+    pub rgba: Vec<u8>,
+}
+#[derive(Clone, Copy)]
+pub struct PatternFrame {
+    pub origin: [f32; 3],
+    pub u: [f32; 3],
+    pub v: [f32; 3],
+}
+pub struct FacePattern {
+    #[cfg(feature = "pattern-b")]
+    pub curved: bool,
+    pub body: usize,
+    pub face: u32,
+    pub slot: u32,
+    pub frame: PatternFrame,
+}
+pub struct Room {
+    pub scene: Scene,
+    pub faces: Vec<FacePattern>,
+    pub bounds: Aabb3,
+}
+
+fn quad(mesh: &mut Mesh, p: [[f64; 3]; 4], n: [[f64; 3]; 4], face: u32) {
+    let i = mesh.positions.len() as u32;
+    for point in p {
+        mesh.positions.push(point.into());
+    }
+    for normal in n {
+        mesh.normals.push(normal.into());
+    }
+    mesh.triangles
+        .extend([[i, i + 1, i + 2], [i, i + 2, i + 3]]);
+    mesh.tri_face.extend([face; 2]);
+}
+fn cuboid(lo: [f64; 3], hi: [f64; 3]) -> Mesh {
+    let mut m = Mesh::default();
+    for axis in 0..3 {
+        let b = (axis + 1) % 3;
+        let c = (axis + 2) % 3;
+        for upper in [false, true] {
+            let mut n = [0.; 3];
+            n[axis] = if upper { 1. } else { -1. };
+            let mut p = [[0.; 3]; 4];
+            for (i, (s, t)) in [(false, false), (true, false), (true, true), (false, true)]
+                .into_iter()
+                .enumerate()
+            {
+                p[i][axis] = if upper { hi[axis] } else { lo[axis] };
+                p[i][b] = if s == upper { hi[b] } else { lo[b] };
+                p[i][c] = if t { hi[c] } else { lo[c] };
+            }
+            quad(&mut m, p, [n; 4], axis as u32 * 2 + u32::from(upper));
+        }
+    }
+    m
+}
+fn column(x: f64, y: f64) -> Mesh {
+    let mut m = Mesh::default();
+    for i in 0..48 {
+        let ring = |j: u32| {
+            let a = f64::from(j % 48) * std::f64::consts::TAU / 48.;
+            [a.cos(), a.sin(), 0.]
+        };
+        let a = ring(i);
+        let b = ring(i + 1);
+        let point = |n: [f64; 3], z| [x + 150. * n[0], y + 150. * n[1], z];
+        quad(
+            &mut m,
+            [point(a, 0.), point(b, 0.), point(b, 2400.), point(a, 2400.)],
+            [a, b, b, a],
+            0,
+        );
+        for (z, sign, face) in [(0., -1., 1), (2400., 1., 2)] {
+            let k = m.positions.len() as u32;
+            for vertex in [[x, y, z], point(a, z), point(b, z)] {
+                m.positions.push(vertex.into());
+            }
+            for _ in 0..3 {
+                m.normals.push([0., 0., sign].into());
+            }
+            m.triangles.push(if sign > 0. {
+                [k, k + 1, k + 2]
+            } else {
+                [k, k + 2, k + 1]
+            });
+            m.tri_face.push(face);
+        }
+    }
+    m
+}
+impl Room {
+    fn add(
+        &mut self,
+        mesh: Mesh,
+        color: Rgb,
+        opacity: f32,
+        pattern: Option<(u32, u32, PatternFrame)>,
+    ) {
+        if let Some((face, slot, frame)) = pattern {
+            self.faces.push(FacePattern {
+                #[cfg(feature = "pattern-b")]
+                curved: false,
+                body: self.scene.meshes.len(),
+                face,
+                slot,
+                frame,
+            });
+        }
+        self.bounds = self.bounds.union(&mesh.bounds());
+        self.scene.meshes.push(SceneMesh {
+            mesh: Arc::new(mesh),
+            color,
+            face_colors: vec![],
+            opacity,
+            closed: true,
+            hatch: Default::default(),
+            values: None,
+        });
+    }
+}
+pub fn build(length: f64, grid: u32, start: bool, glass: bool) -> Room {
+    let mut room = Room {
+        scene: Scene::default(),
+        bounds: Aabb3::EMPTY,
+        faces: vec![],
+    };
+    for row in 0..grid {
+        for col in 0..grid {
+            let x = f64::from(col) * (length + 700.);
+            let y = f64::from(row) * 3430.;
+            let slab = |lo: [f64; 3], hi: [f64; 3]| {
+                cuboid([lo[0] + x, lo[1] + y, lo[2]], [hi[0] + x, hi[1] + y, hi[2]])
+            };
+            room.add(
+                slab([-120., -120., -150.], [length + 120., 2850., 0.]),
+                Rgb(151, 113, 67),
+                1.,
+                Some((
+                    5,
+                    0,
+                    PatternFrame {
+                        origin: [0.; 3],
+                        u: [0., 240., 0.],
+                        v: [480., 0., 0.],
+                    },
+                )),
+            );
+            let tile = Rgb(210, 205, 195);
+            let mut wall = |lo: [f64; 3], hi: [f64; 3], face: u32| {
+                #[cfg(not(any(feature = "pattern-a", feature = "pattern-b")))]
+                let (origin, u) = {
+                    let along_x = face >= 2;
+                    let (origin, u) = if along_x {
+                        (
+                            [
+                                if start { x + lo[0] } else { 0. },
+                                y + if face == 3 { hi[1] } else { lo[1] },
+                                0.,
+                            ],
+                            [600., 0., 0.],
+                        )
+                    } else {
+                        (
+                            [
+                                x + if face == 1 { hi[0] } else { lo[0] },
+                                if start { y + lo[1] } else { 0. },
+                                0.,
+                            ],
+                            [0., 600., 0.],
+                        )
+                    };
+                    (origin, u)
+                };
+                #[cfg(any(feature = "pattern-a", feature = "pattern-b"))]
+                let (origin, u) = match face {
+                    3 => ([if start { x } else { 0. }, y, 0.], [600., 0., 0.]),
+                    0 => ([x + length, if start { y } else { 0. }, 0.], [0., 600., 0.]),
+                    2 => (
+                        [if start { x + length } else { 0. }, y + 2730., 0.],
+                        [-600., 0., 0.],
+                    ),
+                    _ => ([x, if start { y + 2730. } else { 0. }, 0.], [0., -600., 0.]),
+                };
+                room.add(
+                    slab(lo, hi),
+                    tile,
+                    1.,
+                    Some((
+                        face,
+                        1,
+                        PatternFrame {
+                            origin: origin.map(|n| n as f32),
+                            u,
+                            v: [0., 0., 600.],
+                        },
+                    )),
+                );
+            };
+            let mid = length / 2.;
+            for (a, b) in [(0., mid), (mid, length)] {
+                wall([a, -120., 0.], [b, 0., 2400.], 3);
+            }
+            for (a, b, h, t) in [
+                (0., mid - 845., 0., 2400.),
+                (mid + 845., length, 0., 2400.),
+                (mid - 845., mid + 845., 0., 900.),
+                (mid - 845., mid + 845., 2000., 2400.),
+            ] {
+                wall([a, 2730., h], [b, 2850., t], 2);
+            }
+            wall([-120., 0., 0.], [0., 2730., 2400.], 1);
+            wall([length, 0., 0.], [length + 120., 2730., 2400.], 0);
+            if glass {
+                room.add(
+                    slab([mid - 845., 2787., 900.], [mid + 845., 2793., 2000.]),
+                    Rgb(155, 203, 221),
+                    0.35,
+                    None,
+                );
+            }
+            room.add(
+                column(x + 1450., y + 810.),
+                tile,
+                1.,
+                Some((
+                    0,
+                    1,
+                    PatternFrame {
+                        origin: [0.; 3],
+                        u: [600., 0., 0.],
+                        v: [0., 0., 600.],
+                    },
+                )),
+            );
+            #[cfg(feature = "pattern-b")]
+            if let Some(column) = room.faces.last_mut() {
+                column.curved = true;
+            }
+        }
+    }
+    room.scene.radius = room.bounds.diagonal();
+    room
+}
+pub fn camera(preset: u32, length: f64) -> Camera {
+    let (eye, target) = match preset {
+        1 => ([length * 0.51, 230., 1450.], [length * 0.5, 2730., 1280.]),
+        3 => ([length * 0.5, 3350., 1980.], [length * 0.5, 1510., 0.]),
+        2 => ([180., 430., 140.], [length, 460., 100.]),
+        4 => ([450., 2070., 1300.], [450., 2730., 1300.]),
+        5 => ([2020., 810., 1300.], [1450., 810., 1300.]),
+        _ => ([2260., 2450., 1480.], [1760., 0., 940.]),
+    };
+    let [dx, dy, dz] = std::array::from_fn(|i| target[i] - eye[i]);
+    Camera {
+        target: target.into(),
+        yaw: dx.atan2(dy),
+        pitch: (-dz).atan2(dx.hypot(dy)),
+        distance: dx.hypot(dy).hypot(dz),
+        fov: 65_f64.to_radians(),
+        ..Default::default()
+    }
+}
