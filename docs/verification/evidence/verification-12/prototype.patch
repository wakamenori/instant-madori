@@ -0,0 +1,28 @@
+import json,math,subprocess
+from collections import defaultdict
+from pathlib import Path
+raw=Path("docs/verification/evidence/verification-12/raw")
+rows=defaultdict(list)
+for line in (raw/"dev.jsonl").read_text().splitlines():
+    r=json.loads(line)
+    if r["method"] in ["G","A","Q","E-convex"]:
+        rows[r["case"],r["method"],r["pitch"]].append(r)
+count=0
+mismatches=0
+for (case,m,p),expected in rows.items():
+    result=subprocess.check_output(["target/sunbench/release/sunbench",raw/"scenes"/(case+".scene"),str(["G","A","Q","E-convex"].index(m)),str(p),"0","1"],text=True)
+    for r,line in zip(expected,result.splitlines(),strict=True):
+        actual=json.loads(line)
+        for role,(a,b) in enumerate(zip(r["areas"],actual["areas"])):
+            if m=="E-convex":
+                matches=abs(a-b)<=1e-6
+            else:
+                step=200/2**math.ceil(math.log2(200/p)) if m=="Q" else p
+                matches=round(a*1e6/step**2)==round(b*1e6/step**2)
+            if not matches:
+                print(case,m,p,r["s"],role,a,b)
+                mismatches+=1
+            count+=1
+print("compared role areas:",count)
+print("mismatches:",mismatches)
+assert mismatches==0
diff --git a/crates/modeling/src/model/sun_probe/standalone/e2_cases.py b/crates/modeling/src/model/sun_probe/standalone/e2_cases.py
new file mode 100644
index 000000000..606a6723f
--- /dev/null
+++ b/crates/modeling/src/model/sun_probe/standalone/e2_cases.py
@@ -0,0 +1,75 @@
+import json, math, os, subprocess, sys
+from pathlib import Path
+from e2_scenes import raw, scenes, convert
+adv = raw.parent/"interrogate"
+sys.path.insert(0,str(adv/"adversary-1"))
+from scene import Scene
+tmp = Path("target/sunbench/cases")
+tmp.mkdir(exist_ok=True)
+old = raw/"scenes"
+source = tmp/"source.scene"
+test = tmp/"test.scene"
+exe = tmp.parent/"release/sunbench"
+
+def transform(script,*args):
+    subprocess.run([sys.executable,"-B",adv/script,*map(str,args)],stdout=subprocess.DEVNULL,check=True)
+def run(path,m):
+    return list(map(json.loads,subprocess.check_output([exe,path,str(m),"25","0","1"],text=True).splitlines()))
+def check(label,case,src,angle=0,scale=1,shift=(0,0,0),grid=False):
+    convert(src,test,case,angle,scale,shift)
+    reference=run(test,0) if grid else []
+    for i,(e,e2) in enumerate(zip(run(test,3),run(test,4))):
+        exp = list(Scene(src).suns[i][2])
+        if case=="slit":
+            b=math.radians([0,7.125,10,12.680][i]);a=math.pi/6
+            exp=[(.05-.2*math.tan(b))*(1-.2*math.tan(a)/math.cos(b))*math.cos(b)/math.tan(a),0,0]
+        if case.startswith("gap"):exp[1:]=[0,0]
+        if scale!=1:
+            exp[1]*=scale
+            exp[2]*=math.hypot(math.cos(math.pi/6),scale*math.sin(math.pi/6))
+        if grid:exp=reference[i]["areas"]
+        if label=="roof45":
+            e["areas"]=[dict(e["faces"]).get("roof/1",0)]
+            e2["areas"]=[dict(e2["faces"]).get("roof/1",0)]
+            exp=[0]
+        if label=="grazing":
+            e["areas"]=[dict(e["faces"]).get("west000/4",0)]
+            e2["areas"]=[dict(e2["faces"]).get("west000/4",0)]
+            exp=[0]
+        yield dict(case=case,variant=label,idx=i,sun=e["sun"],expected=exp,E=e["areas"],E2=e2["areas"])
+def cases():
+    for p in sorted(old.glob("*.scene")):
+        if p.stem!="house":yield from check("fixed",p.stem,p)
+    for case in ["wall","slope","floor","slit","gap20"]:
+        for angle in range(0,91,5):
+            for mode in ["f64plane","meshplane"]:
+                transform("adversary-1/rotate.py",old/(case+".scene"),source,angle)
+                if mode=="meshplane":transform("adversary-1/meshplane.py",source,source)
+                yield from check(f"{mode} {angle}°",case,source,angle)
+    for c in [0.52,math.sqrt(.48),math.sqrt(.75),1.04]:
+        transform("adversary-1/scale.py",old/"slope.scene",source,c)
+        yield from check(f"pitch {math.degrees(math.atan(c/math.sqrt(3))):.1f}°","slope",source,scale=c)
+    for dz in [.1,1,10,1000.1]:
+        transform("adversary-1/shift.py",old/"slope.scene",source,0,0,dz)
+        yield from check(f"dz {dz} mm","slope",source,shift=(0,0,dz))
+    transform("adversary-2/eave.py",old/"slope.scene",source)
+    yield from check("eave","slope",source)
+    for name,case,alt,az in [("roof45","slope",45,0),("grazing","wall",20,1e-8)]:
+        a,b=map(math.radians,(alt,az))
+        sc=Scene(old/(case+".scene"))
+        sc.suns=[[name,[math.cos(a)*math.sin(b),-math.cos(a)*math.cos(b),math.sin(a)],[-1]*3]]
+        sc.write(source)
+        yield from check(name,case,source)
+    sc=Scene(old/"house.scene")
+    ids=[i for i,t in enumerate(sc.ts) if max(sc.vs[k][1] for k in t[:3])>=-1000]
+    remap={j:i for i,j in enumerate(ids)}
+    sc.ts=[sc.ts[i] for i in ids]
+    for f in sc.faces:f[4]=[remap[i] for i in f[4]]
+    sc.write(source)
+    convert(source,scenes/"house-noneighbors.scene","house")
+    transform("adversary-1/rotate.py",source,source,30)
+    yield from check("no neighbors 30° (G25)","house",source,angle=30,grid=True)
+
+if __name__=="__main__":
+    with (raw/"e2-cases.jsonl").open("w") as out:
+        for record in cases():print(json.dumps(record,ensure_ascii=False),file=out)
