+#!/bin/bash
+set -euo pipefail
+bench=crates/modeling/src/model/sun_probe/bench
+raw="$PWD/docs/verification/evidence/verification-12/raw"
+if [[ ${1:-} != slot ]]; then
+  exec mise exec -- node scripts/shared/docker-slots.ts run -- bash "$bench/linux.sh" slot
+fi
+disk(){ df -h /; test "$(df -k / | awk 'END{print $4}')" -gt 12582912; }
+{
+uname -m
+docker info --format 'Docker {{.Architecture}}'
+settings="$HOME/Library/Group Containers/group.com.docker/settings-store.json"
+if [[ -r "$settings" ]]; then rg -i 'rosetta' "$settings" || true; fi
+} > "$raw/environment.txt"
+disk
+docker build --progress=plain --platform linux/amd64 -f "$bench/Dockerfile" -t sunlight-probe-203 . 2>&1 | tee "$raw/build.log"
+disk
+for method in G A Q E-convex E-kernel B; do
+  docker run --rm --platform linux/amd64 --entrypoint uname sunlight-probe-203 -m
+  docker run --rm --platform linux/amd64 -v "$raw:/out" -e SUN_HOUSE=1 -e SUN_METHOD="$method" -e SUN_OUT="/out/$method.jsonl" sunlight-probe-203 | tee "$raw/$method.log"
+  disk
+done
