+use super::*;
+use std::io::Write;
+fn sun(alt: f64, az: f64) -> V {
+    let a = alt.to_radians();
+    let b = az.to_radians();
+    V(a.cos() * b.sin(), -a.cos() * b.cos(), a.sin())
+}
+fn conditions(case: &str) -> Vec<(&str, V, [Option<f64>; 3])> {
+    let none = [None; 3];
+    match case {
+        "floor" => vec![
+            ("S30", sun(30., 0.), [Some(2.046307), Some(0.), Some(0.)]),
+            ("S60", sun(60., 0.), [None, None, Some(0.)]),
+        ],
+        "wall" => vec![("S20", sun(20., 0.), [Some(0.), Some(1.232647), Some(0.)])],
+        "slope" => vec![(
+            "S20",
+            sun(20., 0.),
+            [Some(0.), Some(0.671832), Some(1.086707)],
+        )],
+        "slit" => [
+            (0., 0.076603),
+            (7.125, 0.037967),
+            (10., 0.022186),
+            (12.680, 0.007449),
+        ]
+        .into_iter()
+        .map(|(a, e)| ("slit", sun(30., a), [Some(e), None, None]))
+        .collect(),
+        "gap20" | "gap50" => vec![(
+            "S30",
+            sun(30., 0.),
+            [
+                Some(if case == "gap20" { 0.034105 } else { 0.085263 }),
+                None,
+                None,
+            ],
+        )],
+        _ => vec![
+            ("Dec09", V(0.585938, -0.734734, 0.341821), none),
+            ("Dec12", V(-0.084803, -0.855773, 0.510353), none),
+            (
+                "Dec15",
+                V(
+                    -0.7058857256555522,
+                    -0.6648279244185717,
+                    0.24439552620501964,
+                ),
+                none,
+            ),
+            ("Mar12", sun(54.3, 0.), none),
+            ("Jun12", V(-0.070828, -0.210205, 0.975088), none),
+            ("night", sun(-5., 0.), none),
+        ],
+    }
+}
+#[test]
+fn sun_probe_measure() {
+    let house = std::env::var_os("SUN_HOUSE").is_some();
+    let selected = std::env::var("SUN_METHOD").unwrap_or_default();
+    let path = std::env::var("SUN_OUT").ok();
+    let mut file = path.map(|p| std::fs::File::create(p).unwrap());
+    for case in if house {
+        vec!["house"]
+    } else {
+        vec!["floor", "wall", "slope", "slit", "gap50", "gap20"]
+    } {
+        let scene = scene::create(case);
+        for rep in 0..if house { 5 } else { 1 } {
+            let d = Data::from(&scene);
+            for (label, s, expected) in conditions(case) {
+                let s = s.unit();
+                for method in ["G", "A", "Q", "E-convex", "E-kernel", "B"] {
+                    if !selected.is_empty() && method != selected {
+                        continue;
+                    }
+                    for &pitch in match method {
+                        "B" | "G" => &[200, 100, 50, 25, 10][..],
+                        "A" | "Q" => &[25, 10, 5],
+                        _ => &[0],
+                    } {
+                        let r3: u64 = if pitch == 0 {
+                            0
+                        } else {
+                            let step = if method == "Q" {
+                                200. / (200. / pitch as f64).log2().ceil().exp2()
+                            } else {
+                                pitch as f64
+                            };
+                            d.faces
+                                .iter()
+                                .filter(|f| f.recv)
+                                .map(|f| {
+                                    let mut verts = std::collections::BTreeSet::new();
+                                    let mut edges = std::collections::BTreeSet::new();
+                                    let mut longest: f64 = 0.;
+                                    for t in &f.tris {
+                                        for i in 0..3 {
+                                            let (a, b) = (t[i], t[(i + 1) % 3]);
+                                            longest = longest.max((a[0] - b[0]).hypot(a[1] - b[1]));
+                                            let key = |q: P| q.map(|v| (v * 1e6).round() as i64);
+                                            let mut e = [key(a), key(b)];
+                                            verts.insert(e[0]);
+                                            e.sort();
+                                            edges.insert(e);
+                                        }
+                                    }
+                                    let n = (longest / step).ceil() as u64;
+                                    13 * (verts.len() as u64
+                                        + edges.len() as u64 * (n - 1)
+                                        + f.tris.len() as u64 * (n - 1) * n.saturating_sub(2) / 2)
+                                })
+                                .sum()
+                        };
+                        let start = Instant::now();
+                        let mut roles = [0.; 3];
+                        let mut faces = BTreeMap::new();
+                        let mut total = ResultRow::default();
+                        for f in d.faces.iter().filter(|f| f.recv) {
+                            let r = if s.2 <= 0. || s.dot(f.n) <= 1e-10 {
+                                ResultRow::default()
+                            } else if method.starts_with("E-") {
+                                exact::run(&d, f, s, method == "E-kernel")
+                            } else {
+                                grid::run(&d, f, s, method, f64::from(pitch), !house)
+                            };
+                            roles[f.role] += r.area / 1e6;
+                            total.rays += r.rays;
+                            total.r1 += r.r1;
+                            total.r2 += r.r2;
+
+                            total.diff += r.diff;
+                            faces.insert(&f.id,json!({"role":(["floor","wall","ceiling"][f.role]),"area":r.area/1e6,"diff":r.diff,"examples":r.examples,"error":r.error}));
+                        }
+                        let elapsed = ms(start);
+                        let row = json!({"case":case,"sun":label,"s":s.arr(),"method":method,"pitch":pitch,"rep":rep,"areas":roles,"faces":faces,"expected":expected,"errors":(0..3).map(|i|expected[i].map(|e|roles[i]-e)).collect::<Vec<_>>(),"rays":total.rays,"prep_ms":d.prep,"brep_prep_ms":d.brep_ms,"ms":elapsed,"r1":total.r1,"r2":total.r2,"r3":r3,"different_points":if house{None}else{Some(total.diff)},"profile":if cfg!(debug_assertions){"dev"}else{"release"},"os":std::env::consts::OS,"arch":std::env::consts::ARCH});
+                        if let Some(file) = &mut file {
+                            writeln!(file, "{row}").unwrap()
+                        } else {
+                            println!("{row}")
+                        }
+                    }
+                }
+            }
+        }
+    }
+    if let Ok(status) = std::fs::read_to_string("/proc/self/status") {
+        println!(
+            "{}",
+            status
+                .lines()
+                .find(|l| l.starts_with("VmHWM:"))
+                .unwrap_or("VmHWM unavailable")
+        );
+    }
+}
+
+#[test]
+fn export_fixtures() {
+    let Ok(dir) = std::env::var("SUN_SCENES") else {
+        return;
+    };
+    std::fs::create_dir_all(&dir).unwrap();
+    for case in ["floor", "wall", "slope", "slit", "gap50", "gap20", "house"] {
+        let scene = scene::create(case);
+        let d = Data::from(&scene);
+        let world = scene.session.world_state().unwrap();
+        let mut vertices = vec![];
+        let mut triangles = vec![];
+        let mut groups = BTreeMap::<String, Vec<usize>>::new();
+        for body in &world.bodies {
+            let mesh = body.mesh();
+            let base = vertices.len() as u32;
+            vertices.extend(
+                mesh.positions
+                    .iter()
+                    .map(|p| [p.x as f32, p.y as f32, p.z as f32]),
+            );
+            for (tri, id) in mesh.triangles.iter().zip(&mesh.tri_face) {
+                groups
+                    .entry(format!("{}/{}", body.name, id))
+                    .or_default()
+                    .push(triangles.len());
+                triangles.push((tri.map(|i| i + base), body.name.starts_with("Glass")));
+            }
+        }
+        let mut w =
+            std::io::BufWriter::new(std::fs::File::create(format!("{dir}/{case}.scene")).unwrap());
+        writeln!(w, "SUN1 {}", vertices.len()).unwrap();
+        for [x, y, z] in vertices {
+            writeln!(w, "{x:?} {y:?} {z:?}").unwrap();
+        }
+        writeln!(w, "{}", triangles.len()).unwrap();
+        for ([a, b, c], g) in &triangles {
+            writeln!(w, "{a} {b} {c} {}", u8::from(*g)).unwrap();
+        }
+        let faces: Vec<_> = d.faces.iter().filter(|f| f.recv).collect();
+        println!(
+            "{case} total={} faces={} opaque={}",
+            triangles.len(),
+            faces.len(),
+            d.mesh.triangles.len()
+        );
+        writeln!(w, "{}", faces.len()).unwrap();
+        for f in faces {
+            let ids = &groups[&f.id];
+            write!(
+                w,
+                "{} {} {} {} {} {} {} {} {}",
+                f.id,
+                f.role,
+                f.n.0,
+                f.n.1,
+                f.n.2,
+                f.o.0,
+                f.o.1,
+                f.o.2,
+                ids.len()
+            )
+            .unwrap();
+            for i in ids {
+                write!(w, " {i}").unwrap();
+            }
+            writeln!(w).unwrap();
+        }
+        writeln!(w, "{}", scene.openings.len()).unwrap();
+        for op in scene.openings {
+            for V(x, y, z) in op {
+                writeln!(w, "{x} {y} {z}").unwrap();
+            }
+        }
+        let suns = conditions(case);
+        writeln!(w, "{}", suns.len()).unwrap();
+        for (label, s, ex) in suns {
+            let V(x, y, z) = s.unit();
+            writeln!(
+                w,
+                "{label} {x} {y} {z} {} {} {}",
+                ex[0].unwrap_or(-1.),
+                ex[1].unwrap_or(-1.),
+                ex[2].unwrap_or(-1.)
+            )
+            .unwrap();
+            if case == "house" {
+                let mut areas = [0.; 3];
+                for f in d
+                    .faces
+                    .iter()
+                    .filter(|f| f.recv && z > 0. && s.unit().dot(f.n) > 1e-10)
+                {
+                    areas[f.role] += exact::run(&d, f, s.unit(), false).area / 1e6;
+                }
+                println!("reference {label} {areas:?}");
+            }
+        }
+    }
+    exact::kernel_sample();
+}
diff --git a/crates/modeling/src/model/sun_probe/scene.rs b/crates/modeling/src/model/sun_probe/scene.rs
