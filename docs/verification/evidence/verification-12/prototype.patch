@@ -0,0 +1,32 @@
+import math
+from pathlib import Path
+
+raw = Path("docs/verification/evidence/verification-12/raw")
+scenes = raw / "scenes2"
+
+
+def convert(src, dst, case, angle=0, scale=1, shift=(0, 0, 0)):
+    house = case == "house"
+    size = range(2 if house else 1)
+    width = 4800 if house else 4000
+    depth = 3900 if house else {"wall": 2000, "slope": 3000}.get(case, 4000)
+    height = 4000 if case == "slope" else 2400
+    c, s = math.cos(math.radians(angle)), math.sin(math.radians(angle))
+    rooms = []
+    for level in size:
+        for row in size:
+            for col in size:
+                z = 2600 * level
+                values = [scale*z + shift[2], scale*(z+height) + shift[2]]
+                for dx, dy in ((0, 0), (width, 0), (width, depth), (0, depth)):
+                    x, y = col*(width+200)+dx, row*(depth+200)+dy
+                    values.extend([x*c-y*s+shift[0], x*s+y*c+shift[1]])
+                rooms.append(" ".join(map(str, values)))
+    dst.write_text(src.read_text().replace("SUN1", "SUN2", 1).rstrip() + "\n" +
+                   str(len(rooms)) + "\n" + "\n".join(rooms) + "\n")
+
+
+if __name__ == "__main__":
+    scenes.mkdir(exist_ok=True)
+    for src in (raw/"scenes").glob("*.scene"):
+        convert(src, scenes/src.name, src.stem)
