new file mode 100644
index 000000000..a46724d4e
--- /dev/null
+++ b/crates/modeling/src/model/sun_probe.rs
@@ -0,0 +1,267 @@
+#![allow(clippy::unwrap_used)]
+use super::probe_kit::Cad;
+use serde_json::{Value, json};
+use solidcraft_engine::{
+    Session,
+    geom::{Mesh, MeshIndex, prelude::*},
+    kernel,
+};
+use std::{collections::BTreeMap, time::Instant};
+mod exact;
+mod grid;
+mod run;
+mod scene;
+#[derive(Clone, Copy, Debug, Default)]
+struct V(f64, f64, f64);
+impl V {
+    fn add(self, b: V) -> V {
+        V(self.0 + b.0, self.1 + b.1, self.2 + b.2)
+    }
+    fn sub(self, b: V) -> V {
+        self.add(b.mul(-1.))
+    }
+    fn mul(self, k: f64) -> V {
+        V(self.0 * k, self.1 * k, self.2 * k)
+    }
+    fn dot(self, b: V) -> f64 {
+        self.0 * b.0 + self.1 * b.1 + self.2 * b.2
+    }
+    fn cross(self, b: V) -> V {
+        V(
+            self.1 * b.2 - self.2 * b.1,
+            self.2 * b.0 - self.0 * b.2,
+            self.0 * b.1 - self.1 * b.0,
+        )
+    }
+    fn unit(self) -> V {
+        self.mul(1. / self.dot(self).sqrt())
+    }
+    fn arr(self) -> [f64; 3] {
+        [self.0, self.1, self.2]
+    }
+}
+type P = [f64; 2];
+type Poly = Vec<P>;
+type Bounds = [P; 2];
+fn cross(a: P, b: P, c: P) -> f64 {
+    (b[0] - a[0]) * (c[1] - a[1]) - (b[1] - a[1]) * (c[0] - a[0])
+}
+fn bounds<'a>(pts: impl Iterator<Item = &'a P>) -> Bounds {
+    let mut b = [[f64::INFINITY; 2], [f64::NEG_INFINITY; 2]];
+    for p in pts {
+        for i in 0..2 {
+            b[0][i] = b[0][i].min(p[i]);
+            b[1][i] = b[1][i].max(p[i]);
+        }
+    }
+    b
+}
+fn within(b: Bounds, p: P) -> bool {
+    (0..2).all(|k| p[k] >= b[0][k] - 1e-7 && p[k] <= b[1][k] + 1e-7)
+}
+struct Face {
+    brep_o: V,
+    brep_n: V,
+    id: String,
+    o: V,
+    n: V,
+    u: V,
+    v: V,
+    role: usize,
+    tris: Vec<[P; 3]>,
+    loops: Vec<Poly>,
+    b: Bounds,
+    recv: bool,
+}
+impl Face {
+    fn uv(&self, q: V) -> P {
+        let d = q.sub(self.o);
+        [d.dot(self.u), d.dot(self.v)]
+    }
+    fn xyz(&self, p: P) -> V {
+        self.o.add(self.u.mul(p[0])).add(self.v.mul(p[1]))
+    }
+    fn project(&self, q: V, s: V) -> P {
+        self.uv(q.sub(s.mul(q.sub(self.o).dot(self.n) / s.dot(self.n))))
+    }
+    fn inside(&self, p: P) -> bool {
+        within(self.b, p)
+            && self
+                .tris
+                .iter()
+                .any(|t| (0..3).all(|i| cross(t[i], t[(i + 1) % 3], p) >= -1e-7))
+    }
+    fn hit(&self, q: V, s: V) -> bool {
+        let den = s.dot(self.brep_n);
+        if den.abs() < 1e-12 {
+            return false;
+        }
+        let t = self.brep_o.sub(q).dot(self.brep_n) / den;
+        if t <= 1e-7 {
+            return false;
+        }
+        let p = self.uv(q.add(s.mul(t)));
+        if !within(self.b, p) {
+            return false;
+        }
+        let mut inside = false;
+        for ring in &self.loops {
+            for i in 0..ring.len() {
+                let a = ring[i];
+                let b = ring[(i + 1) % ring.len()];
+                if cross(a, b, p).abs() < 1e-7 && within(bounds([&a, &b].into_iter()), p) {
+                    return true;
+                }
+                if (a[1] > p[1]) != (b[1] > p[1])
+                    && p[0] < (b[0] - a[0]) * (p[1] - a[1]) / (b[1] - a[1]) + a[0]
+                {
+                    inside = !inside
+                }
+            }
+        }
+        inside
+    }
+}
+struct Data {
+    mesh: Mesh,
+    index: MeshIndex,
+    faces: Vec<Face>,
+    openings: Vec<Vec<V>>,
+    prep: f64,
+    brep_ms: f64,
+}
+impl Data {
+    fn from(sc: &scene::Scene) -> Self {
+        let start = Instant::now();
+        let world = sc.session.world_state().unwrap();
+        let mut mesh = Mesh::default();
+        let mut faces = vec![];
+        let mut brep_ms = 0.;
+        for body in &world.bodies {
+            if body.name.starts_with("Glass") {
+                continue;
+            }
+            let m = body.mesh();
+            let base = mesh.positions.len() as u32;
+            mesh.positions.extend(&m.positions);
+            mesh.triangles
+                .extend(m.triangles.iter().map(|t| t.map(|i| i + base)));
+            let t = Instant::now();
+            let state = sc.session.model.state();
+            let rec = kernel::brep_record(&state.body(&body.name).unwrap().body).unwrap();
+            brep_ms += ms(t);
+            let mut groups = BTreeMap::<u32, Vec<[V; 3]>>::new();
+            for (tri, id) in m.triangles.iter().zip(&m.tri_face) {
+                groups.entry(*id).or_default().push(tri.map(|i| {
+                    let p = m.positions[i as usize];
+                    V(p.x, p.y, p.z)
+                }));
+            }
+            for (id, tris) in groups {
+                let [a, b, c] = tris[0];
+                let n = b.sub(a).cross(c.sub(a)).unit();
+                let u = if n.0.abs() < 0.9 {
+                    V(1., 0., 0.)
+                } else {
+                    V(0., 1., 0.)
+                };
+                let v = n.cross(u).unit();
+                let u = v.cross(n);
+                let mut f = Face {
+                    brep_o: a,
+                    brep_n: n,
+                    id: format!("{}/{}", body.name, id),
+                    o: a,
+                    n,
+                    u,
+                    v,
+                    role: if n.2 > 1e-7 {
+                        0
+                    } else if n.2 < -1e-7 {
+                        2
+                    } else {
+                        1
+                    },
+                    tris: vec![],
+                    loops: vec![],
+                    b: [[0.; 2]; 2],
+                    recv: false,
+                };
+                let mut center = V::default();
+                let mut area = 0.;
+                for tri in tris {
+                    let p = tri.map(|q| f.uv(q));
+                    let w = cross(p[0], p[1], p[2]);
+                    center = center.add(tri[0].add(tri[1]).add(tri[2]).mul(w / 3.));
+                    area += w;
+                    f.tris.push(p);
+                }
+                let pos = center.mul(1. / area).add(n.mul(10.)).arr();
+                f.recv = !body.name.starts_with("Neighbor")
+                    && !body.name.starts_with("Furniture")
+                    && sc.air.iter().any(|ab| {
+                        (0..3).all(|i| pos[i] > ab[0].arr()[i] && pos[i] < ab[1].arr()[i])
+                    });
+                f.b = bounds(f.tris.iter().flatten());
+                let t = Instant::now();
+                let rf = &rec.faces[id as usize];
+                let surface = json!(&rf.surface);
+                let vec = |name: &str| {
+                    let [x, y, z]: [f64; 3] =
+                        serde_json::from_value(surface[name].clone()).unwrap();
+                    V(x, y, z)
+                };
+                f.brep_o = vec("origin");
+                f.brep_n = match surface["kind"].as_str().unwrap() {
+                    "plane" => vec("u_axis").cross(vec("v_axis")).unit(),
+                    "plane_through" => vec("u_point")
+                        .sub(f.brep_o)
+                        .cross(vec("v_point").sub(f.brep_o))
+                        .unit(),
+                    other => panic!("fixture has nonplanar face {other}"),
+                };
+                for lp in &rf.loops {
+                    let lp = json!(lp);
+                    let mut ring = vec![];
+                    for edge in lp["edges"].as_array().unwrap() {
+                        let e = &rec.edges[edge["edge"].as_u64().unwrap() as usize];
+                        let [x, y, z] = rec.vertices
+                            [e.vertices[usize::from(!edge["forward"].as_bool().unwrap())] as usize]
+                            .point;
+                        ring.push(f.uv(V(x, y, z)));
+                    }
+                    f.loops.push(ring)
+                }
+                brep_ms += ms(t);
+                faces.push(f);
+            }
+        }
+        let index = MeshIndex::new(&mesh);
+        Self {
+            mesh,
+            index,
+            faces,
+            openings: sc.openings.clone(),
+            prep: ms(start) - brep_ms,
+            brep_ms,
+        }
+    }
+    fn mesh_lit(&self, q: V, s: V) -> bool {
+        self.index
+            .raycast(&self.mesh, q.arr().into(), s.arr().into())
+            .is_none()
+    }
+}
+fn ms(t: Instant) -> f64 {
+    t.elapsed().as_secs_f64() * 1000.
+}
+#[derive(Default)]
+struct ResultRow {
+    area: f64,
+    rays: u64,
+    r1: u64,
+    r2: u64,
+    diff: u64,
+    examples: Vec<Value>,
+    error: Option<String>,
+}
