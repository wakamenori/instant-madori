@@ -0,0 +1,240 @@
+use super::*;
+pub struct Scene {
+    pub session: Session,
+    pub air: Vec<[V; 2]>,
+    pub openings: Vec<Vec<V>>,
+}
+fn block(c: &mut Cad, name: &str, a: [f64; 3], b: [f64; 3]) {
+    c.prism(
+        name,
+        &[[a[0], a[1]], [b[0], a[1]], [b[0], b[1]], [a[0], b[1]]],
+        a[2],
+        b[2],
+    )
+    .unwrap()
+}
+fn hole(c: &mut Cad, ops: &mut Vec<Vec<V>>, body: &str, a: [f64; 3], b: [f64; 3], glass: bool) {
+    block(c, "cutter", a, b);
+    c.combine(body, "cutter", "cut", false).unwrap();
+    let mut corners = vec![];
+    for x in [a[0], b[0]] {
+        for y in [a[1], b[1]] {
+            for z in [a[2], b[2]] {
+                corners.push(V(x, y, z));
+            }
+        }
+    }
+    if glass {
+        let y = (a[1] + b[1]) * 0.5;
+        block(
+            c,
+            &format!("Glass{}", ops.len()),
+            [a[0], y, a[2]],
+            [b[0], y + 2., b[2]],
+        );
+    }
+    ops.push(corners);
+}
+pub fn create(case: &str) -> Scene {
+    let mut session = Session::default();
+    let mut c = Cad {
+        session: &mut session,
+        count: 0,
+        elapsed: Default::default(),
+    };
+    let mut openings = vec![];
+    let mut air = vec![];
+    let house = case == "house";
+    let slope = case == "slope";
+    let depth = if house {
+        3900.
+    } else if slope {
+        3000.
+    } else if case == "wall" {
+        2000.
+    } else {
+        4000.
+    };
+    let width = if house { 4800. } else { 4000. };
+    let height = if slope { 4000. } else { 2400. };
+    for level in 0..if house { 2 } else { 1 } {
+        for row in 0..if house { 2 } else { 1 } {
+            for col in 0..if house { 2 } else { 1 } {
+                let x = (width + 200.) * f64::from(col);
+                let y = (depth + 200.) * f64::from(row);
+                let z = 2600. * f64::from(level);
+                let tag = format!("{level}{row}{col}");
+                let name = |s: &str| format!("{s}{tag}");
+                air.push([V(x, y, z), V(x + width, y + depth, z + height)]);
+                block(
+                    &mut c,
+                    &name("floor"),
+                    [x, y, z - 100.],
+                    [x + width, y + depth, z],
+                );
+                if house && level == 1 && row == 1 && col == 1 {
+                    hole(
+                        &mut c,
+                        &mut openings,
+                        &name("floor"),
+                        [x + 500., y + 600., z - 100.],
+                        [x + 1500., y + 2200., z],
+                        false,
+                    );
+                }
+                if slope {
+                    let h = height - depth * 30f64.to_radians().tan();
+                    let outline = [
+                        [0., height],
+                        [depth, h],
+                        [depth, h + 160.],
+                        [0., height + 160.],
+                    ];
+                    c.extrude(
+                        json!({"plane":{"origin":[0,0,0],"x_dir":[0,1,0],"y_dir":[0,0,1]}}),
+                        &outline,
+                        width,
+                        json!({"body_name":"roof","operation":"new"}),
+                    )
+                    .unwrap();
+                } else if !house || level == 1 {
+                    block(
+                        &mut c,
+                        &name("ceiling"),
+                        [x, y, z + height],
+                        [x + width, y + depth, z + height + 100.],
+                    );
+                } else {
+                    block(
+                        &mut c,
+                        &name("ceiling"),
+                        [x, y, z + height],
+                        [x + width, y + depth, z + height + 100.],
+                    );
+                    if row == 1 && col == 1 {
+                        hole(
+                            &mut c,
+                            &mut openings,
+                            &name("ceiling"),
+                            [x + 500., y + 600., z + height],
+                            [x + 1500., y + 2200., z + height + 100.],
+                            false,
+                        );
+                    }
+                }
+                for (s, ya, yb) in [
+                    ("south", y - 200., y),
+                    ("north", y + depth, y + depth + 200.),
+                ] {
+                    if house && s == "north" && row == 0 {
+                        continue;
+                    }
+                    let h = if slope && s == "north" {
+                        height - depth * 30f64.to_radians().tan()
+                    } else {
+                        height
+                    };
+                    block(&mut c, &name(s), [x, ya, z], [x + width, yb, z + h]);
+                    if s == "south" && row == 0 || house {
+                        let interior = house && s == "south" && row == 1;
+                        let w = if case.starts_with("slit") || house && tag == "100" && s == "south"
+                        {
+                            50.
+                        } else {
+                            1200.
+                        };
+                        let lo = if slope {
+                            2800.
+                        } else if interior {
+                            0.
+                        } else {
+                            900.
+                        };
+                        let hi = if slope {
+                            3600.
+                        } else if case.starts_with("slit") {
+                            1900.
+                        } else {
+                            2000.
+                        };
+                        hole(
+                            &mut c,
+                            &mut openings,
+                            &name(s),
+                            [x + (width - w) / 2., ya, z + lo],
+                            [x + (width + w) / 2., yb, z + hi],
+                            !interior,
+                        );
+                        if house && row == 0 && s == "south" {
+                            hole(
+                                &mut c,
+                                &mut openings,
+                                &name(s),
+                                [
+                                    x + 300.,
+                                    ya,
+                                    z + if level == 0 && col == 0 { 0. } else { 900. },
+                                ],
+                                [x + 1100., yb, z + 2000.],
+                                level != 0 || col != 0,
+                            );
+                        }
+                    }
+                }
+                for (s, xa, xb) in [("west", x - 200., x), ("east", x + width, x + width + 200.)] {
+                    if house && s == "east" && col == 0 {
+                        continue;
+                    }
+                    block(&mut c, &name(s), [xa, y, z], [xb, y + depth, z + height]);
+                    if house && col == 1 && s == "west" {
+                        hole(
+                            &mut c,
+                            &mut openings,
+                            &name(s),
+                            [xa, y + 800., z],
+                            [xb, y + 1800., z + 2100.],
+                            false,
+                        );
+                    }
+                }
+                if house {
+                    block(
+                        &mut c,
+                        &name("Furniture"),
+                        [x + 600., y + 600., z],
+                        [x + 1500., y + 1550., z + 1100.],
+                    );
+                }
+            }
+        }
+    }
+    if house {
+        block(
+            &mut c,
+            "roof",
+            [-800., -800., 5100.],
+            [10600., 8800., 5300.],
+        );
+    }
+    if house || case.starts_with("gap") {
+        let gap = if case == "gap20" { 20. } else { 50. };
+        let mid = width / 2.;
+        block(
+            &mut c,
+            "NeighborW",
+            [mid - gap / 2. - 8000., -11200., 0.],
+            [mid - gap / 2., -3200., 6500.],
+        );
+        block(
+            &mut c,
+            "NeighborE",
+            [mid + gap / 2., -11200., 0.],
+            [mid + gap / 2. + 8000., -3200., 6500.],
+        );
+    }
+    Scene {
+        session,
+        air,
+        openings,
+    }
+}
