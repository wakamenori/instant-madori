+import json,re,subprocess,sys
+from pathlib import Path
+platform=sys.argv[1]
+base=Path(__file__).parent
+raw=Path("docs/verification/evidence/verification-12/raw")
+scene=raw/"scenes/house.scene"
+target=Path("target/sunbench")
+jobs=[(0,10,0),(0,25,0),(1,5,0),(2,5,0),(3,0,0)]
+if platform!="linux":jobs += [(m,p,n) for n in (4,16) for m,p in [(3,0),(0,25)]]
+with (raw/(platform+".jsonl")).open("w") as out:
+    for m,p,n in jobs:
+        args=list(map(str,[m,p,n,5]))
+        if platform=="macos":cmd=["/usr/bin/time","-l",target/"release/sunbench",scene,*args]
+        elif platform=="wasm":cmd=["node",base/"wasm.mjs",target/"wasm32-unknown-unknown/release/sunbench.wasm",scene,*args]
+        else:cmd=["docker","run","--rm","--platform","linux/amd64","-v",f"{scene.resolve()}:/house:ro","sunbench-203","/house",*args]
+        print(platform,m,p,n,flush=True)
+        result=subprocess.run(cmd,capture_output=True,text=True,check=True)
+        pattern={"macos":r"(\d+)\s+maximum resident set size","wasm":r"wasm_bytes (\d+)","linux":r"VmHWM:\s*(\d+)"}[platform]
+        mem=int(re.search(pattern,result.stderr)[1])*(1024 if platform=="linux" else 1)
+        for line in result.stdout.splitlines():
+            row=json.loads(line)
+            print(json.dumps(dict(platform=platform,memory_bytes=mem,**row),separators=(',',':')),file=out)
+        out.flush()
