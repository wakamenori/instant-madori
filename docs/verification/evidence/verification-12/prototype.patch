+import json, re, subprocess, sys
+from pathlib import Path
+from e2_scenes import convert,raw,scenes
+base=Path(__file__).parent
+target=Path("target/sunbench")
+def measure(platform, label, scene, n=0, pitch=1000):
+    args=list(map(str,[4,pitch,n,5]))
+    if platform=="macos":
+        cmd=["/usr/bin/time","-l",target/"release/sunbench",scene,*args]
+    elif platform=="wasm":
+        cmd=["/usr/bin/time","-l","node",base/"wasm.mjs",target/"wasm32-unknown-unknown/release/sunbench.wasm",scene,*args]
+    else:
+        cmd=["docker","run","--rm","--platform","linux/amd64","-v",f"{scene.resolve()}:/house:ro","sunbench-e2","/house",*args]
+    r=subprocess.run(cmd,capture_output=True,text=True,check=True)
+    rss=int(re.search(r"VmHWM:\s*(\d+)" if platform=="linux" else r"(\d+)\s+maximum resident set size",r.stderr)[1])*(1024 if platform=="linux" else 1)
+    rows=list(map(json.loads,r.stdout.splitlines()))
+    assert len(rows)==30
+    for row in rows:
+        row.update(platform=platform,scenario=label,rss_bytes=rss)
+        if platform=="wasm":row["linear_bytes"]=int(re.search(r"wasm_bytes (\d+)",r.stderr)[1])
+        yield row
+def jobs(platform):
+    house=scenes/"house.scene"
+    yield from measure(platform,"baseline",house)
+    if platform=="linux":return
+    yield from measure(platform,"no neighbors",scenes/"house-noneighbors.scene")
+    for n in (4,16,32,64):yield from measure(platform,"cylinders",house,n)
+    for pitch in (500,2000):yield from measure(platform,"cell size",house,pitch=pitch)
+    for n in (100000,400000):
+        src=target/"cases"/"below.scene"; dst=src.with_suffix(".sun2")
+        subprocess.run([sys.executable,"-B",raw.parent/"interrogate/adversary-1/addtris.py",raw/"scenes/house.scene",src,str(n)],check=True)
+        convert(src,dst,"house")
+        yield from measure(platform,f"underground {n}",dst)
+if __name__=="__main__":
+    platform=sys.argv[1]
+    with (raw/f"e2-{platform}.jsonl").open("w") as out:
+        for row in jobs(platform):
+            print(json.dumps(row,separators=(',',':')),file=out)
diff --git a/crates/modeling/src/model/sun_probe/standalone/e2_scenes.py b/crates/modeling/src/model/sun_probe/standalone/e2_scenes.py
