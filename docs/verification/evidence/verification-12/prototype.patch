+import json
+from pathlib import Path
+from statistics import median
+from collections import defaultdict
+
+raw=Path("docs/verification/evidence/verification-12/raw")
+groups=defaultdict(list)
+for platform in ["macos","wasm","linux"]:
+    for line in (raw/(platform+".jsonl")).read_text().splitlines():
+        r=json.loads(line)
+        groups[platform,r["method"],r["pitch"],r["n"]].append(r)
+
+for (platform,m,p,n),rows in groups.items():
+    reference=groups["macos",m,p,n]
+    assert {(r["rep"],r["idx"]) for r in rows}=={(i,j) for i in range(5) for j in range(6)}
+    for r in rows:
+        ref=reference[r["idx"]]
+        assert r["sun"]==ref["sun"]
+        assert all(abs(a-b)<=1e-6 for a,b in zip(r["areas"],ref["areas"],strict=True))
+        if m!="E-convex":
+            assert r["counts"][:3]==ref["counts"][:3]
+
+def times(xs):
+    fmt=lambda x: f"{x:.3f}" if x<1 else f"{x:.2f}"
+    return f"{fmt(median(xs))} ({fmt(min(xs))}–{fmt(max(xs))})"
+
+summary=raw/"summary.md"
+old=summary.read_text().split("## 家一軒")[0]
+lines=[old+"## 家一軒の計測", "", "Apple M4 Pro。Linux amd64 は arm64 Docker 上のエミュレーション。家一軒は三角形1,148枚、遮る三角形1,016枚、受光面48面。時間は5回の中央値（最小–最大）、単位 ms。前処理には書き出し済みの場面のパースと受光面の構築を含み、格子方式では BVH も構築する。CAD のメッシュ生成、ファイル読み込み、Wasm のロード、描画は時間に含まない。方式・間隔・家具数ごとに別プロセスで5回走らせた。macOS は最大 RSS、Linux は VmHWM、Wasm は線形メモリの最大サイズ。", ""]
+suns=["Dec09","Dec12","Dec15","Mar12","Jun12","night"]
+for sweep in (False,True):
+    if sweep: lines+=["### 部屋あたりの円柱数と時間","","各円柱は上下の蓋を含めて256三角形。配置は4列、各階4室。N=0は同じ基準計測を再掲。",""]
+    lines+=["| 環境 | 方式 | mm | N | 遮る三角形 | 前処理 | "+" | ".join(suns)+" | 最大 MiB |","|"+"---|"*13]
+    for (platform,m,p,n),rows in groups.items():
+        if sweep:
+            if platform=="linux" or (m,p) not in [("E-convex",0),("G",25)]:continue
+        elif n:continue
+        assert len(rows)==30
+        parts=[platform,m,str(p),str(n),str(rows[0]['opaque']),times([r['prep'] for r in rows if r['idx']==0])]
+        parts += [times([r['ms'] for r in rows if r['sun']==sun]) for sun in suns]
+        parts += [f"{rows[0]['memory_bytes']/2**20:.3f}"]
+        lines+=["| "+" | ".join(parts)+" |"]
+    lines+=[""]
+lines+=["### 処理量と結果サイズ","","E の候補は受光面の平面で切り、影の外接矩形が面と重なった三角形。試行は凸片と影の対、切り取りはそのうち外接矩形が重なった対。片の累計は影を1枚処理するごとの残存片数を足した値。ピークは単一面の同時片数。面別候補は生データの face_candidates（場面ファイルの面順）にある。","","| N | 太陽 | 候補合計 | 面別候補最大 | 試行 | 切り取り | 片のピーク | 片の累計 | R1 B |","|---|---|---|---|---|---|---|---|---|"]
+for n in (0,4,16):
+    for r in groups["macos","E-convex",0,n][:6]:
+        rays,r1,r2,c,cuts,pieces,attempts,peak=r["counts"]
+        lines+=["| "+" | ".join(map(str,[n,r["sun"],c,max(r["face_candidates"]),attempts,cuts,peak,pieces,r1]))+" |"]
+lines+=["","| 太陽 | G 10 光線 | G 25 光線 | A 5 光線 | Q 5 光線 | A 5 R2 B |","|---|---|---|---|---|---|"]
+for i,sun in enumerate(suns):
+    counts=[groups["macos",m,p,0][i]["counts"] for m,p in [("G",10),("G",25),("A",5),("Q",5)]]
+    lines+=["| "+" | ".join(map(str,[sun,*[c[0] for c in counts],counts[2][2]]))+" |"]
+lines+=["","R1 は光が届いた面ごとに8 B、凸片の頂点ごとに8 B。R2 は面ごとに20 B、非空行ごとに8 B、連続区間ごとに8 Bで見積もった。結果をシリアライズする時間は含まない。Q の指定5 mmに対応する最小格子は3.125 mm。",""]
+summary.write_text("\n".join(lines))
