@@ -0,0 +1,100 @@
+use super::V;
+#[derive(Clone, Copy)]
+pub(crate) struct Ray {
+    axes: [usize; 3],
+    sx: f64,
+    sy: f64,
+    inv: [f64; 3],
+}
+impl Ray {
+    pub fn new(s: V) -> Self {
+        let d = s.arr();
+        let k = (0..3)
+            .max_by(|&i, &j| d[i].abs().total_cmp(&d[j].abs()))
+            .unwrap();
+        let x = (k + 1) % 3;
+        let y = (k + 2) % 3;
+        Self {
+            axes: [x, y, k],
+            sx: d[x] / d[k],
+            sy: d[y] / d[k],
+            inv: d.map(|v| 1. / v),
+        }
+    }
+    fn hit(self, q: V, tri: &[V; 3]) -> bool {
+        let [x, y, z] = self.axes;
+        let p = tri.map(|v| {
+            let a = v.sub(q).arr();
+            [
+                a[x] - self.sx * a[z],
+                a[y] - self.sy * a[z],
+                a[z] * self.inv[z],
+            ]
+        });
+        let edge = |i: usize, j: usize| p[i][0] * p[j][1] - p[i][1] * p[j][0];
+        let w = [edge(1, 2), edge(2, 0), edge(0, 1)];
+        if w.iter().any(|&v| v < 0.) && w.iter().any(|&v| v > 0.) {
+            return false;
+        }
+        let det = w.iter().sum::<f64>();
+        let t = w[0] * p[0][2] + w[1] * p[1][2] + w[2] * p[2][2];
+        det * t > 0.
+    }
+}
+enum Branch {
+    Leaf(Vec<[V; 3]>),
+    Pair(Box<[Tree; 2]>),
+}
+pub(crate) struct Tree {
+    lo: [f64; 3],
+    hi: [f64; 3],
+    branch: Branch,
+}
+impl Tree {
+    pub fn new(ts: &mut [[V; 3]]) -> Self {
+        let mut lo = [f64::INFINITY; 3];
+        let mut hi = [f64::NEG_INFINITY; 3];
+        for p in ts.iter().flatten() {
+            for (k, v) in p.arr().into_iter().enumerate() {
+                lo[k] = lo[k].min(v - 1e-8);
+                hi[k] = hi[k].max(v + 1e-8);
+            }
+        }
+        let branch = if ts.len() <= 4 {
+            Branch::Leaf(ts.to_vec())
+        } else {
+            let k = (0..3)
+                .max_by(|&i, &j| (hi[i] - lo[i]).total_cmp(&(hi[j] - lo[j])))
+                .unwrap();
+            let center = |t: &[V; 3]| t.iter().map(|v| v.arr()[k]).sum::<f64>();
+            let mid = ts.len() / 2;
+            ts.select_nth_unstable_by(mid, |a, b| center(a).total_cmp(&center(b)));
+            let (a, b) = ts.split_at_mut(mid);
+            Branch::Pair(Box::new([Self::new(a), Self::new(b)]))
+        };
+        Self { lo, hi, branch }
+    }
+    pub fn clear(&self, q: V, r: Ray) -> bool {
+        let mut near = 0f64;
+        let mut far = f64::INFINITY;
+        for (i, v) in q.arr().into_iter().enumerate() {
+            if r.inv[i].is_infinite() {
+                if v < self.lo[i] || v > self.hi[i] {
+                    return true;
+                }
+            } else {
+                let a = (self.lo[i] - v) * r.inv[i];
+                let b = (self.hi[i] - v) * r.inv[i];
+                near = near.max(a.min(b));
+                far = far.min(a.max(b));
+                if near > far {
+                    return true;
+                }
+            }
+        }
+        match &self.branch {
+            Branch::Leaf(ts) => !ts.iter().any(|t| r.hit(q, t)),
+            Branch::Pair(k) => k[0].clear(q, r) && k[1].clear(q, r),
+        }
+    }
+}
diff --git a/crates/modeling/src/model/sun_probe/standalone/src/e2.rs b/crates/modeling/src/model/sun_probe/standalone/src/e2.rs
new file mode 100644
index 000000000..8283864ec
--- /dev/null
+++ b/crates/modeling/src/model/sun_probe/standalone/src/e2.rs
@@ -0,0 +1,107 @@
+use super::*;
+
+fn trim(poly: Poly, distance: impl Fn(P) -> f64) -> Poly {
+    exact::clip(
+        &poly,
+        |p| {
+            let d = distance(p);
+            if d.abs() < 0.001 { 0. } else { d }
+        },
+        |a, b, t| [a[0] + t * (b[0] - a[0]), a[1] + t * (b[1] - a[1])],
+    )
+}
+pub(super) fn regions(d: &Data) -> Vec<(usize, Vec<Poly>)> {
+    let mut result = vec![];
+    for (i, f) in d.faces.iter().enumerate() {
+        for r in &d.rooms {
+            if f.role == 0 && (f.n.2 < 0.999999 || (f.o.2 - r.bottom).abs() > 0.01) {
+                continue;
+            }
+            let mut pieces = vec![];
+            for tri in &f.tris {
+                let mut p = tri.to_vec();
+                for j in 0..4 {
+                    let a = r.corners[j];
+                    let b = r.corners[(j + 1) % 4];
+                    let len = (a[0] - b[0]).hypot(a[1] - b[1]);
+                    p = trim(p, |uv| {
+                        let q = f.xyz(uv);
+                        cross(a, b, [q.0, q.1]) / len
+                    });
+                }
+                if f.role == 1 {
+                    p = trim(p, |uv| f.xyz(uv).2 - r.bottom);
+                    p = trim(p, |uv| r.top - f.xyz(uv).2);
+                } else if f.role == 2
+                    && !p.iter().any(|uv| {
+                        let z = f.xyz(*uv).2;
+                        z > r.bottom + 0.01 && z <= r.top + 0.01
+                    })
+                {
+                    continue;
+                }
+                if exact::area(&p) > 1e-8 {
+                    pieces.push(p);
+                }
+            }
+            if !pieces.is_empty() {
+                result.push((i, pieces));
+            }
+        }
+    }
+    result
+}
+pub(super) struct Grid {
+    cells: std::collections::HashMap<(i32, i32), Vec<usize>>,
+    u: V,
+    v: V,
+    size: f64,
+}
+impl Grid {
+    fn key(&self, p: V) -> [i32; 2] {
+        [self.u, self.v].map(|n| (p.dot(n) / self.size).floor() as i32)
+    }
+    fn cells_for(&self, pts: impl Iterator<Item = V>) -> impl Iterator<Item = (i32, i32)> {
+        let mut lo = [i32::MAX; 2];
+        let mut hi = [i32::MIN; 2];
+        for p in pts {
+            let k = self.key(p);
+            for i in 0..2 {
+                lo[i] = lo[i].min(k[i]);
+                hi[i] = hi[i].max(k[i]);
+            }
+        }
+        (lo[0]..=hi[0]).flat_map(move |x| (lo[1]..=hi[1]).map(move |y| (x, y)))
+    }
+    pub(super) fn new(d: &Data, s: V, size: f64) -> Self {
+        let axis = if s.0.abs() < 0.9 {
+            V(1., 0., 0.)
+        } else {
+            V(0., 1., 0.)
+        };
+        let u = s.cross(axis).unit();
+        let mut grid = Self {
+            cells: Default::default(),
+            u,
+            v: s.cross(u),
+            size,
+        };
+        for (i, tri) in d.opaque.iter().enumerate() {
+            for key in grid.cells_for(tri.iter().copied()).collect::<Vec<_>>() {
+                grid.cells.entry(key).or_default().push(i);
+            }
+        }
+        grid
+    }
+    pub(super) fn query(&self, f: &Face, pieces: &[Poly]) -> Vec<usize> {
+        let mut ids = vec![];
+        for k in self.cells_for(pieces.iter().flatten().map(|p| f.xyz(*p))) {
+            if let Some(list) = self.cells.get(&k) {
+                ids.extend_from_slice(list);
+            }
+        }
+        ids.sort_unstable();
+        ids.dedup();
+        ids
+    }
+}
diff --git a/crates/modeling/src/model/sun_probe/standalone/src/exact.rs b/crates/modeling/src/model/sun_probe/standalone/src/exact.rs
new file mode 100644
index 000000000..f8318a6a9
--- /dev/null
+++ b/crates/modeling/src/model/sun_probe/standalone/src/exact.rs
@@ -0,0 +1,120 @@
+use super::*;
+pub(super) fn clip<T: Copy>(
+    poly: &[T],
+    distance: impl Fn(T) -> f64,
+    lerp: impl Fn(T, T, f64) -> T,
+) -> Vec<T> {
+    let mut out = vec![];
+    for i in 0..poly.len() {
+        let a = poly[i];
+        let b = poly[(i + 1) % poly.len()];
+        let (da, db) = (distance(a), distance(b));
+        if da >= 0. {
+            out.push(a)
+        }
+        if (da > 0. && db < 0.) || (da < 0. && db > 0.) {
+            out.push(lerp(a, b, da / (da - db)));
+        }
+    }
+    out
+}
+pub(super) fn area(p: &[P]) -> f64 {
+    (1..p.len().saturating_sub(1))
+        .map(|i| cross(p[0], p[i], p[i + 1]) / 2.)
+        .sum()
+}
+fn overlap(a: Bounds, b: Bounds) -> bool {
+    (0..2).all(|i| a[0][i] < b[1][i] && b[0][i] < a[1][i])
+}
+fn subtract(p: Poly, shadow: &Poly, out: &mut Vec<Poly>) {
+    if !overlap(bounds(p.iter()), bounds(shadow.iter())) {
+        out.push(p);
+        return;
+    }
+    let mut inside = p;
+    for i in 0..shadow.len() {
+        let a = shadow[i];
+        let b = shadow[(i + 1) % shadow.len()];
+        let d = |v| cross(a, b, v);
+        let interp = |a: P, b: P, t: f64| [a[0] + (b[0] - a[0]) * t, a[1] + (b[1] - a[1]) * t];
+        let outside = clip(&inside, |v| -d(v), interp);
+        if area(&outside) > 1e-8 {
+            out.push(outside)
+        }
+        inside = clip(&inside, d, interp);
+        if area(&inside) < 1e-8 {
+            break;
+        }
+    }
+}
+pub(super) fn run(d: &Data, f: &Face, s: V) -> ResultRow {
+    solve(
+        f,
+        s,
+        f.tris.iter().map(|t| t.to_vec()).collect(),
+        d.opaque.iter(),
+        1e-7,
+    )
+}
+pub(super) fn solve<'a>(
+    f: &Face,
+    s: V,
+    mut pieces: Vec<Poly>,
+    triangles: impl Iterator<Item = &'a [V; 3]>,
+    eps: f64,
+) -> ResultRow {
+    let receiver = bounds(pieces.iter().flatten());
+    let mut shadows = vec![];
+    for tri in triangles {
+        let distance = |v: V| {
+            let d = v.sub(f.o).dot(f.n);
+            if eps == 0.01 {
+                if d.abs() <= eps { 0. } else { d }
+            } else {
+                d - eps
+            }
+        };
+        if !tri.iter().any(|&v| distance(v) > 0.) {
+            continue;
+        }
+        let front = clip(tri, distance, |a, b, t| a.add(b.sub(a).mul(t)));
+        let mut p: Poly = front.iter().map(|q| f.project(*q, s)).collect();
+        let a = area(&p);
+        if a.abs() < 1e-8 || !overlap(receiver, bounds(p.iter())) {
+            continue;
+        }
+        if a < 0. {
+            p.reverse()
+        }
+        shadows.push(p);
+    }
+    let mut row = ResultRow::default();
+    row.candidates = shadows.len() as u64;
+    row.peak = pieces.len() as u64;
+    {
+        for sh in shadows {
+            let mut next = vec![];
+            for p in pieces {
+                row.attempts += 1;
+                if overlap(bounds(p.iter()), bounds(sh.iter())) {
+                    row.cuts += 1;
+                }
+                subtract(p, &sh, &mut next)
+            }
+            row.peak = row.peak.max(next.len() as u64);
+            row.pieces += next.len() as u64;
+            pieces = next;
+            if pieces.is_empty() {
+                break;
+            }
+        }
+        for p in pieces {
+            row.area += area(&p);
+            row.r1 += 8 * p.len() as u64;
+        }
+    }
+    if row.r1 > 0 {
+        row.r1 += 8
+    }
+    row
+}
diff --git a/crates/modeling/src/model/sun_probe/standalone/src/grid.rs b/crates/modeling/src/model/sun_probe/standalone/src/grid.rs
new file mode 100644
index 000000000..286407db9
--- /dev/null
+++ b/crates/modeling/src/model/sun_probe/standalone/src/grid.rs
@@ -0,0 +1,133 @@
+use super::*;
+struct Grid<'a> {
+    d: &'a Data,
+    f: &'a Face,
+    s: V,
+    ray: bvh::Ray,
+    step: f64,
+
+    r: ResultRow,
+    runs: BTreeMap<i32, Vec<(i32, i32)>>,
+}
+impl Grid<'_> {
+    fn lit(&mut self, p: P) -> bool {
+        if !self.f.inside(p) {
+            return false;
+        }
+        self.r.rays += 1;
+        let q = self.f.xyz(p).add(self.f.n.mul(0.5));
+        self.d.bvh.clear(q, self.ray)
+    }
+    fn cell(&mut self, x: i32, y: i32, k: i32) {
+        let (origin, step) = (self.f.b[0], self.step);
+        let p = |i: f64, j: f64| {
+            [
+                origin[0] + (f64::from(x) + i) * step,
+                origin[1] + (f64::from(y) + j) * step,
+            ]
+        };
+        let size = f64::from(k);
+        let center = self.lit(p(size / 2., size / 2.));
+        if k > 1
+            && [(0., 0.), (0., size), (size, 0.), (size, size)]
+                .iter()
+                .any(|&(i, j)| self.lit(p(i, j)) != center)
+        {
+            let h = k / 2;
+            for i in [0, h] {
+                for j in [0, h] {
+                    self.cell(x + i, y + j, h)
+                }
+            }
+        } else if center {
+            self.r.area += (size * self.step).powi(2);
+            for j in y..y + k {
+                let row = self.runs.entry(j).or_default();
+                if let Some(last) = row.last_mut()
+                    && last.1 == x
+                {
+                    last.1 = x + k
+                } else {
+                    row.push((x, x + k))
+                }
+            }
+        }
+    }
+}
+pub(super) fn run(d: &Data, f: &Face, s: V, method: &str, pitch: f64) -> ResultRow {
+    let k = if method == "Q" {
+        (200. / pitch).log2().ceil().exp2() as i32
+    } else {
+        1
+    };
+    let step = if method == "Q" {
+        200. / f64::from(k)
+    } else {
+        pitch
+    };
+    let mut g = Grid {
+        d,
+        f,
+        s,
+        step,
+        ray: bvh::Ray::new(s),
+
+        r: Default::default(),
+        runs: Default::default(),
+    };
+    let count = |i: usize| ((f.b[1][i] - f.b[0][i]) / step).ceil() as i32;
+    let mut boxes = vec![f.b];
+    if method == "A" {
+        boxes = d
+            .openings
+            .iter()
+            .map(|op| {
+                bounds(
+                    op.iter()
+                        .map(|q| f.project(*q, s))
+                        .collect::<Vec<_>>()
+                        .iter(),
+                )
+            })
+            .filter(|b| (0..2).all(|i| b[1][i] >= f.b[0][i] && b[0][i] <= f.b[1][i]))
+            .collect();
+    }
+    let idx = |v: f64, i: usize| ((v - f.b[0][i]) / step - 0.5).ceil() as i32;
+    for y in (0..count(1)).step_by(k as usize) {
+        let mut ranges = vec![];
+        for b in &boxes {
+            if method != "A" {
+                ranges.push((0, count(0)));
+                break;
+            }
+            let cy = f.b[0][1] + (f64::from(y) + 0.5) * step;
+            if cy >= b[0][1] && cy <= b[1][1] {
+                ranges.push((idx(b[0][0], 0).max(0), idx(b[1][0] + 1e-8, 0).min(count(0))))
+            }
+        }
+        ranges.sort();
+        let mut end = 0;
+        for (lo, hi) in ranges {
+            for x in (lo.max(end)..hi).step_by(k as usize) {
+                g.cell(x, y, k)
+            }
+            end = end.max(hi);
+        }
+    }
+    if !g.runs.is_empty() {
+        g.r.r2 = 20;
+        for (_, mut runs) in g.runs {
+            runs.sort();
+            let mut last = -1;
+            g.r.r2 += 8;
+            for (a, b) in runs {
+                if a > last {
+                    g.r.r2 += 8
+                }
+                last = last.max(b);
+            }
+        }
+    }
+
+    g.r
+}
diff --git a/crates/modeling/src/model/sun_probe/standalone/src/lib.rs b/crates/modeling/src/model/sun_probe/standalone/src/lib.rs
new file mode 100644
index 000000000..330a33e83
--- /dev/null
+++ b/crates/modeling/src/model/sun_probe/standalone/src/lib.rs
@@ -0,0 +1,402 @@
+use std::collections::BTreeMap;
+mod bvh;
+mod e2;
+mod exact;
+mod grid;
+#[derive(Clone, Copy, Debug, Default)]
+struct V(f64, f64, f64);
+impl V {
+    fn add(self, b: V) -> V {
+        V(self.0 + b.0, self.1 + b.1, self.2 + b.2)
+    }
+    fn sub(self, b: V) -> V {
+        self.add(b.mul(-1.))
+    }
+    fn mul(self, k: f64) -> V {
+        V(self.0 * k, self.1 * k, self.2 * k)
+    }
+    fn dot(self, b: V) -> f64 {
+        self.0 * b.0 + self.1 * b.1 + self.2 * b.2
+    }
+    fn cross(self, b: V) -> V {
+        V(
+            self.1 * b.2 - self.2 * b.1,
+            self.2 * b.0 - self.0 * b.2,
+            self.0 * b.1 - self.1 * b.0,
+        )
+    }
+    fn unit(self) -> V {
+        self.mul(1. / self.dot(self).sqrt())
+    }
+    fn arr(self) -> [f64; 3] {
+        [self.0, self.1, self.2]
+    }
+}
+type P = [f64; 2];
+type Poly = Vec<P>;
+type Bounds = [P; 2];
+fn cross(a: P, b: P, c: P) -> f64 {
+    (b[0] - a[0]) * (c[1] - a[1]) - (b[1] - a[1]) * (c[0] - a[0])
+}
+fn bounds<'a>(pts: impl Iterator<Item = &'a P>) -> Bounds {
+    let mut b = [[f64::INFINITY; 2], [f64::NEG_INFINITY; 2]];
+    for p in pts {
+        for i in 0..2 {
+            b[0][i] = b[0][i].min(p[i]);
+            b[1][i] = b[1][i].max(p[i]);
+        }
+    }
+    b
+}
+fn within(b: Bounds, p: P) -> bool {
+    (0..2).all(|k| p[k] >= b[0][k] - 1e-7 && p[k] <= b[1][k] + 1e-7)
+}
+struct Face {
+    own: Vec<usize>,
+    id: String,
+    o: V,
+    n: V,
+    u: V,
+    v: V,
+    role: usize,
+    tris: Vec<[P; 3]>,
+
+    b: Bounds,
+}
+impl Face {
+    fn uv(&self, q: V) -> P {
+        let d = q.sub(self.o);
+        [d.dot(self.u), d.dot(self.v)]
+    }
+    fn xyz(&self, p: P) -> V {
+        self.o.add(self.u.mul(p[0])).add(self.v.mul(p[1]))
+    }
+    fn project(&self, q: V, s: V) -> P {
+        self.uv(q.sub(s.mul(q.sub(self.o).dot(self.n) / s.dot(self.n))))
+    }
+    fn inside(&self, p: P) -> bool {
+        within(self.b, p)
+            && self
+                .tris
+                .iter()
+                .any(|t| (0..3).all(|i| cross(t[i], t[(i + 1) % 3], p) >= -1e-7))
+    }
+}
+#[derive(Default)]
+struct ResultRow {
+    area: f64,
+    rays: u64,
+    r1: u64,
+    r2: u64,
+    candidates: u64,
+    cuts: u64,
+    attempts: u64,
+    peak: u64,
+    pieces: u64,
+}
+struct Room {
+    bottom: f64,
+    top: f64,
+    corners: [P; 4],
+}
+struct Data {
+    rooms: Vec<Room>,
+    opaque: Vec<[V; 3]>,
+    bvh: bvh::Tree,
+    faces: Vec<Face>,
+    openings: Vec<Vec<V>>,
+    suns: Vec<(String, V)>,
+}
+fn furniture(ts: &mut Vec<[V; 3]>, n: usize) {
+    for level in 0..2 {
+        for row in 0..2 {
+            for col in 0..2 {
+                for i in 0..n {
+                    let x = (col * 5000
+                        + if n <= 16 {
+                            1900 + (i % 4) * 730
+                        } else {
+                            250 + (i % 8) * 600
+                        }) as f64;
+                    let y = (row * 4100
+                        + if n <= 16 {
+                            450 + (i / 4) * 900
+                        } else {
+                            240 + (i / 8) * 480
+                        }) as f64;
+                    let z = (level * 2600) as f64;
+                    let point = |j: usize, h: f64| {
+                        let a = (j % 64) as f64 * std::f64::consts::TAU / 64.;
+                        V(
+                            (x + 200. * a.cos()) as f32 as f64,
+                            (y + 200. * a.sin()) as f32 as f64,
+                            z + h,
+                        )
+                    };
+                    for j in 0..64 {
+                        let a = point(j, 0.);
+                        let b = point(j + 1, 0.);
+                        let c = point(j, 700.);
+                        let d = point(j + 1, 700.);
+                        ts.extend([
+                            [a, b, c],
+                            [b, d, c],
+                            [V(x, y, z), b, a],
+                            [V(x, y, z + 700.), c, d],
+                        ]);
+                    }
+                }
+            }
+        }
+    }
+}
+struct Reader<'a>(std::str::SplitWhitespace<'a>);
+impl Reader<'_> {
+    fn token(&mut self) -> &str {
+        self.0.next().unwrap()
+    }
+    fn n(&mut self) -> usize {
+        self.token().parse().unwrap()
+    }
+    fn scalar(&mut self) -> f64 {
+        self.token().parse().unwrap()
+    }
+    fn v(&mut self) -> V {
+        V(self.scalar(), self.scalar(), self.scalar())
+    }
+}
+impl Data {
+    fn read(input: &str, n: usize, ray: bool) -> Self {
+        let mut r = Reader(input.split_whitespace());
+        let rooms_present = match r.token() {
+            "SUN1" => false,
+            "SUN2" => true,
+            _ => panic!("unknown scene"),
+        };
+        let vs: Vec<_> = (0..r.n())
+            .map(|_| {
+                let p = r.v().arr().map(|x| x as f32 as f64);
+                V(p[0], p[1], p[2])
+            })
+            .collect();
+        let mut opaque = vec![];
+        let mut indices = vec![];
+        let ts: Vec<_> = (0..r.n())
+            .map(|_| {
+                let t = [vs[r.n()], vs[r.n()], vs[r.n()]];
+                let solid = r.n() == 0;
+                indices.push(if solid { Some(opaque.len()) } else { None });
+                if solid {
+                    opaque.push(t);
+                }
+                t
+            })
+            .collect();
+        let faces = (0..r.n())
+            .map(|_| {
+                let id = r.token().to_owned();
+                let role = r.n();
+                let n = r.v();
+                let o = r.v();
+                let u = if n.0.abs() < 0.9 {
+                    V(1., 0., 0.)
+                } else {
+                    V(0., 1., 0.)
+                };
+                let v = n.cross(u).unit();
+                let u = v.cross(n);
+                let mut f = Face {
+                    own: vec![],
+                    id,
+                    role,
+                    n,
+                    o,
+                    u,
+                    v,
+                    tris: vec![],
+                    b: [[0.; 2]; 2],
+                };
+                f.tris = (0..r.n())
+                    .map(|_| {
+                        let i = r.n();
+                        f.own.extend(indices[i]);
+                        ts[i].map(|q| f.uv(q))
+                    })
+                    .collect();
+                f.b = bounds(f.tris.iter().flatten());
+                f
+            })
+            .collect();
+        let openings = (0..r.n())
+            .map(|_| (0..8).map(|_| r.v()).collect())
+            .collect();
+        let suns = (0..r.n())
+            .map(|_| {
+                let name = r.token().to_string();
+                let s = r.v();
+                r.v();
+                (name, s)
+            })
+            .collect();
+        let rooms = if rooms_present {
+            (0..r.n())
+                .map(|_| Room {
+                    bottom: r.scalar(),
+                    top: r.scalar(),
+                    corners: std::array::from_fn(|_| [r.scalar(), r.scalar()]),
+                })
+                .collect()
+        } else {
+            vec![]
+        };
+        furniture(&mut opaque, n);
+        let bvh = if ray {
+            bvh::Tree::new(&mut opaque.clone())
+        } else {
+            bvh::Tree::new(&mut [])
+        };
+        Self {
+            rooms,
+            opaque,
+            bvh,
+            faces,
+            openings,
+            suns,
+        }
+    }
+}
+#[cfg(target_arch = "wasm32")]
+#[link(wasm_import_module = "env")]
+unsafe extern "C" {
+    fn clock_ms() -> f64;
+    fn output(p: *const u8, n: usize);
+}
+fn now() -> f64 {
+    #[cfg(target_arch = "wasm32")]
+    unsafe {
+        return clock_ms();
+    }
+    #[cfg(not(target_arch = "wasm32"))]
+    {
+        static START: std::sync::OnceLock<std::time::Instant> = std::sync::OnceLock::new();
+        START
+            .get_or_init(std::time::Instant::now)
+            .elapsed()
+            .as_secs_f64()
+            * 1000.
+    }
+}
+fn emit(line: String) {
+    #[cfg(target_arch = "wasm32")]
+    unsafe {
+        output(line.as_ptr(), line.len())
+    }
+    #[cfg(not(target_arch = "wasm32"))]
+    println!("{line}");
+}
+pub fn bench(input: &str, m: usize, pitch: usize, n: usize, reps: usize) {
+    let method = ["G", "A", "Q", "E-convex", "E2"][m];
+    for rep in 0..reps {
+        let t = now();
+        let d = Data::read(input, n, m < 3);
+        let regions = if m == 4 {
+            assert!(!d.rooms.is_empty());
+            e2::regions(&d)
+        } else {
+            vec![]
+        };
+        let prep = now() - t;
+        for (idx, (sun, s)) in d.suns.iter().enumerate() {
+            let t = now();
+            let mut areas = [0.; 3];
+            let mut counts = [0u64; 8];
+            let mut candidates = vec![];
+            let mut pairs = 0;
+            let mut indexed = 0;
+            let mut face_areas = vec![];
+            if m == 4 && s.2 > 0. {
+                let grid = e2::Grid::new(&d, *s, if pitch == 0 { 1000. } else { pitch as f64 });
+                indexed = d.opaque.len();
+                for (i, pieces) in &regions {
+                    let f = &d.faces[*i];
+                    if s.dot(f.n) <= 0.01 {
+                        continue;
+                    }
+                    let ids = grid.query(f, pieces);
+                    pairs += ids.len();
+                    let r = exact::solve(
+                        f,
+                        *s,
+                        pieces.clone(),
+                        ids.into_iter()
+                            .filter(|i| !f.own.contains(i))
+                            .map(|i| &d.opaque[i]),
+                        0.01,
+                    );
+                    areas[f.role] += r.area / 1e6;
+                    face_areas.push((f.id.as_str(), r.area / 1e6));
+                    counts[1] += r.r1;
+                    counts[3] += r.candidates;
+                    counts[4] += r.cuts;
+                    counts[5] += r.pieces;
+                    counts[6] += r.attempts;
+                    counts[7] = counts[7].max(r.peak);
+                    candidates.push(r.candidates);
+                }
+            }
+            for f in d.faces.iter().filter(|_| m != 4) {
+                let r = if s.2 <= 0. || s.dot(f.n) <= 1e-10 {
+                    ResultRow::default()
+                } else if m == 3 {
+                    exact::run(&d, f, *s)
+                } else {
+                    grid::run(&d, f, *s, method, pitch as f64)
+                };
+                areas[f.role] += r.area / 1e6;
+                face_areas.push((f.id.as_str(), r.area / 1e6));
+                for (a, b) in counts.iter_mut().zip([
+                    r.rays,
+                    r.r1,
+                    r.r2,
+                    r.candidates,
+                    r.cuts,
+                    r.pieces,
+                    r.attempts,
+                ]) {
+                    *a += b
+                }
+                counts[7] = counts[7].max(r.peak);
+                candidates.push(r.candidates);
+            }
+            let ms = now() - t;
+            let faces = face_areas
+                .iter()
+                .map(|(id, a)| format!("[\"{id}\",{a}]"))
+                .collect::<Vec<_>>()
+                .join(",");
+            emit(format!(
+                r#"{{"method":"{method}","pitch":{pitch},"rep":{rep},"n":{n},"sun":"{sun}","idx":{idx},"prep":{prep},"ms":{ms},"areas":{areas:?},"counts":{counts:?},"face_candidates":{candidates:?},"regions":{},"faces":[{faces}],"pairs":{pairs},"indexed":{indexed},"opaque":{}}}"#,
+                regions.len(),
+                d.opaque.len()
+            ));
+        }
+    }
+}
+#[cfg(target_arch = "wasm32")]
+#[unsafe(no_mangle)]
+pub extern "C" fn alloc(n: usize) -> *mut u8 {
+    Box::into_raw(vec![0u8; n].into_boxed_slice()).cast()
+}
+#[cfg(target_arch = "wasm32")]
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn run(
+    p: *mut u8,
+    len: usize,
+    m: usize,
+    pitch: usize,
+    n: usize,
+    reps: usize,
+) {
+    let input = unsafe { Box::from_raw(std::ptr::slice_from_raw_parts_mut(p, len)) };
+    bench(std::str::from_utf8(&input).unwrap(), m, pitch, n, reps)
+}
