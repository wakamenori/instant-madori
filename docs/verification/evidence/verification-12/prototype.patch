+import { readFileSync } from "node:fs";
+const [wasm, scene, ...args] = process.argv.slice(2);
+const { instance } = await WebAssembly.instantiate(readFileSync(wasm), {
+  env: {
+    clock_ms: () => performance.now(),
+    output: (p, n) =>
+      console.log(new TextDecoder().decode(new Uint8Array(instance.exports.memory.buffer, p, n))),
+  },
+});
+const { alloc, memory, run } = instance.exports;
+const bytes = readFileSync(scene),
+  p = alloc(bytes.length);
+new Uint8Array(memory.buffer, p, bytes.length).set(bytes);
+run(p, bytes.length, ...args.map(Number));
+console.error("wasm_bytes", memory.buffer.byteLength);
