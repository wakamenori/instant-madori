+"""Render the registered comparisons from the JSON Lines, from the repo root."""
+import json
+import re
+import statistics
+from pathlib import Path
+from collections import defaultdict
+
+raw = Path("docs/verification/evidence/verification-12/raw")
+def load(name):
+    return [json.loads(line) for line in (raw / name).read_text().splitlines()]
+lines = []
+def section(name, headings):
+    lines.extend(["", "## " + name, "", "| " + " | ".join(headings) + " |",
+                  "|" + "---|" * len(headings)])
+def row(*cols):
+    lines.append("| " + " | ".join(map(str, cols)) + " |")
+def interval(nums):
+    return f"{statistics.median(nums):.3f} ({min(nums):.3f}–{max(nums):.3f})"
+def errors(r):
+    return [f["error"] for f in r["faces"].values() if f["error"]]
+def accuracy(r, i, tol):
+    e=r["errors"][i]
+    if errors(r): return "演算エラー"
+    return f"{e:+.6f} {'○' if abs(e)<=tol else '×'}"
+lines.append("# 日差しの試作の計測値")
+dev=load("dev.jsonl")
+groups=defaultdict(list)
+for r in dev: groups[(r["method"],r["pitch"])].append(r)
+section("解析解との差（m²）",["方式","mm","床","壁","勾配天井","勾配例の北壁","水平天井最大 m²","届かない面最大 m²","B/G 不一致点"])
+for (m,p),records in groups.items():
+    floor,wall,slope=[next(r for r in records if r["case"]==c) for c in ("floor","wall","slope")]
+    ceiling=max(r["areas"][2] for r in records if r["case"] in ("floor","wall"))
+    dark=max(floor["areas"][1:]+[wall["areas"][0],slope["areas"][0]])
+    row(m,p,accuracy(floor,0,.020463),accuracy(wall,1,.012326),accuracy(slope,2,.010867),accuracy(slope,1,.00671832),f"{ceiling:.8g}",f"{dark:.8g}",sum(r["different_points"] for r in records) if m=="B" else "—")
+section("細い日差し。床面積の誤差（m²）、許容差20%",["方式","mm","0°","7.125°","10°","12.680°","隙間50","隙間20"])
+for (m,p),records in groups.items():
+    row(m,p,*[accuracy(r,0,r["expected"][0]*.2)+(" 消失" if r["areas"][0]==0 and not errors(r) else "") for r in records if r["case"] in ("slit","gap20","gap50")])
+section("家一軒。Linux amd64 release、5回の中央値（最小–最大）",["方式","mm","条件","前処理 ms","計算 ms","VmHWM KiB","R1 B","R2 B","R3 B","光線","失敗面数"])
+for m in ["G","A","Q","E-convex","E-kernel","B"]:
+    if not (raw/(m+".log")).exists() or not re.search(r"VmHWM:\s*(\d+)",(raw/(m+".log")).read_text()):
+        row(m,"—","未計測",*(["—"]*7),"—"); continue
+    rs=load(m+".jsonl"); mem=re.search(r"VmHWM:\s*(\d+)",(raw/(m+".log")).read_text()).group(1)
+    bykey=defaultdict(list)
+    for r in rs: bykey[(r["pitch"],r["sun"])].append(r)
+    for (p,s),runs in bykey.items():
+        assert len(runs)==5, (m,p,s,len(runs))
+        r=runs[0]
+        row(m,p,s,interval([i["prep_ms"]+(i["brep_prep_ms"] if m=="B" else 0) for i in runs]),interval([i["ms"] for i in runs]),mem,r["r1"],r["r2"],r["r3"],r["rays"],len(errors(r)))
+lines.extend(["","R1 は凸片または境界輪の頂点座標と受光面ID。R2 は受光面ID・原点・間隔に20 B、非空行の番号とrun数に8 B、runの開始と長さに8 B。Q のセルは最小格子へ展開してrunを結合した。R3 は面内の最長三角形辺が間隔以下になるよう全三角形を同じ分割数で等分し、面内で共有する頂点を一度数えた場合。各頂点13 B。","",
+"Q の最小間隔は200 mmを二分するため、指定25・10・5 mmに対して実際は25・6.25・3.125 mm。A は各開口の8隅の投影を含む矩形の和を使う。R1・R2は光のない面を省略。VmHWM は場面作成と全条件を含む方式別プロセスの最高値。前処理はSessionからの表示メッシュ取得・結合・受光面整理・BVH作成、Bは追加でB-repの取得と平面・輪の準備を含む。","",
+"macOS は精度の照合のみ。Linux の amd64 バイナリは arm64 Docker 上で実行。時刻別の方向、面別の異常、点の不一致の例は JSON Lines に記録した。"])
+(raw/"summary.md").write_text("\n".join(lines)+"\n")
diff --git a/crates/modeling/src/model/sun_probe/exact.rs b/crates/modeling/src/model/sun_probe/exact.rs
new file mode 100644
index 000000000..27258b910
--- /dev/null
+++ b/crates/modeling/src/model/sun_probe/exact.rs
@@ -0,0 +1,134 @@
+use super::*;
+fn clip<T: Copy>(poly: &[T], distance: impl Fn(T) -> f64, lerp: impl Fn(T, T, f64) -> T) -> Vec<T> {
+    let mut out = vec![];
+    for i in 0..poly.len() {
+        let a = poly[i];
+        let b = poly[(i + 1) % poly.len()];
+        let (da, db) = (distance(a), distance(b));
+        if da >= 0. {
+            out.push(a)
+        }
+        if (da > 0. && db < 0.) || (da < 0. && db > 0.) {
+            out.push(lerp(a, b, da / (da - db)));
+        }
+    }
+    out
+}
+fn area(p: &[P]) -> f64 {
+    (1..p.len().saturating_sub(1))
+        .map(|i| cross(p[0], p[i], p[i + 1]) / 2.)
+        .sum()
+}
+fn overlap(a: Bounds, b: Bounds) -> bool {
+    (0..2).all(|i| a[0][i] < b[1][i] && b[0][i] < a[1][i])
+}
+fn subtract(p: Poly, shadow: &Poly, out: &mut Vec<Poly>) {
+    if !overlap(bounds(p.iter()), bounds(shadow.iter())) {
+        out.push(p);
+        return;
+    }
+    let mut inside = p;
+    for i in 0..shadow.len() {
+        let a = shadow[i];
+        let b = shadow[(i + 1) % shadow.len()];
+        let d = |v| cross(a, b, v);
+        let interp = |a: P, b: P, t: f64| [a[0] + (b[0] - a[0]) * t, a[1] + (b[1] - a[1]) * t];
+        let outside = clip(&inside, |v| -d(v), interp);
+        if area(&outside) > 1e-8 {
+            out.push(outside)
+        }
+        inside = clip(&inside, d, interp);
+        if area(&inside) < 1e-8 {
+            break;
+        }
+    }
+}
+fn region(p: &Poly) -> Value {
+    let pts = |i: usize| json!(p[i]);
+    json!({"outer":{"segs":(0..p.len()).map(|i|json!({"type":"line","a":pts(i),"b":pts((i+1)%p.len())})).collect::<Vec<_>>()},"holes":[]})
+}
+pub(super) fn run(d: &Data, f: &Face, s: V, kernel_mode: bool) -> ResultRow {
+    let mut pieces: Vec<Poly> = f.tris.iter().map(|t| t.to_vec()).collect();
+    let mut shadows = vec![];
+    for tri in &d.mesh.triangles {
+        let tri = tri.map(|i| {
+            let p = d.mesh.positions[i as usize];
+            V(p.x, p.y, p.z)
+        });
+        let front = clip(
+            &tri,
+            |v| v.sub(f.o).dot(f.n) - 1e-7,
+            |a, b, t| a.add(b.sub(a).mul(t)),
+        );
+        let mut p: Poly = front.iter().map(|q| f.project(*q, s)).collect();
+        let a = area(&p);
+        if a.abs() < 1e-8 || !overlap(f.b, bounds(p.iter())) {
+            continue;
+        }
+        if a < 0. {
+            p.reverse()
+        }
+        shadows.push(p);
+    }
+    let mut row = ResultRow::default();
+    if kernel_mode {
+        for p in pieces {
+            let mut rs = vec![serde_json::from_value(region(&p)).unwrap()];
+            for sh in &shadows {
+                if rs.is_empty() {
+                    break;
+                }
+                let b = serde_json::from_value(region(sh)).unwrap();
+                match kernel::planar_regions_boolean(&rs, &[b], kernel::BoolOp::Cut, 1e-7) {
+                    Ok(v) => rs = v,
+                    Err(e) => {
+                        if std::env::var_os("SUN_DIAG").is_some() {
+                            println!("failed cut {} {} {e}", json!(rs), region(sh));
+                        }
+                        row.error = Some(e.to_string());
+                        return row;
+                    }
+                }
+            }
+            for r in rs {
+                row.area += r.area();
+                row.r1 += r.loops().map(|l| l.segs.len() as u64 * 8).sum::<u64>();
+            }
+        }
+    } else {
+        for sh in shadows {
+            let mut next = vec![];
+            for p in pieces {
+                subtract(p, &sh, &mut next)
+            }
+            pieces = next;
+            if pieces.is_empty() {
+                break;
+            }
+        }
+        for p in pieces {
+            row.area += area(&p);
+            row.r1 += 8 * p.len() as u64;
+        }
+    }
+    if row.r1 > 0 {
+        row.r1 += 8
+    }
+    row
+}
+
+pub(super) fn kernel_sample() {
+    let a = vec![[0., 0.], [10., 0.], [0., 10.]];
+    for b in [
+        vec![[1., 1.], [2., 1.], [1., 2.]],
+        a.clone(),
+        vec![[4., -1.], [8., -1.], [4., 5.]],
+    ] {
+        let reg = |p| serde_json::from_value(region(p)).unwrap();
+        println!(
+            "cut {a:?} {b:?} {:?}",
+            kernel::planar_regions_boolean(&[reg(&a)], &[reg(&b)], kernel::BoolOp::Cut, 1e-7)
+                .map(|r| r.len())
+        );
+    }
+}
diff --git a/crates/modeling/src/model/sun_probe/grid.rs b/crates/modeling/src/model/sun_probe/grid.rs
new file mode 100644
index 000000000..f56806ee4
--- /dev/null
+++ b/crates/modeling/src/model/sun_probe/grid.rs
@@ -0,0 +1,146 @@
+use super::*;
+struct Grid<'a> {
+    d: &'a Data,
+    f: &'a Face,
+    s: V,
+    method: &'a str,
+    step: f64,
+    compare: bool,
+    r: ResultRow,
+    runs: BTreeMap<i32, Vec<(i32, i32)>>,
+}
+impl Grid<'_> {
+    fn lit(&mut self, p: P) -> bool {
+        if !self.f.inside(p) {
+            return false;
+        }
+        self.r.rays += 1;
+        let q = self.f.xyz(p).add(self.f.n.mul(0.5));
+        if self.method == "B" {
+            let lit = !self.d.faces.iter().any(|face| face.hit(q, self.s));
+            if self.compare && self.d.mesh_lit(q, self.s) != lit {
+                self.r.diff += 1;
+                if self.r.examples.len() < 4 {
+                    self.r
+                        .examples
+                        .push(json!({"point":q.arr(),"brep_lit":lit}));
+                }
+            }
+            lit
+        } else {
+            self.d.mesh_lit(q, self.s)
+        }
+    }
+    fn cell(&mut self, x: i32, y: i32, k: i32) {
+        let (origin, step) = (self.f.b[0], self.step);
+        let p = |i: f64, j: f64| {
+            [
+                origin[0] + (f64::from(x) + i) * step,
+                origin[1] + (f64::from(y) + j) * step,
+            ]
+        };
+        let size = f64::from(k);
+        let center = self.lit(p(size / 2., size / 2.));
+        if k > 1
+            && [(0., 0.), (0., size), (size, 0.), (size, size)]
+                .iter()
+                .any(|&(i, j)| self.lit(p(i, j)) != center)
+        {
+            let h = k / 2;
+            for i in [0, h] {
+                for j in [0, h] {
+                    self.cell(x + i, y + j, h)
+                }
+            }
+        } else if center {
+            self.r.area += (size * self.step).powi(2);
+            for j in y..y + k {
+                let row = self.runs.entry(j).or_default();
+                if let Some(last) = row.last_mut()
+                    && last.1 == x
+                {
+                    last.1 = x + k
+                } else {
+                    row.push((x, x + k))
+                }
+            }
+        }
+    }
+}
+pub(super) fn run(d: &Data, f: &Face, s: V, method: &str, pitch: f64, compare: bool) -> ResultRow {
+    let k = if method == "Q" {
+        (200. / pitch).log2().ceil().exp2() as i32
+    } else {
+        1
+    };
+    let step = if method == "Q" {
+        200. / f64::from(k)
+    } else {
+        pitch
+    };
+    let mut g = Grid {
+        d,
+        f,
+        s,
+        step,
+        method,
+        compare,
+        r: Default::default(),
+        runs: Default::default(),
+    };
+    let count = |i: usize| ((f.b[1][i] - f.b[0][i]) / step).ceil() as i32;
+    let mut boxes = vec![f.b];
+    if method == "A" {
+        boxes = d
+            .openings
+            .iter()
+            .map(|op| {
+                bounds(
+                    op.iter()
+                        .map(|q| f.project(*q, s))
+                        .collect::<Vec<_>>()
+                        .iter(),
+                )
+            })
+            .filter(|b| (0..2).all(|i| b[1][i] >= f.b[0][i] && b[0][i] <= f.b[1][i]))
+            .collect();
+    }
+    let idx = |v: f64, i: usize| ((v - f.b[0][i]) / step - 0.5).ceil() as i32;
+    for y in (0..count(1)).step_by(k as usize) {
+        let mut ranges = vec![];
+        for b in &boxes {
+            if method != "A" {
+                ranges.push((0, count(0)));
+                break;
+            }
+            let cy = f.b[0][1] + (f64::from(y) + 0.5) * step;
+            if cy >= b[0][1] && cy <= b[1][1] {
+                ranges.push((idx(b[0][0], 0).max(0), idx(b[1][0] + 1e-8, 0).min(count(0))))
+            }
+        }
+        ranges.sort();
+        let mut end = 0;
+        for (lo, hi) in ranges {
+            for x in (lo.max(end)..hi).step_by(k as usize) {
+                g.cell(x, y, k)
+            }
+            end = end.max(hi);
+        }
+    }
+    if !g.runs.is_empty() {
+        g.r.r2 = 20;
+        for (_, mut runs) in g.runs {
+            runs.sort();
+            let mut last = -1;
+            g.r.r2 += 8;
+            for (a, b) in runs {
+                if a > last {
+                    g.r.r2 += 8
+                }
+                last = last.max(b);
+            }
+        }
+    }
+
+    g.r
+}
