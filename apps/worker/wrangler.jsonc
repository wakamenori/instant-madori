{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "instant-madori",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-08",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  // Local runs only. The deployed databases and the per-environment settings
  // (ENVIRONMENT, APP_ORIGINS, ACCESS_*) are added with the environment split in plan 6.1b.
  // Local settings come from the generated .dev.vars (scripts/local-access.ts).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "instant-madori-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
}
