{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "instant-madori",
  "triggers": { "crons": ["*/5 * * * *"] },
  "main": "src/index.ts",
  "compatibility_date": "2026-11-08",
  "workers_dev": false,
  "preview_urls": false,
  // Workers Logs also collects container stdout; staging measurements read it (plan 6.1b).
  "observability": { "enabled": true },
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  // Staging repeats bindings; exports is inheritable but repeated for explicit symmetry.
  // scripts/check/check-layout.ts checks names against the local configuration.
  // Local settings come from the generated .dev.vars (scripts/dev/local-access.ts).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "instant-madori-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],

  "r2_buckets": [{ "binding": "BLOBS", "bucket_name": "instant-madori-local" }],

  "containers": [
    {
      "class_name": "GeometryContainer",
      "scheduling_policy": "durable_object",
      "images": {
        "geometry": {
          "dockerfile": "../geometry/Dockerfile",
          "build_context": "../..",
        },
      },
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "GEOMETRY",
        "class_name": "GeometryContainer",
      },
      { "name": "PATTERNS", "class_name": "PatternCoordinator" },
    ],
  },
  "exports": {
    "GeometryContainer": {
      "type": "durable-object",
      "storage": "sqlite",
    },
    "PatternCoordinator": { "type": "durable-object", "storage": "sqlite" },
    // Workflow names are unique per account, so each environment names its own.
    "JobWorkflow": { "type": "workflow", "name": "instant-madori-job" },
  },
  // Type generation reads secret names from here, not from the generated .dev.vars.
  // Staging must not set ACCESS_JWKS, so it declares no secrets.
  "secrets": { "required": ["ACCESS_JWKS"] },
  "vars": {
    "ENVIRONMENT": "local",
    "JOB_TEST_HOLD": "none",
    // Placeholder: pnpm dev writes this run's screen origins to .dev.vars.
    "APP_ORIGINS": "http://app.local.invalid",
    "ACCESS_TEAM_DOMAIN": "https://team.example.invalid",
    "ACCESS_AUD": "replace-me",
    "GEOMETRY_INSTANCE_TYPE": "standard-1",
    "GEOMETRY_IDLE_TIMEOUT_MS": "600000",
  },
  "env": {
    "staging": {
      "name": "instant-madori-staging",
      // Reached at its workers.dev host; an Access app with a Worker destination guards it.
      // Keep it false until that app exists (README, staging steps): static assets skip the Worker.
      "workers_dev": true,
      "preview_urls": false,
      "vars": {
        "GEOMETRY_INSTANCE_TYPE": "standard-1",
        "GEOMETRY_IDLE_TIMEOUT_MS": "600000",
        "ENVIRONMENT": "staging",
        "JOB_TEST_HOLD": "before_render:180",
        "APP_ORIGINS": "https://instant-madori-staging.firpmnfiywl.workers.dev",
        "ACCESS_TEAM_DOMAIN": "https://wild-water-1feb.cloudflareaccess.com",
        "ACCESS_AUD": "0b18b47f9a9305690d90a632359c0066a9aba1717eaf7572cb07d14679fdaab3",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "instant-madori-staging",
          "database_id": "633c1cdb-35f7-4bac-8779-513a8a297bfc",
          "migrations_dir": "migrations",
        },
      ],
      "r2_buckets": [{ "binding": "BLOBS", "bucket_name": "instant-madori-staging" }],
      "containers": [
        {
          "class_name": "GeometryContainer",
          "scheduling_policy": "durable_object",
          "images": {
            "geometry": {
              "dockerfile": "../geometry/Dockerfile",
              "build_context": "../..",
            },
          },
        },
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "GEOMETRY",
            "class_name": "GeometryContainer",
          },
          { "name": "PATTERNS", "class_name": "PatternCoordinator" },
        ],
      },
      "exports": {
        "GeometryContainer": {
          "type": "durable-object",
          "storage": "sqlite",
        },
        "PatternCoordinator": { "type": "durable-object", "storage": "sqlite" },
        "JobWorkflow": { "type": "workflow", "name": "instant-madori-staging-job" },
      },
    },
  },
}
