{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreBinaries": ["mise"],
  "workspaces": {
    ".": {
      "entry": [
        "scripts/check/check-doc-paths.ts",
        "scripts/check/check-layout.ts",
        "scripts/check/check-migrations.ts",
        "scripts/check/ci-mode.ts",
        "scripts/check/check-licenses.ts",
        "scripts/check/check-secrets.ts",
        "scripts/check/check-sql.ts",
        "scripts/check/test-results.ts",
        "scripts/check/smoke.ts",
        "scripts/check/staging-smoke.ts",
        "scripts/check/r2-create-only/worker.ts",
        "scripts/deploy/registry-retention.ts",
        "metrics/hook/hook.ts",
        "metrics/receiver/receiver.ts",
        "metrics/build/build.ts",
        "metrics/viewer/build.ts"
      ],
      "project": ["scripts/**/*.ts", "metrics/**/*.ts", "*.mjs"]
    },
    "apps/web": {
      "project": ["src/**/*.{ts,tsx}"]
    },
    "apps/worker": {
      "entry": ["tests/**/*.test.ts", "tests/**/*.e2e.ts"],
      "project": ["src/**/*.ts", "tests/**/*.ts"],
      "ignoreDependencies": ["cloudflare"]
    },
    "packages/contracts": {
      "project": ["src/**/*.ts"]
    }
  }
}
